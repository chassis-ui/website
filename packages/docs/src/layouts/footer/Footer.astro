---
/**
 * Footer
 *
 * Site footer with logo, license information, and navigation links.
 */

import { getStaticPath } from '../../site'
---

<footer class="cxd-footer py-6xl">
  <div class="container 2xl fg-subtle">
    <div class="grid row-gap-0">
      <div class="col-span-full md:col-span-10 lg:col-span-5 mb-md">
        <a
          class="d-inline-flex align-items-center mb-xs text-body-emphasis text-decoration-none"
          href="/"
          aria-label="Chassis"
        >
          <img src={getStaticPath('images/site-logo.svg')} alt="Chassis UI" height="32" />
        </a>
        <p class="mb-xs">
          This project is licensed under the MIT License, which allows for free use, modification,
          and distribution of the software.
        </p>
        <p>
          <a href="/privacy/" class="fg-main">Privacy</a>
          <button hidden data-consent-open type="button" class="cxd-footer-link fg-main ms-md"
            >Cookie settings</button
          >
        </p>
      </div>
      <div class="col-span-full sm:col-span-4 lg:col-span-2 lg:col-start-7 mb-md">
        <p class="h6 mb-xs">Docs</p>
        <ul class="nav">
          <li><a href="/tokens">Design Tokens</a></li>
          <li><a href="/figma">Figma Library</a></li>
          <li><a href="/css">CSS Framework</a></li>
          <li><a href="/react">React Components</a></li>
          <li><a href="/assets">Asset Distributor</a></li>
          <li><a href="/icons">Icon Generator</a></li>
        </ul>
      </div>
      <div class="col-span-full sm:col-span-4 lg:col-span-2 mb-md">
        <p class="h6 mb-xs">Github</p>
        <ul class="nav">
          <li><a href="https://github.com/chassis-ui/tokens">Chassis Tokens</a></li>
          <li><a href="https://github.com/chassis-ui/figma">Chassis Figma</a></li>
          <li><a href="https://github.com/chassis-ui/css">Chassis CSS</a></li>
          <li><a href="https://github.com/chassis-ui/react">Chassis React</a></li>
          <li><a href="https://github.com/chassis-ui/assets">Chassis Assets</a></li>
          <li><a href="https://github.com/chassis-ui/icons">Chassis Icons</a></li>
        </ul>
      </div>
      <div class="col-span-full sm:col-span-4 lg:col-span-2 mb-md">
        <p class="h6 mb-xs">Project</p>
        <ul class="nav">
          <li><a href="/about">About</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/examples">Examples</a></li>
          <li><a href="https://github.com/chassis-ui">Contribute</a></li>
          <li><a href="https://x.com/chassis_ui">@chassis_ui on X</a></li>
        </ul>
      </div>
    </div>
  </div>
</footer>
