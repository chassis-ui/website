---
/**
 * Scripts
 *
 * JavaScript imports for site functionality.
 */

import type { Layout } from '../../libs/layout'
import type { HTMLAttributes } from 'astro/types'

interface Props {
  /** Current layout context */
  layout: Layout
}

const { layout } = Astro.props

function getChassisJsProps() {
  // __CHASSIS_JS_SRC__ is an optional dev-mode override injected via vite.define by the
  // host project's integration. When set, it replaces the default public-dir bundle path.
  const src =
    (import.meta.env.DEV && (globalThis as any).__CHASSIS_JS_SRC__) ||
    (import.meta.env.PROD ? '/static/js/chassis.bundle.min.js' : '/static/js/chassis.bundle.js')

  const cxJsLinkProps: HTMLAttributes<'script'> = { type: 'module', src }

  return cxJsLinkProps
}
---

<script src="../../js/search.js"></script>
<script is:inline {...getChassisJsProps()}></script>
{layout === 'docs' && <script src="../../js/sidebar.js" />}
<slot name="scripts" />
