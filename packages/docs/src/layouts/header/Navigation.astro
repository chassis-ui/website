---
/**
 * Navigation
 *
 * Main site navigation bar with menu items and theme toggler.
 */

import { getConfig } from '@libs/config'
import type { Layout } from '../../libs/layout'
import NavLink from '../../components/NavLink.astro'
import ThemeToggler from '../../components/ThemeToggler.astro'
import SearchTrigger from './SearchTrigger.astro'
import SearchDialog from './SearchDialog.astro'
import Icon from '../../components/shortcodes/Icon.astro'

interface Props {
  /** Current layout context */
  layout: Layout
}

const { layout } = Astro.props
const { pathname } = Astro.url
const isActive = (path: string) => {
  if (path === '/') {
    return pathname === '/' || pathname === ''
  }
  // Remove trailing slashes for a cleaner comparison
  const cleanPathname = pathname.endsWith('/') ? pathname.slice(0, -1) : pathname
  const cleanLinkPath = path.endsWith('/') ? path.slice(0, -1) : path

  return cleanPathname.startsWith(cleanLinkPath)
}
---

<header class="navbar translucent large:navbar-expand cxd-navbar sticky-top">
  <nav class="container 2xlarge" aria-label="Site navigation">
    {
      layout === 'docs' && (
        <div class="cxd-navbar-toggle">
          <button
            class="button icon-only navbar-toggler"
            type="button"
            data-cx-toggle="drawer"
            data-cx-target="#cxdSidebar"
            aria-controls="cxdSidebar"
            aria-label="Toggle docs navigation"
          >
            <Icon name="bars-solid" class="icon-large" />
            <span class="d-none large:d-inline fs-6 pe-2xsmall">Browse</span>
          </button>
        </div>
      )
    }
    {layout !== 'docs' && <div class="large:d-none" style="width: 4.25rem;" />}

    <a class="navbar-brand m-0 py-small large:me-medium" href="/" aria-label="Chassis">
      <img src="/static/images/site-logo.svg" alt="Chassis UI" width="123" height="32" />
    </a>

    <div class="d-flex">
      <div class="cxd-search"><SearchTrigger placeholder="Search docs…" /></div>

      <button
        class="button icon-only navbar-toggler"
        type="button"
        data-cx-toggle="drawer"
        data-cx-target="#cxdNavbar"
        aria-controls="cxdNavbar"
        aria-label="Toggle navigation"
      >
        <Icon name="ellipsis-h-solid" />
      </button>
    </div>

    <dialog
      class="max-large:drawer drawer-end flex-grow-1"
      id="cxdNavbar"
      aria-labelledby="cxdNavbarOffcanvasLabel"
    >
      <div class="drawer-header">
        <h2 class="drawer-title" id="cxdNavbarOffcanvasLabel">Chassis</h2>
        <button
          type="button"
          class="close-button close-button-white"
          data-cx-dismiss="drawer"
          aria-label="Close"
          data-cx-target="#cxdNavbar"></button>
      </div>

      <hr class="large:d-none m-0" />
      <div class="drawer-body large:p-0">
        <ul class="navbar-nav flex-row flex-wrap cxd-navbar-nav mx-0 large:mx-medium">
          <NavLink active={isActive('/tokens')} href="/tokens">Tokens</NavLink>
          <NavLink active={isActive('/figma')} href="/figma">Figma</NavLink>
          <NavLink active={isActive('/css')} href="/css">CSS</NavLink>
          <NavLink active={isActive('/assets')} href="/assets">Assets</NavLink>
          <NavLink active={isActive('/icons')} href="/icons">Icons</NavLink>
          <li class="nav-item col-12 large:col-auto large:d-flex">
            <div class="vr d-none large:d-flex my-auto large:mx-small"></div>
            <hr class="large:d-none" />
          </li>
          <NavLink active={isActive('/blog')} href="/blog">Blog</NavLink>
          <NavLink active={isActive('/examples')} href="/examples">Examples</NavLink>
        </ul>

        <hr class="large:d-none m-0" />

        <ul class="navbar-nav flex-row flex-wrap large:ms-auto align-items-center">
          <NavLink
            class="px-0 large:px-small"
            href={`https://figma.com/@${getConfig().figma_handle}`}
            target="_blank"
            rel="noopener"
          >
            <Icon name="figma-brand" title="Figma" />
            <small class="large:d-none ms-xsmall">Figma Community</small>
          </NavLink>
          <NavLink
            class="px-0 large:px-small"
            href={`https://github.com/${getConfig().github_org}`}
            target="_blank"
            rel="noopener"
          >
            <Icon name="github-brand" title="GitHub" />
            <small class="large:d-none ms-xsmall">GitHub</small>
          </NavLink>
          <li class="nav-item col-12 large:col-auto">
            <div class="vr d-none large:d-flex h-100 large:mx-2xsmall"></div>
            <hr class="large:d-none" />
          </li>

          <li class="nav-item">
            <ThemeToggler layout={layout} />
          </li>
        </ul>
      </div>
    </dialog>
  </nav>
</header>
<SearchDialog placeholder="Search docs…" />
