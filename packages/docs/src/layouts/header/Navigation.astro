---
/**
 * Navigation
 *
 * The site navbar: a full-width bar with a bottom border and a `container 2xl` inside. From `lg`
 * it shows the links, the search field, the Figma and GitHub links and the theme menu inline.
 * Below `lg` it shows the logo, a search button and a menu button that opens the navigation
 * drawer. On a docs page it also shows, before the search button, a link with a caret that
 * opens the docs navigation: it is named after the package of the page (`Tokens`), or `Docs`
 * where the page is under no package. Every link is a path of chassis-ui.com, so the bar is
 * the same on every Chassis site.
 * The Packages menu is named after the package of the page (`Tokens`) on a page of a package.
 * There the Docs link leads to the docs of that package, and on a page of those docs it has
 * the indicator and the menu has none.
 * It opens 8px above the bottom of the bar (`data-cx-offset`), where a menu opens 2px below it
 * by default.
 *
 * With `context` the bar starts on that context, `alternate` for a page with a dark hero. The
 * script below puts its menus on the context too (`menu context`), and returns the bar to the default context
 * when the band of the page, the first `.context.<name>` element of `<main>`, has gone under
 * it, and gives the context back when the band returns. Without the script the bar keeps the
 * context.
 */

import type { Layout } from '../../libs/layout'
import { getConfig } from '../../site'
import SiteLogo from '../SiteLogo.astro'
import NavLink from '../../components/NavLink.astro'
import ThemeToggler from '../../components/ThemeToggler.astro'
import SearchTrigger from './SearchTrigger.astro'
import SearchDialog from './SearchDialog.astro'
import Icon from '../../components/shortcodes/Icon.astro'

interface Props {
  /** Current layout context */
  layout: Layout
  /** The context of the bar while the first band of the page is under it, as `alternate` */
  context?: string
}

const { layout, context } = Astro.props
const { figmaHandle, githubOrg } = getConfig()
const { pathname } = Astro.url

const isActive = (path: string) => {
  if (path === '/') {
    return pathname === '/' || pathname === ''
  }
  // Remove trailing slashes for a cleaner comparison
  const cleanPathname = pathname.endsWith('/') ? pathname.slice(0, -1) : pathname
  const cleanLinkPath = path.endsWith('/') ? path.slice(0, -1) : path

  return cleanPathname === cleanLinkPath || cleanPathname.startsWith(`${cleanLinkPath}/`)
}

const packages = [
  { href: '/tokens', label: 'Tokens' },
  { href: '/figma', label: 'Figma' },
  { href: '/css', label: 'CSS' },
  { href: '/react', label: 'React' },
  { href: '/assets', label: 'Assets' },
  { href: '/icons', label: 'Icons' }
]
const activePackage = packages.find((item) => isActive(item.href))
// On a page of a package, Docs is the docs of that package.
const pages = [
  { href: activePackage ? `${activePackage.href}/docs` : '/docs', label: 'Docs' },
  { href: '/examples', label: 'Examples' },
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About' }
]
// On a docs page of a package the Docs link is the active one, not the Packages menu.
const packageActive = Boolean(activePackage) && !isActive(pages[0].href)
// What the link to the docs navigation is called below `lg`.
const docsLabel = activePackage?.label ?? 'Docs'
const figmaUrl = figmaHandle ? `https://figma.com/@${figmaHandle}` : undefined
const githubUrl = githubOrg ? `https://github.com/${githubOrg}` : undefined
---

<header
  class:list={['navbar cxd-navbar sticky-top', context && ['context', context]]}
  data-cxd-navbar-context={context}
>
  <nav class="container 2xl" aria-label="Site navigation">
    <a class="navbar-brand cxd-site-logo" href="/" aria-label="Chassis">
      <SiteLogo />
    </a>

    <ul class="navbar-nav cxd-navbar-nav d-none lg:d-flex flex-row me-auto">
      <li class="nav-item">
        <button
          class:list={['nav-link caret', { active: packageActive }]}
          type="button"
          aria-expanded="false"
          data-cx-toggle="menu"
          data-cx-placement="bottom-start"
          data-cx-offset="0,-8"
        >
          {activePackage?.label ?? 'Packages'}
        </button>
        <ul class="menu" aria-label="Packages">
          {packages.map((item) => (
            <li>
              <a
                class:list={['menu-item', { active: isActive(item.href) }]}
                aria-current={isActive(item.href) ? 'page' : undefined}
                href={item.href}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </li>
      {pages.map((item) => (
        <NavLink active={isActive(item.href)} href={item.href}>
          {item.label}
        </NavLink>
      ))}
    </ul>

    {layout === 'docs' && (
      <ul class="navbar-nav d-flex flex-row lg:d-none ms-auto">
        <li class="nav-item">
          <button
            class="nav-link caret cxd-docs-toggler"
            type="button"
            data-cx-toggle="drawer"
            data-cx-target="#cxdSidebar"
            aria-controls="cxdSidebar"
            aria-label={activePackage ? `Browse the ${docsLabel} docs` : 'Browse the docs'}
          >
            {docsLabel}
          </button>
        </li>
      </ul>
    )}

    <div class:list={['cxd-search lg:ms-0', { 'ms-auto': layout !== 'docs' }]}>
      <SearchTrigger placeholder="Search docs…" />
    </div>

    <ul class="navbar-nav d-none lg:d-flex flex-row align-items-center">
      {figmaUrl && (
        <NavLink href={figmaUrl} target="_blank" rel="noopener">
          <Icon name="figma-brand" title="Figma Community" />
        </NavLink>
      )}
      {githubUrl && (
        <NavLink href={githubUrl} target="_blank" rel="noopener">
          <Icon name="github-brand" title="GitHub" />
        </NavLink>
      )}
      <li class="nav-item cxd-navbar-divider" aria-hidden="true"></li>
      <li class="nav-item">
        <ThemeToggler layout={layout} />
      </li>
    </ul>

    <button
      class="button icon-only navbar-toggler lg:d-none"
      type="button"
      data-cx-toggle="drawer"
      data-cx-target="#cxdNavbar"
      aria-controls="cxdNavbar"
      aria-label="Open navigation"
    >
      <Icon name="bars-solid" />
    </button>
  </nav>
</header>

<dialog class="drawer drawer-end cxd-nav-drawer" id="cxdNavbar" aria-labelledby="cxdNavbarTitle">
  <div class="drawer-header">
    <h2 class="drawer-title" id="cxdNavbarTitle">
      Chassis
    </h2>
    <button
      type="button"
      class="close-button"
      data-cx-dismiss="drawer"
      data-cx-target="#cxdNavbar"
      aria-label="Close"
    ></button>
  </div>
  <nav class="drawer-body" aria-label="Site menu">
    <p class="cxd-nav-drawer-label" id="cxdNavbarPackages">
      Packages
    </p>
    <ul class="nav cxd-nav-drawer-grid" aria-labelledby="cxdNavbarPackages">
      {packages.map((item) => (
        <NavLink active={isActive(item.href)} href={item.href}>
          {item.label}
        </NavLink>
      ))}
    </ul>
    <hr />
    <ul class="nav cxd-nav-drawer-grid">
      {pages.slice(0, 2).map((item) => (
        <NavLink active={isActive(item.href)} href={item.href}>
          {item.label}
        </NavLink>
      ))}
    </ul>
    <hr />
    <ul class="nav cxd-nav-drawer-grid">
      {pages.slice(2).map((item) => (
        <NavLink active={isActive(item.href)} href={item.href}>
          {item.label}
        </NavLink>
      ))}
    </ul>
    {(figmaUrl || githubUrl) && (
      <>
        <hr />
        <ul class="nav flex-column cxd-nav-drawer-list">
          {figmaUrl && (
            <NavLink href={figmaUrl} target="_blank" rel="noopener">
              <Icon name="figma-brand" />
              Figma Community
            </NavLink>
          )}
          {githubUrl && (
            <NavLink href={githubUrl} target="_blank" rel="noopener">
              <Icon name="github-brand" />
              GitHub Organization
            </NavLink>
          )}
        </ul>
      </>
    )}
    <hr />
    <ul class="nav flex-column cxd-nav-drawer-list">
      <li class="nav-item">
        <ThemeToggler label placement="bottom-start" />
      </li>
    </ul>
  </nav>
</dialog>
<SearchDialog placeholder="Search docs…" />

<script>
  // The context of the navbar follows the band of the page. The line the band is measured
  // against is the bottom of the navbar.
  const navbar = document.querySelector<HTMLElement>('.cxd-navbar[data-cxd-navbar-context]')
  const context = navbar?.dataset.cxdNavbarContext
  const band = context && document.querySelector<HTMLElement>(`main .context.${context}`)

  if (navbar && context && band && 'IntersectionObserver' in window) {
    let observer: IntersectionObserver | undefined
    let height = 0

    const watch = () => {
      if (navbar.offsetHeight === height) return
      height = navbar.offsetHeight
      observer?.disconnect()
      observer = new IntersectionObserver(
        ([entry]) => {
          navbar.classList.toggle('context', entry.isIntersecting)
          navbar.classList.toggle(context, entry.isIntersecting)
          // A menu with `context` takes the colors of the context of the bar.
          for (const menu of navbar.querySelectorAll('.menu')) {
            menu.classList.toggle('context', entry.isIntersecting)
          }
        },
        { rootMargin: `-${height}px 0px 0px 0px` }
      )
      observer.observe(band)
    }

    new ResizeObserver(watch).observe(navbar)
    watch()
  }
</script>
