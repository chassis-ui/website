---
/**
 * Header
 *
 * Site header with navigation and page title.
 */

import type { Layout } from '../../libs/layout'
import Skippy from './Skippy.astro'
import Navigation from './Navigation.astro'

interface Props {
  /** Current layout context */
  layout: Layout
  /** Page title */
  title: string
  /** The context of the navbar while the first band of the page is under it */
  navbarContext?: string
}

const { layout, navbarContext } = Astro.props
---

<Skippy layout={layout} />

<Navigation layout={layout} context={navbarContext} />
