---
/**
 * Docs Layout
 *
 * Layout for documentation pages with sidebar navigation and table of contents.
 */

import type { MarkdownHeading } from 'astro'
import type { LayoutOverridesHTMLAttributes } from '../libs/layout'
import type { DocsFrontmatter } from '../libs/schema'
import { getSlug, processMarkdownToHtml } from '../libs/utils'
import { getConfig, getDocsPages, getDocsPath, getSiteFileUrl } from '../site'
import BaseLayout from './BaseLayout.astro'
import DocsSidebar from '../components/DocsSidebar.astro'
import TableOfContents from '../components/TableOfContents.astro'
import Icon from '../components/shortcodes/Icon.astro'

interface Props {
  /** Frontmatter data from the docs collection */
  frontmatter: DocsFrontmatter
  /** Markdown headings for table of contents */
  headings?: MarkdownHeading[]
  /** Document ID from the docs collection */
  id: string
  /**
   * Path of the page's source file from the site's root. Looked up from the docs collection
   * by `id` when omitted.
   */
  filePath?: string
}

const { frontmatter, headings, id } = Astro.props

// "View on GitHub" links to the page's own source file. The old link, which assumed the
// file sat at `<id>.mdx` in the repository root, is kept only when no file path is known.
const filePath =
  Astro.props.filePath ?? (await getDocsPages()).find((page) => page.id === id)?.filePath
const githubUrl = filePath ? getSiteFileUrl(filePath) : `${getConfig().repo}/blob/${id}.mdx`

type DocSection = NonNullable<typeof frontmatter.sections>[number]

// Extract the directory/section from the ID (format: "directory/filename.mdx")
const parentDirectory = id.includes('/') ? id.split('/')[0] : ''

const bodyProps: LayoutOverridesHTMLAttributes<'body'> = {}

bodyProps['class'] = 'docs-body'

if (frontmatter.toc) {
  bodyProps['data-cx-spy'] = 'scroll'
  bodyProps['data-cx-target'] = '#TableOfContents'
}
---

<BaseLayout {...Astro.props} layout="docs" overrides={{ body: bodyProps }}>
  <div slot="main" class="container 2xl cxd-layout">
    <aside class="cxd-sidebar">
      <dialog
        class="max-lg:drawer drawer-start"
        id="cxdSidebar"
        aria-labelledby="cxdSidebarOffcanvasLabel"
      >
        <div class="drawer-header">
          <h2 class="drawer-title" id="cxdSidebarOffcanvasLabel">
            Browse docs
          </h2>
          <button
            type="button"
            class="close-button"
            data-cx-dismiss="drawer"
            aria-label="Close"
            data-cx-target="#cxdSidebar"
          ></button>
        </div>
        <hr class="lg:d-none m-0" />
        <div class="drawer-body lg:p-0">
          <slot name="sidebar">
            <DocsSidebar />
          </slot>
        </div>
      </dialog>
    </aside>

    <main class="cxd-main">
      <div class="cxd-intro">
        <slot name="intro">
          <div class="cxd-title-row">
            <h1 class="cxd-title" id="content">
              {frontmatter.title}
            </h1>
            {
              // The badge shows unless `showBadge` is false.
              frontmatter.added && frontmatter.added.showBadge !== false && (
                <div class="cxd-title-badge">
                  <span class="badge success smooth rounded-md">
                    Added in v{frontmatter.added.version}
                  </span>
                </div>
              )
            }
            {/* Below `md` the link is its icon alone. */}
            <a
              class="button default icon-only md:d-none"
              href={githubUrl}
              aria-label="View on GitHub"
              title="View and edit this file on GitHub"
              target="_blank"
              rel="noopener"
            >
              <Icon name="github-brand" />
            </a>
            <a
              class="button default d-none md:d-inline-flex text-nowrap"
              href={githubUrl}
              title="View and edit this file on GitHub"
              target="_blank"
              rel="noopener"
            >
              <Icon name="github-brand" />
              View on GitHub
            </a>
          </div>
          <div class="cxd-subtitle">
            {frontmatter.description && (
              <Fragment set:html={processMarkdownToHtml(frontmatter.description)} />
            )}
          </div>
        </slot>
      </div>

      {frontmatter.toc && headings && (
        <div class="cxd-toc">
          <button
            class="button default w-100 justify-content-between mb-lg lg:d-none"
            type="button"
            data-cx-toggle="collapse"
            data-cx-target="#tocContents"
            aria-expanded="false"
            aria-controls="tocContents"
          >
            On this page
            <Icon name="chevron-sort-solid" />
          </button>
          <strong class="d-none lg:d-block font-h6 my-xs">On this page</strong>
          <hr class="d-none lg:d-block my-xs" />
          <div class="collapse cxd-toc-collapse" id="tocContents">
            <nav id="TableOfContents" aria-label="Table of contents">
              <slot name="toc">
                <TableOfContents headings={headings} config={getConfig()} />
              </slot>
            </nav>
          </div>
        </div>
      )}

      <div class="cxd-content">
        {frontmatter.sections && (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-xl">
            {frontmatter.sections.map((section: DocSection) => (
              <div>
                <a
                  class="d-block text-decoration-none"
                  href={getDocsPath(
                    `${parentDirectory ? parentDirectory + '/' : ''}${section.slug ? section.slug : getSlug(section.title)}/`
                  )}
                >
                  <strong class="d-block font-h5 mb-2xs">{section.title}</strong>
                  <span class="fg-subtle">{section.description}</span>
                </a>
              </div>
            ))}
          </div>
        )}

        <slot />
      </div>
    </main>
  </div>
  <slot name="scripts" slot="scripts" />
</BaseLayout>
