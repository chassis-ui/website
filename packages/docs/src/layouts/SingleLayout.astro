---
/**
 * Single Layout
 *
 * Simple single-column layout for standalone pages.
 */

import BaseLayout from './BaseLayout.astro'
import type { LayoutOverridesHTMLAttributes } from '../libs/layout'

interface Props {
  /** Page title */
  title: string
  /** Page description */
  description: string
}

const { description, title } = Astro.props

const mainProps: LayoutOverridesHTMLAttributes<'main'> = {}
mainProps['class'] = 'min-vh-100'
---

<BaseLayout {...Astro.props} layout="single" overrides={{ main: mainProps }}>
  <header class="py-xlarge medium:py-3xlarge border-bottom border-subtle">
    <div class="container 2xlarge">
      <div class="row">
        <div class="col large:col-10 2xlarge:col-8">
          <h1 class="mt-0">{title}</h1>
          <p class="font-lead">{description}</p>
          <slot name="header-content" />
        </div>
      </div>
    </div>
  </header>

  <slot />
</BaseLayout>
