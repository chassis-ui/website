---
/**
 * Favicons
 *
 * Favicon and app icon link tags for various platforms.
 */

import { getStaticPath } from '../../site'
---

<link rel="apple-touch-icon" href={getStaticPath('images/apple-touch-icon.png')} sizes="180x180" />
<link rel="icon" href={getStaticPath('images/favicon-32x32.png')} sizes="32x32" type="image/png" />
<link rel="icon" href={getStaticPath('images/favicon-16x16.png')} sizes="16x16" type="image/png" />
<link rel="manifest" href={getStaticPath('images/manifest.json')} />
<link rel="icon" href={getStaticPath('images/favicon.png')} />
<meta name="theme-color" content="#00A4CC" />
