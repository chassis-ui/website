---
/**
 * Social
 *
 * Social media meta tags (Open Graph, Twitter Cards).
 */

import path from 'node:path'
import { getConfig } from '@libs/config'
import { getDocsPublicFsPath } from '@libs/path'
import { getStaticImageSize } from '../../libs/image'
import type { Layout } from '../../libs/layout'

interface Props {
  /** Page description */
  description: string
  /** Current layout context */
  layout: Layout
  /** Social media thumbnail image */
  thumbnail: string
  /** Page title */
  title: string
}

const { description, layout, thumbnail, title } = Astro.props

const socialImageUrl = new URL(thumbnail, Astro.site)
const socialImageSize = await getStaticImageSize(path.join(getDocsPublicFsPath(), thumbnail))
---

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content=`@${getConfig().x_username}` />
<meta name="twitter:creator" content=`@${getConfig().x_username}` />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImageUrl} />

<meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={layout === 'docs' ? 'article' : 'website'} />
<meta property="og:image" content={socialImageUrl} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content={String(socialImageSize.width)} />
<meta property="og:image:height" content={String(socialImageSize.height)} />
