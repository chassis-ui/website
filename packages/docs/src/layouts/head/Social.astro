---
/**
 * Social
 *
 * Social media meta tags (Open Graph, Twitter Cards).
 */

import { getRemoteImageSize, getStaticImageSize } from '../../libs/image'
import type { Layout } from '../../libs/layout'
import { getConfig, getPublicFsPath, getStaticPath } from '../../site'

interface Props {
  /** Page description */
  description: string
  /** Current layout context */
  layout: Layout
  /** Social media thumbnail image */
  thumbnail: string
  /** Page title */
  title: string
}

const { description, layout, thumbnail, title } = Astro.props

// A file in `static/` of the `public` directory is read from there, and linked under
// `staticPath` of the config.
const staticFile = thumbnail.match(/^\/?static\/(.+)$/)?.[1]
const socialImageUrl = new URL(staticFile ? getStaticPath(staticFile) : thumbnail, Astro.site)
const isRemoteThumbnail = /^https?:\/\//i.test(thumbnail)
const socialImageSize = isRemoteThumbnail
  ? await getRemoteImageSize(thumbnail)
  : await getStaticImageSize(getPublicFsPath(thumbnail))
const { xUsername } = getConfig()
---

<meta name="twitter:card" content="summary_lg_image" />
{xUsername && <meta name="twitter:site" content={`@${xUsername}`} />}
{xUsername && <meta name="twitter:creator" content={`@${xUsername}`} />}
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImageUrl} />

<meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={layout === 'docs' ? 'article' : 'website'} />
<meta property="og:site_name" content={getConfig().title} />
<meta property="og:image" content={socialImageUrl} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content={String(socialImageSize.width)} />
<meta property="og:image:height" content={String(socialImageSize.height)} />
