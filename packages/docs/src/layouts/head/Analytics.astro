---
/**
 * Analytics
 *
 * Google Analytics script tags. Rendered in production builds, when `analytics.googleId` is
 * set in `config.yml`.
 */

import { getConfig } from '../../site'

const isProd = import.meta.env.PROD
const { googleId } = getConfig().analytics
---

{
  isProd && googleId && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${googleId}`} />
      <script
        is:inline
        set:html={`
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', '${googleId}');
`}
      />
    </>
  )
}
