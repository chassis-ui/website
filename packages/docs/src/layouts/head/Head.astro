---
/**
 * Head
 *
 * HTML head section with meta tags, stylesheets, and SEO configuration.
 */

import { getConfig } from '../../site'
import { isHomePath } from '../../libs/docs-path'
import type { Layout } from '../../libs/layout'
import Stylesheet from './Stylesheet.astro'
import Favicons from './Favicons.astro'
import Social from './Social.astro'
import colorModes from '../../js/color-modes.js?raw'
import 'virtual:chassis-docs/styles'

interface Props {
  /** Page description for meta tags */
  description: string
  /** Current layout context */
  layout: Layout
  /** Robots meta tag value */
  robots: string | undefined
  /** Social media thumbnail image */
  thumbnail: string
  /** Page title */
  title: string
}

const { description, layout, robots, thumbnail, title } = Astro.props

const canonicalUrl = new URL(Astro.url.pathname, Astro.site)

// The home page of a site under a path, such as `/css/`, is not at `/`
const isHome = isHomePath(getConfig().baseURL, Astro.url.pathname)
const pageTitle = isHome
  ? `${getConfig().title} · ${getConfig().subtitle}`
  : `${title} · ${getConfig().title}`
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<!--
  A link, not an `@import` in the styles, so that the browser finds it with the page and
  not after the stylesheet that imports it
-->
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@300..700&family=Inter:wght@100..900&family=Archivo+Narrow:ital,wght@0,400..700;1,400..700&display=swap"
/>

<meta name="description" content={description} />

<meta name="author" content={getConfig().authors} />
<meta name="generator" content={Astro.generator} />

<link rel="canonical" href={canonicalUrl} />

<title>{pageTitle}</title>

{robots && <meta name="robots" content={robots} />}

<!--
  Inline and not a module, so that it sets the theme before the first paint. A module runs
  after the document is parsed, and a page in dark mode would show light first
-->
<script is:inline set:html={colorModes} />
<Stylesheet />
<slot name="styles" />
<Favicons />
<Social description={description} layout={layout} thumbnail={thumbnail} title={title} />
