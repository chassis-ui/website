---
/**
 * Head
 *
 * HTML head section with meta tags, stylesheets, and SEO configuration.
 */

import { getConfig } from '@libs/config'
import type { Layout } from '../../libs/layout'
import Stylesheet from './Stylesheet.astro'
import Favicons from './Favicons.astro'
import Social from './Social.astro'
import Analytics from './Analytics.astro'
import '@scss/docs.scss'

interface Props {
  /** Page description for meta tags */
  description: string
  /** Current layout context */
  layout: Layout
  /** Robots meta tag value */
  robots: string | undefined
  /** Social media thumbnail image */
  thumbnail: string
  /** Page title */
  title: string
}

const { description, layout, robots, thumbnail, title } = Astro.props

const canonicalUrl = new URL(Astro.url.pathname, Astro.site)

const isHome = Astro.url.pathname === '/'
const pageTitle = isHome
  ? `${getConfig().title} · ${getConfig().subtitle}`
  : `${title} · ${getConfig().title}`
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<meta name="description" content={description} />

<meta name="author" content={getConfig().authors} />
<meta name="generator" content={Astro.generator} />

<link rel="canonical" href={canonicalUrl} />

<title>{pageTitle}</title>

{robots && <meta name="robots" content={robots} />}

<script src="../../js/color-modes.js"></script>

<Stylesheet />
<slot name="styles" />
<Favicons />
<Social description={description} layout={layout} thumbnail={thumbnail} title={title} />
<Analytics />
