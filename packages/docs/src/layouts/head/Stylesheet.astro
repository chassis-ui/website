---
/**
 * Stylesheet
 *
 * Stylesheet link tags for external CSS resources.
 */

import type { HTMLAttributes } from 'astro/types'
import { getStaticPath } from '../../site'

function getChassisCssProps() {
  let cxCssLinkHref = getStaticPath('css/chassis')

  if (import.meta.env.PROD) {
    cxCssLinkHref = `${cxCssLinkHref}.min`
  }

  cxCssLinkHref = `${cxCssLinkHref}.css`

  const cxCssLinkProps: HTMLAttributes<'link'> = {
    href: cxCssLinkHref,
    rel: 'stylesheet'
  }

  return cxCssLinkProps
}
---

<link {...getChassisCssProps()} />
<link rel="stylesheet" href={getStaticPath('icons/chassis-icons.css')} />
