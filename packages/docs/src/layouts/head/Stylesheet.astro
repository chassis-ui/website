---
/**
 * Stylesheet
 *
 * Stylesheet link tags for external CSS resources.
 */

import type { HTMLAttributes } from 'astro/types'

function getChassisCssProps() {
  let cxCssLinkHref = '/static/css/chassis'

  if (import.meta.env.PROD) {
    cxCssLinkHref = `${cxCssLinkHref}.min`
  }

  cxCssLinkHref = `${cxCssLinkHref}.css`

  const cxCssLinkProps: HTMLAttributes<'link'> = {
    href: cxCssLinkHref,
    rel: 'stylesheet'
  }

  return cxCssLinkProps
}
---

<link {...getChassisCssProps()} />
<link rel="stylesheet" href={`/static/icons/chassis-icons.css`} />
