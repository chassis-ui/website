---
/**
 * Stylesheet
 *
 * Stylesheet link tags for external CSS resources.
 */

import type { HTMLAttributes } from 'astro/types'
import { getVersionedStaticPath } from '../../site'

function getChassisCssProps() {
  const cxCssLinkProps: HTMLAttributes<'link'> = {
    href: getVersionedStaticPath(import.meta.env.PROD ? 'css/chassis.min.css' : 'css/chassis.css'),
    rel: 'stylesheet'
  }

  return cxCssLinkProps
}
---

<link {...getChassisCssProps()} />
<link rel="stylesheet" href={getVersionedStaticPath('icons/chassis-icons.css')} />
