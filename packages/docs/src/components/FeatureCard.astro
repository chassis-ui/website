---
/**
 * Feature Card Component
 *
 * A reusable card component for displaying features with icon, title, body, and optional content.
 *
 * @slot title - Feature title (required)
 * @slot body - Feature description (required)
 * @slot default - Optional additional content (images, code blocks, etc.)
 */

import Icon from './shortcodes/Icon.astro'

interface Props {
  /** Icon ID from the SVG sprite (e.g., "cx-folder-tree") */
  icon?: string
  /** Additional CSS classes to apply to the card */
  classes?: string
  /** Whether to display the header in horizontal layout (icon + text side by side) */
  horizontal?: boolean
}

const { icon, classes, horizontal = false } = Astro.props

// Check if default slot has content without rendering it
const hasContent = Astro.slots.has('default')

// Build class strings
const cardClasses = [
  'feature-item bg-even d-flex flex-column rounded-lg',
  'p-md lg:p-xl gap-md md:gap-xl',
  horizontal ? '' : 'h-100',
  classes
]
  .filter(Boolean)
  .join(' ')

const headerClasses = [
  'feature-header d-flex',
  'gap-md md:gap-xl',
  horizontal ? 'flex-column md:flex-row' : 'flex-column'
].join(' ')
---

<div class={cardClasses}>
  <div class={headerClasses}>
    {
      icon && (
        <div class="feature-thumb">
          <Icon name={icon} class="feature-icon icon-3xl md:icon-4xl" sprite="" />
        </div>
      )
    }
    <div>
      <h3 class="feature-title font-lg md:font-xl mb-3xs md:mb-2xs">
        <slot name="title" />
      </h3>
      <p class="feature-body md:font-lg mb-0">
        <slot name="body" />
      </p>
    </div>
  </div>
  {hasContent && <slot />}
</div>
