---
/**
 * Table of Contents
 *
 * Generate and render a hierarchical table of contents from headings.
 * Can be called recursively to render nested children.
 */

import type { MarkdownHeading } from 'astro'
import { generateToc, type TocConfig, type TocEntry } from '../libs/toc'

interface Props {
  /** Markdown headings to generate TOC from. Required when `entries` is not provided. */
  headings?: MarkdownHeading[]
  /** Pre-generated TOC entries. When provided, `headings` is ignored. */
  entries?: TocEntry[]
  /** Current nesting level. Set automatically during recursive rendering. */
  level?: number
  /** TOC depth configuration. Required when `entries` is not provided. */
  config?: TocConfig
}

const { entries, headings, level, config } = Astro.props

const toc = entries ? entries : generateToc(headings ?? [], config!)
let entryLevel = level ? level + 1 : 1
---

<ul>
  {
    toc.map(({ children, slug, text }) => {
      return (
        <li>
          <a href={`#${slug}`} class={`level-${entryLevel}`}>
            {text}
          </a>
          {children.length > 0 && <Astro.self entries={children} level={entryLevel} />}
        </li>
      )
    })
  }
</ul>
