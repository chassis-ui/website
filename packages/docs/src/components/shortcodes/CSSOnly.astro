---
/**
 * CSS Only
 *
 * Badge indicating a feature is available in CSS but has no equivalent
 * Figma component. Renders with a tooltip that can be customized.
 */

interface Props {
  /** Tooltip text shown on hover. */
  tooltip?: string
}

const { tooltip = 'This feature is only available in CSS and not in Figma components.' } =
  Astro.props
---

<span
  class="badge large info smooth mb-medium rounded-medium"
  data-cx-toggle="tooltip"
  title={tooltip}>CSS Only</span
>
