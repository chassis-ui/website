---
/**
 * Callout
 *
 * Display informational callout boxes with different types (info, danger, warning).
 */

import { render } from 'astro:content'
import { getCallout } from '../../site'
import type { MarkdownInstance } from 'astro'

interface Props {
  /**
   * The name of an entry of the site's `callouts` collection to display.
   * This will override any content passed in via the default slot.
   */
  name?: string
  /**
   * The type of callout to display. One of `info`, `danger`, or `warning`.
   * @default 'info'
   */
  type?: 'danger' | 'info' | 'warning'
  /**
   * The CSS class(es) to be added to the callout wrapping `div` element.
   */
  class?: string
}

const { name, type = 'info', class: className } = Astro.props

let Content: MarkdownInstance<{}>['Content'] | undefined

if (name) {
  const callout = await getCallout(name)

  if (!callout) {
    throw new Error(`Could not find callout with name '${name}'.`)
  }

  const namedCallout = await render(callout)
  Content = namedCallout.Content
}
---

<div class:list={[`cxd-callout cxd-callout-${type} context ${type}`, className]}>
  {Content ? <Content /> : <slot />}
</div>
