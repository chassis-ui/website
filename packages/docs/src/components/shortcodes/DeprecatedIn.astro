---
/**
 * Deprecated In
 *
 * Badge indicating the version in which a feature was deprecated.
 */

interface Props {
  /** Version number when the feature was deprecated (e.g. `"2.1.0"`). */
  version: string
}

const { version } = Astro.props
---

<span class="badge large warning smooth mb-medium rounded-medium">
  Deprecated in v{version}
</span>
