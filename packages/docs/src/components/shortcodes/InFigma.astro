---
/**
 * In Figma
 *
 * Badge indicating a variant exists in the Figma component library with bound
 * design tokens. Renders with a tooltip that can be customized.
 */

interface Props {
  /** Custom tooltip text. Defaults to a generated message based on `plural`. */
  tooltip?: string
  /** When true, uses plural phrasing in the default tooltip text. */
  plural?: boolean
}

const { tooltip, plural } = Astro.props
const tooltipText =
  tooltip ??
  `This variant${plural ? 's' : ''} exist${plural ? '' : 's'} in the Figma component library with bound design tokens.`
---

<span
  class="badge lg primary smooth mb-md rounded-md"
  data-cx-toggle="tooltip"
  title={tooltipText}>In Figma</span
>
