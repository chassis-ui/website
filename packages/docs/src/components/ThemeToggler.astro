---
/**
 * Theme Toggler
 *
 * Button to toggle between light, dark, and auto themes.
 */

import type { Layout } from '../libs/layout'
import Icon from './shortcodes/Icon.astro'

interface Props {
  /** Current layout context */
  layout: Layout
}

const { layout } = Astro.props
---

<button
  class="nav-link gap-2xsmall px-0 large:px-small"
  id="cxd-theme"
  type="button"
  aria-expanded="false"
  data-cx-toggle="menu"
  aria-label="Toggle theme (auto)"
  data-cx-placement="bottom-end"
>
  <Icon name="circle-half-solid" class="theme-icon-active" />
  <span
    class=`${layout === 'examples' ? 'visually-hidden' : 'large:d-none ms-xsmall'}`
    id="cxd-theme-text">Toggle theme</span
  >
</button>
<ul class="menu" role="menu" aria-label="Theme options">
  <li>
    <button type="button" class="menu-item" data-cx-theme-value="light">
      <Icon name="sun-solid" class="menu-item-icon" />
      Light
      <Icon name="check-solid" class="menu-item-check" />
    </button>
  </li>
  <li>
    <button type="button" class="menu-item" data-cx-theme-value="dark">
      <Icon name="moon-stars-solid" class="menu-item-icon" />
      Dark
      <Icon name="check-solid" class="menu-item-check" />
    </button>
  </li>
  <li>
    <button type="button" class="menu-item" data-cx-theme-value="auto">
      <Icon name="circle-half-solid" class="menu-item-icon" />
      Auto
      <Icon name="check-solid" class="menu-item-check" />
    </button>
  </li>
</ul>
