---
/**
 * Docs Sidebar
 *
 * Navigation sidebar for documentation pages with hierarchical menu structure.
 */

import { getData, type SidebarItem, type SidebarSubItem } from '@libs/data'
import { getConfig } from '@libs/config'
import { docsPages } from '@libs/content'
import { getSlug } from '../libs/utils'
import Icon from './shortcodes/Icon.astro'

const sidebar = getData('sidebar')
---

<nav class="cxd-links w-100" id="cxd-docs-nav" aria-label="Docs navigation">
  <menu class="p-0 m-0">
    {
      sidebar.map((group) => {
        const groupSlug = getSlug(group.title)

        if (group.pages) {
          return (
            <li
              class:list={[
                'cxd-links-group',
                groupSlug === Astro.params.slug?.split('/')[0] ? 'active' : undefined
              ]}
            >
              <strong class="cxd-links-heading">
                {group.icon && (
                  <Icon
                    name={group.icon}
                    style={group.icon_color && `color: var(--cx-${group.icon_color});`}
                  />
                )}
                {group.title}
              </strong>
              <ul class="nav flex-column cxd-links-nav">
                {group.pages?.map((item: SidebarItem) => {
                  // Handle sub-groups
                  if (item.group && item.pages) {
                    return (
                      <>
                        <li class="cxd-links-subgroup">{item.group}</li>
                        {item.pages.map((page: SidebarSubItem) => {
                          const docSlug = getSlug(page.title)
                          const unversionedPageSlug = `${groupSlug}/${docSlug}`

                          const url = `${getConfig().docsPath}/${unversionedPageSlug}`
                          const active = Astro.params.slug === unversionedPageSlug

                          const generatedPage = docsPages.find(
                            (page) => page.id === unversionedPageSlug
                          )

                          // This test should not be necessary, see comments for `getSlug()` in `src/libs/utils.ts`.
                          if (!generatedPage) {
                            throw new Error(
                              `The page '${page.title}' referenced in 'site/data/sidebar.yml' does not exist at '${url}'.`
                            )
                          }

                          return (
                            <li>
                              <a
                                href={url}
                                class:list={['cxd-links-link', { active }]}
                                aria-current={active ? 'page' : undefined}
                              >
                                {page.title}
                              </a>
                            </li>
                          )
                        })}
                      </>
                    )
                  }

                  // Handle regular pages
                  if (!item.title) {
                    return null
                  }

                  const docSlug = getSlug(item.title)
                  const unversionedPageSlug = `${groupSlug}/${docSlug}`

                  const url = `${getConfig().docsPath}/${unversionedPageSlug}`
                  const active = Astro.params.slug === unversionedPageSlug

                  const generatedPage = docsPages.find((page) => page.id === unversionedPageSlug)

                  // This test should not be necessary, see comments for `getSlug()` in `src/libs/utils.ts`.
                  if (!generatedPage) {
                    throw new Error(
                      `The page '${item.title}' referenced in 'data/sidebar.yml' does not exist at '${url}'.`
                    )
                  }

                  return (
                    <li>
                      <a
                        href={url}
                        class:list={['cxd-links-link', { active }]}
                        aria-current={active ? 'page' : undefined}
                      >
                        {item.title}
                      </a>
                    </li>
                  )
                })}
              </ul>
            </li>
          )
        } else {
          const active = Astro.params.slug === groupSlug

          return (
            <>
              <li class="cxd-links-span-all mt-2xsmall mb-medium mx-large border-top" />
              <a
                href={`${getConfig().docsPath}/${groupSlug}/`}
                class:list={['cxd-links-link cxd-links-span-all', { active }]}
                aria-current={active ? 'page' : undefined}
              >
                {group.title}
              </a>
            </>
          )
        }
      })
    }
  </menu>
</nav>
