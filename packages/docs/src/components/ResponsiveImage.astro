---
/**
 * Responsive Image
 *
 * Render responsive images with 1x and 2x resolution variants. A file of the `public`
 * directory is linked with the version of its content, so the host can let the browser keep it.
 */

import { getVersionedPublicPath } from '../site'

interface Props {
  /** Path to the image file */
  imgPath: string
  /** Alternative text for the image */
  alt: string
  /** Additional CSS classes */
  classes?: string
  /** Enable lazy loading */
  lazyload?: boolean
  /** Image width in pixels */
  width?: number
  /** Image height in pixels */
  height?: number
  /** Any other attribute is passed through to the rendered element. */
  [key: string]: unknown
}

const { imgPath, alt, classes = '', lazyload = true, width, height, ...rest } = Astro.props

const classNames = ['image', classes].filter(Boolean).join(' ')

const basePath = imgPath.split('/').slice(0, -1).join('/')
const basename = imgPath.split('/').pop()?.split('.')[0] || ''
const ext = imgPath.includes('.') ? `.${imgPath.split('.').pop()}` : ''

const imgPath1x = getVersionedPublicPath(`${basePath}/${basename}${ext}`)
const imgPath2x = getVersionedPublicPath(`${basePath}/${basename}@2x${ext}`)
---

<img
  class={classNames}
  srcset={`${imgPath1x}, ${imgPath2x} 2x`}
  src={imgPath1x}
  alt={alt}
  loading={lazyload ? 'lazy' : undefined}
  width={width}
  height={height}
  {...rest}
/>
