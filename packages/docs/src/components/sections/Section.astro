---
/**
 * Section
 *
 * A section of a home page: its head (the eyebrow, the title and the lead) over its content,
 * in the container of the page, with the spacing of the design. The content is the default
 * slot: `<Rows>`, `<Steps>`, `<Cards>`, `<Doors>`, or markup of the site's own, so a section
 * that only one site has lines up with the others.
 *
 * The head sits on the first seven columns from `xl`, nine on a tablet (`lg`) and all of them
 * below. The title has the section title style of the design (`.cxd-section-title`).
 *
 * The title and the lead are text (`title`, `lead`) or the `title` and `lead` slots, for
 * markup of the page's own. Each `<span>` child of the title is a line that breaks from `lg`
 * and flows below; `d-block` on it breaks it at every width. Inside, `<em>`, `<strong>`, links
 * and `<mark>` (the highlight colour of the design) work as written. Write `{' '}` between two
 * lines: Astro drops the line break between them.
 *
 * What scrolls into view plays its motion (`js/reveal.js`): the title block and the lead rise
 * in turn, and so do the children of an element of the content with `data-reveal="children"`.
 */

import '../../scss/sections.scss'

interface Props {
  /** The id of the section, the target of a link to it. The title has `<id>-title`. */
  id: string
  /** The short line above the title, in normal case: it is set in capitals by CSS. */
  eyebrow?: string
  /** The lines of the title, as text. The `title` slot takes markup instead. A section without
   * a title takes `label`. */
  title?: string[]
  /** The paragraph under the title, as text. The `lead` slot takes markup instead. */
  lead?: string
  /** The accessible name of a section without a title. */
  label?: string
  /** Additional CSS classes of the section. */
  class?: string
}

const { id, eyebrow, title, lead, label, class: className } = Astro.props
const titleId = `${id}-title`
const hasTitle = Boolean(title) || Astro.slots.has('title')
const hasLead = Boolean(lead) || Astro.slots.has('lead')
---

<section
  class:list={['cxd-section', className]}
  id={id}
  aria-labelledby={hasTitle ? titleId : undefined}
  aria-label={hasTitle ? undefined : label}
>
  <div class="container 2xl cxd-section-body">
    {hasTitle && (
      <div class="grid cxd-section-head">
        <div class="col-span-full lg:col-span-9 xl:col-span-7 vstack gap-lg" data-reveal="children">
          <div class="vstack gap-xs">
            {eyebrow && <p class="font-label-lg fg-highlight text-uppercase m-0">{eyebrow}</p>}
            <h2 class="cxd-section-title" id={titleId}>
              <slot name="title">
                {title?.map((line, index) => (
                  <>
                    {index > 0 && ' '}
                    <span>{line}</span>
                  </>
                ))}
              </slot>
            </h2>
          </div>
          {hasLead && (
            <p class="cxd-section-lead m-0">
              <slot name="lead">{lead}</slot>
            </p>
          )}
        </div>
      </div>
    )}
    <slot />
  </div>
</section>

<script>
  import '../../js/reveal.js'
</script>
