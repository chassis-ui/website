---
/**
 * Section Head
 *
 * The head of a section: the eyebrow over the title, then the lead, on the first seven
 * columns from `xl`, nine on a tablet (`lg`) and all of them below, as in the design. The
 * title has the section title style of the design (`.cxd-section-title`). The title block and
 * the lead rise in turn when the head scrolls into view (`data-reveal`).
 *
 * The title is the `title` lines, or `titleHtml`, markup of the page's own (the `title` slot
 * of `<Section>`, rendered). Each
 * `<span>` child of the title is a line that breaks from `lg` and flows below; `d-block` on
 * it breaks it at every width. Inside, `<em>`, `<strong>`, links and `<mark>` work as
 * written: `<mark>` is the highlight colour of the design. The lead is the `lead` text, or
 * `leadHtml` with the same inline markup.
 */

import '../../scss/sections.scss'

interface Props {
  /** The id of the title, for the `aria-labelledby` of the section. */
  id: string
  /** The short line above the title, in normal case: it is set in capitals by CSS. */
  eyebrow?: string
  /** The lines of the title, as text. */
  title?: string[]
  /** The title as markup, in place of `title`. */
  titleHtml?: string
  /** The paragraph under the title, as text. */
  lead?: string
  /** The lead as markup, in place of `lead`. */
  leadHtml?: string
}

const { id, eyebrow, title = [], titleHtml, lead, leadHtml } = Astro.props
---

<div class="grid cxd-section-head">
  <div class="col-span-full lg:col-span-9 xl:col-span-7 vstack gap-lg" data-reveal="children">
    <div class="vstack gap-xs">
      {eyebrow && <p class="font-label-lg fg-highlight text-uppercase m-0">{eyebrow}</p>}
      <h2 class="cxd-section-title" id={id}>
        {titleHtml ? (
          <Fragment set:html={titleHtml} />
        ) : (
          title.map((line, index) => (
            <>
              {index > 0 && ' '}
              <span>{line}</span>
            </>
          ))
        )}
      </h2>
    </div>
    {leadHtml ? (
      <p class="cxd-section-lead m-0" set:html={leadHtml} />
    ) : (
      lead && <p class="cxd-section-lead m-0">{lead}</p>
    )}
  </div>
</div>
