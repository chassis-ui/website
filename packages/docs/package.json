{
  "name": "@ozgurgunes/chassis-docs",
  "version": "1.0.0",
  "description": "Reusable Astro components and layouts for Chassis documentation sites",
  "type": "module",
  "main": "index.ts",
  "exports": {
    ".": "./index.ts",
    "./components": "./src/components/index.ts",
    "./shortcodes": "./src/components/shortcodes/*",
    "./layouts": "./src/layouts/index.ts",
    "./libs": "./src/libs/index.ts",
    "./js": "./src/js/*",
    "./scss": "./src/scss/*",
    "./scss/settings": "./src/scss/_settings.scss"
  },
  "files": [
    "src",
    "index.ts",
    "README.md"
  ],
  "keywords": [
    "astro",
    "chassis",
    "documentation",
    "components",
    "layouts",
    "design-system"
  ],
  "author": "Chassis Design System",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ozgurgunes/chassis-docs.git",
    "directory": "apps/docs"
  },
  "bugs": {
    "url": "https://github.com/ozgurgunes/chassis-docs/issues"
  },
  "homepage": "https://chassisui.com",
  "peerDependencies": {
    "@astrojs/markdown-remark": "^4.0.0 || ^5.0.0",
    "@ozgurgunes/chassis-css": "*",
    "@ozgurgunes/chassis-icons": "*",
    "@ozgurgunes/chassis-tokens": "*",
    "astro": "^4.0.0 || ^5.0.0",
    "clipboard": "^2.0.0",
    "prismjs": "^1.29.0"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^5.3.0",
    "@astrojs/mdx": "^4.3.5",
    "@astrojs/prism": "^3.3.0",
    "@docsearch/css": "^3.9.0",
    "@docsearch/js": "^3.9.0",
    "@ozgurgunes/chassis-css": "github:ozgurgunes/chassis-css#app/docs",
    "@ozgurgunes/chassis-icons": "github:ozgurgunes/chassis-icons#staging",
    "@ozgurgunes/chassis-tokens": "github:ozgurgunes/chassis-tokens#app/docs",
    "@types/hast": "^3.0.4",
    "@types/prismjs": "^1.26.0",
    "astro": "^5.13.9",
    "clipboard": "^2.0.11",
    "github-slugger": "^2.0.0",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-to-string": "^4.0.0",
    "prismjs": "^1.30.0",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "typescript": "^5.9.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  }
}
