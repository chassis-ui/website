{
  "name": "@chassis-ui/docs",
  "description": "Shared Astro components and layouts for Chassis documentation sites.",
  "version": "0.7.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/chassis-ui/website.git",
    "directory": "packages/docs"
  },
  "bugs": {
    "url": "https://github.com/chassis-ui/website/issues"
  },
  "homepage": "https://chassis-ui.com",
  "author": "Ozgur Gunes <o.gunes@gmail.com>",
  "license": "MIT",
  "keywords": [
    "astro",
    "chassis",
    "documentation",
    "components",
    "layouts",
    "design-system"
  ],
  "files": [
    "bin",
    "src",
    "index.ts",
    "virtual.d.ts",
    "README.md",
    "UPGRADING.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "bin": {
    "chassis-docs": "./bin/chassis-docs.js"
  },
  "main": "index.ts",
  "exports": {
    ".": "./index.ts",
    "./integration": "./src/integration.ts",
    "./schema": "./src/libs/schema.ts",
    "./site": "./src/site.ts",
    "./layouts/BaseLayout.astro": "./src/layouts/BaseLayout.astro",
    "./layouts/DocsLayout.astro": "./src/layouts/DocsLayout.astro",
    "./layouts/RedirectLayout.astro": "./src/layouts/RedirectLayout.astro",
    "./layouts/SingleLayout.astro": "./src/layouts/SingleLayout.astro",
    "./components/DocsSidebar.astro": "./src/components/DocsSidebar.astro",
    "./components/FeatureCard.astro": "./src/components/FeatureCard.astro",
    "./components/NavLink.astro": "./src/components/NavLink.astro",
    "./components/ResponsiveImage.astro": "./src/components/ResponsiveImage.astro",
    "./components/TableOfContents.astro": "./src/components/TableOfContents.astro",
    "./components/ThemeToggler.astro": "./src/components/ThemeToggler.astro",
    "./shortcodes/*": "./src/components/shortcodes/*",
    "./js/*": "./src/js/*",
    "./scss/main": "./src/scss/main.scss",
    "./scss/main.scss": "./src/scss/main.scss",
    "./scss/vars": "./src/scss/_vars.scss",
    "./scss/_vars.scss": "./src/scss/_vars.scss",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "astro": "astro"
