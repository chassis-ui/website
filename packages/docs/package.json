  "peerDependencies": {
    "@astrojs/markdown-remark": "^7.0.0",
    "@chassis-ui/css": ">=0.6.0",
    "@pagefind/component-ui": "^1.0.0",
    "@shikijs/transformers": "^4.3.1",
    "astro": "^7.0.0",
    "html-validate": "^11.0.0",
    "htmlparser2": "^12.0.0",
    "rehype-autolink-headings": "^7.0.0",
    "sass": "^1.101.0",
    "shiki": "^4.3.1",
    "vnu-jar": ">=26.0.0"
  },
  "peerDependenciesMeta": {
    "html-validate": {
      "optional": true
    },
    "vnu-jar": {
      "optional": true
    }
  },
  "dependencies": {
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "clipboard": "^2.0.11",
    "github-slugger": "^2.0.0",
    "image-size": "^2.0.4",
    "js-yaml": "^5.4.2",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-mdx-jsx": "^3.2.0",
    "mdast-util-to-string": "^4.0.0",
    "medium-zoom": "^1.1.0",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@chassis-ui/css": "^0.6.0",
    "@pagefind/component-ui": "^1.5.2",
    "@shikijs/transformers": "^4.5.0",
    "astro": "^7.3.5",
    "html-validate": "^11.16.1",
    "rehype-autolink-headings": "^7.1.0",
    "remark-mdx": "^3.1.1",
