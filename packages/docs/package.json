{
  "name": "@chassis-ui/docs",
  "description": "Shared Astro components and layouts for Chassis documentation sites.",
  "version": "0.3.3",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/chassis-ui/website.git",
    "directory": "packages/docs"
  },
  "bugs": {
    "url": "https://github.com/chassis-ui/website/issues"
  },
  "homepage": "https://chassis-ui.com",
  "author": "Ozgur Gunes <o.gunes@gmail.com>",
  "license": "MIT",
  "keywords": [
    "astro",
    "chassis",
    "documentation",
    "components",
    "layouts",
    "design-system"
  ],
  "files": [
    "src",
    "index.ts",
    "README.md"
  ],
  "main": "index.ts",
  "exports": {
    ".": "./index.ts",
    "./components/*": "./src/components/*",
    "./shortcodes/*": "./src/components/shortcodes/*",
    "./layouts/*": "./src/layouts/*",
    "./libs/*": "./src/libs/*",
    "./js/*": "./src/js/*",
    "./scss/*": "./src/scss/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "astro": "astro"
  },
  "peerDependencies": {
    "@astrojs/markdown-remark": "^7.0.0",
    "@chassis-ui/css": ">=0.3.1",
    "@pagefind/component-ui": "^1.0.0",
    "@shikijs/transformers": "^4.3.1",
    "astro": "^7.0.0",
    "htmlparser2": "^12.0.0",
    "rehype-autolink-headings": "^7.0.0",
    "sass": "^1.101.0",
    "shiki": "^4.3.1"
  },
  "peerDependenciesMeta": {
    "@pagefind/component-ui": {
      "optional": true
    }
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "image-size": "^2.0.2",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-to-string": "^4.0.0",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "astro": "^7.0.6",
    "unified": "^11.0.5",
    "vite": "^8.1.3"
  }
}
