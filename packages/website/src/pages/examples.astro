---
import BaseLayout from '@chassis-ui/docs/layouts/BaseLayout.astro'
import Icon from '@chassis-ui/docs/shortcodes/Icon.astro'
import PageHero from '@components/PageHero.astro'
import chassisPreview from '../assets/examples/vanilla-chassis.jpg'
import secondBrandPreview from '../assets/examples/vanilla-second-brand.jpg'

// Each example is a repository of its own, deployed as a website per brand: the same
// commit, built with the design tokens, the fonts and the logo of the brand.
const examples = [
  {
    title: 'HTML / CSS',
    description:
      'One HTML page styled with Chassis CSS and Chassis Icons. No framework and no bundler: context classes, a form, buttons, badges and icons. One repository is deployed as a website per brand, each with its own design tokens, fonts and logo.',
    source: 'https://github.com/chassis-ui/vanilla-example',
    sites: [
      {
        label: 'View Chassis Brand',
        url: 'https://example-1.chassis-ui.com/',
        image: chassisPreview,
        alt: 'The example page in the Chassis brand, in dark mode'
      },
      {
        label: 'View Example Brand',
        url: 'https://example-2.chassis-ui.com/',
        image: secondBrandPreview,
        alt: 'The same page in a second brand, with its own colours, fonts and logo'
      }
    ]
  }
]
// The native apps: one repository each, built per brand by one build setting.
const apps = [
  {
    title: 'iOS / Swift',
    description:
      'A SwiftUI app that takes its colours, type, spacing, fonts, icons and images from the iOS releases of the Chassis tokens, assets and icons. One build setting chooses the brand, and each brand installs as an app of its own.',
    source: 'https://github.com/chassis-ui/ios-example'
  },
  {
    title: 'Android / Kotlin',
    description:
      'The same app in Jetpack Compose, with the tokens, assets and icons as Android resources from the same releases. One Gradle property chooses the brand, and the app runs from Android 8.',
    source: 'https://github.com/chassis-ui/android-example'
  }
]
const lead = 'Working multi-brand projects built with Chassis, with their source on GitHub.'
---

<BaseLayout title="Examples" description={lead} navbarContext="alternate">
  <Fragment slot="main">
    <main id="content">
      <PageHero title="Examples" lead={lead} meta="Web  ·  iOS  ·  Android" />

      <div class="container 2xl page-section">
        {examples.map((example) => (
          <section class="grid row-gap-6xl" aria-label={example.title}>
            <div class="col-span-full lg:col-span-7 vstack gap-md align-items-start">
              <h2 class="font-h2 m-0">{example.title}</h2>
              <p class="font-body-lg m-0">{example.description}</p>
              <a class="button default outline" href={example.source}>
                <Icon name="github-brand" />
                View on GitHub
              </a>
            </div>
            <ul class="col-span-full page-list examples-pair">
              {example.sites.map((site) => (
                <li class="vstack gap-md align-items-start">
                  <a href={site.url} class="examples-preview rounded-md" tabindex="-1">
                    <img
                      src={site.image.src}
                      width={site.image.width}
                      height={site.image.height}
                      alt={site.alt}
                      loading="lazy"
                    />
                  </a>
                  <a
                    href={site.url}
                    class="examples-link font-sm font-strong d-inline-flex align-items-center gap-xs"
                  >
                    {site.label}
                    <Icon name="arrow-right-outline" class="icon-reset icon-sm" />
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
        <div class="examples-pair">
          {apps.map((app) => (
            <section class="vstack gap-md align-items-start" aria-label={app.title}>
              <h2 class="font-h2 m-0">{app.title}</h2>
              <p class="font-body-lg m-0">{app.description}</p>
              <a class="button default outline" href={app.source}>
                <Icon name="github-brand" />
                View on GitHub
              </a>
            </section>
          ))}
        </div>
      </div>
    </main>
  </Fragment>
</BaseLayout>
