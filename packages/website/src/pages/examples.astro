---
import SingleLayout from '@chassis-ui/docs/layouts/SingleLayout.astro'
import vanillaHtml from '../../../../examples/vanilla-html/package.json'

// Each example is a folder in `examples/` of this repository. The site serves its build
// output under /examples/<folder>/, with a copy for each brand of the example under
// /examples/<folder>/<brand>/. See ref/DEVELOPMENT.md.
const examples = [
  {
    folder: 'vanilla-html',
    title: 'Vanilla HTML',
    description:
      'One HTML page styled with Chassis CSS and Chassis Icons. No framework and no bundler: context classes, a form, buttons, badges and icons. It is built once per brand, each with its own design tokens, fonts and logo.',
    brands: vanillaHtml.chassis.build.brands
  }
]

const titleOf = (brand: string) => brand.charAt(0).toUpperCase() + brand.slice(1)
---

<SingleLayout
  title="Examples"
  description="Working projects built with Chassis, with their source on GitHub."
>
  <section class="py-3xl md:py-6xl">
    <div class="container 2xl">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-md lg:gap-3xl">
        {examples.map((example) => (
          <div>
            <h2>{example.title}</h2>
            <p class="font-lg fg-subtle mb-xl">{example.description}</p>
            <div class="d-flex flex-wrap gap-md">
              {example.brands.map((brand) => (
                <a href={`/examples/${example.folder}/${brand}/`} class="button default">
                  Open in the {titleOf(brand)} brand
                </a>
              ))}
              <a
                href={`https://github.com/chassis-ui/website/tree/main/examples/${example.folder}`}
                class="button outline"
                target="_blank"
                rel="noopener noreferrer"
              >
                View the source
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</SingleLayout>
