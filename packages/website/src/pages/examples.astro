---
import SingleLayout from '@chassis-ui/docs/layouts/SingleLayout.astro'

// Each example is a folder in `examples/` of this repository. The site serves its build
// output under /examples/<folder>/. See ref/DEVELOPMENT.md.
const examples = [
  {
    folder: 'vanilla-html',
    title: 'Vanilla HTML',
    description:
      'One HTML page styled with Chassis CSS and Chassis Icons from npm. No framework and no bundler: context classes, a form, buttons, badges and icons.'
  }
]
---

<SingleLayout
  title="Examples"
  description="Working projects built with Chassis, with their source on GitHub."
>
  <section class="py-3xl md:py-6xl">
    <div class="container 2xl">
      <div class="row g-md lg:g-3xl">
        {
          examples.map((example) => (
            <div class="col-12 lg:col-6">
              <h2>{example.title}</h2>
              <p class="font-lg fg-subtle mb-xl">{example.description}</p>
              <div class="d-flex flex-wrap gap-md">
                <a href={`/examples/${example.folder}/`} class="button default">
                  Open the example
                </a>
                <a
                  href={`https://github.com/chassis-ui/website/tree/main/examples/${example.folder}`}
                  class="button outline"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  View the source
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</SingleLayout>
