---
import SingleLayout from '@chassis-ui/docs/layouts/SingleLayout.astro'

// Each example is a repository of its own, deployed as a website per brand: the same
// commit, built with the design tokens, the fonts and the logo of the brand.
const examples = [
  {
    title: 'Vanilla HTML',
    description:
      'One HTML page styled with Chassis CSS and Chassis Icons. No framework and no bundler: context classes, a form, buttons, badges and icons. One repository is deployed as a website per brand, each with its own design tokens, fonts and logo.',
    source: 'https://github.com/chassis-ui/vanilla-example',
    sites: [
      { brand: 'Chassis', url: 'https://example-1.chassis-ui.com/' },
      { brand: 'Sinefil', url: 'https://example-2.chassis-ui.com/' }
    ]
  }
]
---

<SingleLayout
  title="Examples"
  description="Working projects built with Chassis, with their source on GitHub."
>
  <section class="py-3xl md:py-6xl">
    <div class="container 2xl">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-md lg:gap-3xl">
        {examples.map((example) => (
          <div>
            <h2>{example.title}</h2>
            <p class="font-lg fg-subtle mb-xl">{example.description}</p>
            <div class="d-flex flex-wrap gap-md">
              {example.sites.map((site) => (
                <a href={site.url} class="button default">
                  Open in the {site.brand} brand
                </a>
              ))}
              <a
                href={example.source}
                class="button outline"
                target="_blank"
                rel="noopener noreferrer"
              >
                View the source
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</SingleLayout>
