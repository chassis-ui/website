---
import SingleLayout from '@chassis-ui/docs/layouts/SingleLayout.astro'
---

<SingleLayout
  title="Examples"
  description="Real-world implementations of Chassis across different frameworks, platforms, and use cases — from vanilla HTML to React apps and beyond."
>
  <section class="fg-subtle py-3xlarge py-medium-6xlarge">
    <div class="container-2xlarge">
      <div class="row justify-content-center text-center">
        <div class="col-12 col-large-8">
          <h2>Coming Soon</h2>
          <p class="font-large fg-subtle mt-medium mb-3xlarge">
            A curated set of real-world implementations is in the works. Each example will show how
            to integrate Chassis tokens, CSS, and components into a working project.
          </p>
          <a
            href="https://github.com/chassis-ui"
            class="button default"
            target="_blank"
            rel="noopener noreferrer"
          >
            Follow progress on GitHub
          </a>
        </div>
      </div>
    </div>
  </section>
</SingleLayout>
