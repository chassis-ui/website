---
import BlogLayout from '@layouts/BlogLayout.astro'
import { blogPages } from '@libs/content'
import { tagsToArray } from '@libs/blog'

const tagCounts = new Map<string, number>()

blogPages.forEach((page) => {
  tagsToArray(page.data.tags).forEach((tag) => {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1)
  })
})

const sortedTags = Array.from(tagCounts.entries()).sort((a, b) => b[1] - a[1])

const frontmatter = {
  title: 'Blog posts by tags',
  description: `${blogPages.length} blog posts organized by ${tagCounts.size} tags`
}
---

<BlogLayout frontmatter={frontmatter}>
  <ol class="breadcrumb" slot="breadcrumb">
    <li class="breadcrumb-item"><a href="/blog">Blog</a></li>
    <li class="breadcrumb-item" aria-current="page">Tags</li>
  </ol>

  <section class="mb-2xlarge">
    <header class="mb-medium large:mb-3xlarge">
      <h2>Tags</h2>
      <p class="font-large">Topics covered across the blog</p>
    </header>
    <div class="d-flex flex-wrap gap-xsmall">
      {
        sortedTags.map(([tag, count]) => (
          <a href={`/blog/tags/${encodeURIComponent(tag)}/`} class="chip large neutral smooth">
            {tag}
            <span class="badge neutral -me-xsmall">{count}</span>
          </a>
        ))
      }
    </div>
  </section>
</BlogLayout>
