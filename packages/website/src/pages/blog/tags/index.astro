---
import BlogLayout from '@layouts/BlogLayout.astro'
import { blogPages } from '@libs/content'
import { tagsToArray } from '@libs/blog'

const tagCounts = new Map<string, number>()

blogPages.forEach((page) => {
  tagsToArray(page.data.tags).forEach((tag) => {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1)
  })
})

const sortedTags = Array.from(tagCounts.entries()).sort((a, b) => b[1] - a[1])

const frontmatter = {
  title: 'Tags',
  description: `${blogPages.length} blog posts organized by ${tagCounts.size} tags`
}
---

<BlogLayout frontmatter={frontmatter}>
  <ol class="breadcrumb mb-0 md:-mt-3xl" slot="breadcrumb">
    <li class="breadcrumb-item">
      <a href="/blog" class="text-decoration-none">
        Blog
      </a>
    </li>
    <li class="breadcrumb-item" aria-current="page">
      Tags
    </li>
  </ol>

  <section class="vstack gap-md" aria-labelledby="blog-tags-title">
    <h2 class="font-h3 fg-subtle m-0" id="blog-tags-title">
      All tags
    </h2>
    <ul class="bulletless m-0 d-flex flex-wrap gap-md">
      {sortedTags.map(([tag, count]) => (
        <li>
          <a href={`/blog/tags/${encodeURIComponent(tag)}/`} class="chip primary smooth lg">
            {tag}
            <span class="badge primary -me-xs">{count}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BlogLayout>
