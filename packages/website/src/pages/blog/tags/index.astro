---
import BlogLayout from '@layouts/BlogLayout.astro'
import { blogPages } from '@libs/content'
import { tagsToArray } from '@libs/blog'

const tagCounts = new Map<string, number>()

blogPages.forEach((page) => {
  tagsToArray(page.data.tags).forEach((tag) => {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1)
  })
})

const sortedTags = Array.from(tagCounts.entries()).sort((a, b) => b[1] - a[1])

const frontmatter = {
  title: 'Blog posts by tags',
  description: `Explore ${blogPages.length} blog posts organized by ${tagCounts.size} tags`
}
---

<BlogLayout frontmatter={frontmatter}>
  <ol class="breadcrumb" slot="breadcrumb">
    <li class="breadcrumb-page"><a href="/blog">Blog</a></li>
    <li class="breadcrumb-page active" aria-current="page">Tags</li>
  </ol>

  <section class="mb-2xlarge">
    <h2>Tags</h2>
    <p>Topics covered across the blog</p>
    <div class="d-flex flex-wrap gap-medium">
      {
        sortedTags.map(([tag, count]) => (
          <a href={`/blog/tags/${tag}/`} class="button smooth default">
            {tag}
            <span class="badge default ms-2xsmall">{count}</span>
          </a>
        ))
      }
    </div>
  </section>
</BlogLayout>
