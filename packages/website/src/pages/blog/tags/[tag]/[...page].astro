---
import type { GetStaticPathsOptions } from 'astro'
import BlogLayout from '@layouts/BlogLayout.astro'
import BlogPostCard from '@components/blog/BlogPostCard.astro'
import { getConfig } from '@libs/config'
import { blogPages } from '@libs/content'
import { tagsToArray } from '@libs/blog'
import Pagination from '@components/blog/Pagination.astro'
import type { CollectionEntry } from 'astro:content'

type BlogPost = CollectionEntry<'blog'>

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const config = await getConfig()

  const tags = new Set<string>()
  blogPages.forEach((page: BlogPost) => {
    tagsToArray(page.data.tags).forEach((tag) => tags.add(tag))
  })

  const paths = []
  for (const tag of tags) {
    const tagPosts = blogPages
      .filter((page: BlogPost) => tagsToArray(page.data.tags).includes(tag))
      .sort((a: BlogPost, b: BlogPost) => {
        const dateA = new Date(a.data.pubDate || 0)
        const dateB = new Date(b.data.pubDate || 0)
        return dateB.getTime() - dateA.getTime()
      })

    if (tagPosts.length > 0) {
      const paginatedPaths = paginate(tagPosts, {
        pageSize: config.blog.pageSize,
        params: { tag }
      })
      paths.push(...paginatedPaths)
    }
  }

  return paths
}

const { page } = Astro.props
const tag = Astro.params.tag as string

const postCount = page.total
const frontmatter = {
  title: `Blog posts with "${tag}" tag`,
  description: `Browse ${postCount} ${postCount === 1 ? 'post' : 'posts'} tagged with "${tag}"`
}
---

<BlogLayout frontmatter={frontmatter}>
  <ol class="breadcrumb" slot="breadcrumb">
    <li class="breadcrumb-page"><a href="/blog">Blog</a></li>
    <li class="breadcrumb-page"><a href="/blog/tags">Tags</a></li>
    <li class="breadcrumb-page active" aria-current="page">{tag}</li>
  </ol>

  {
    page.data.length > 0 ? (
      <div class="mb-xlarge">
        {page.data.map((post: BlogPost) => (
          <BlogPostCard post={post} />
        ))}
      </div>
    ) : (
      <p>No posts found.</p>
    )
  }

  <Pagination page={page} baseUrl={`/blog/tags/${tag}`} />
</BlogLayout>
