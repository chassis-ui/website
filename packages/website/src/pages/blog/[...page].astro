---
import type { GetStaticPathsOptions } from 'astro'
import BlogLayout from '@layouts/BlogLayout.astro'
import BlogPostList from '@components/blog/BlogPostList.astro'
import { blogPages } from '@libs/content'
import { getConfig } from '@chassis-ui/docs/site'
import type { SiteConfig } from '@libs/config'
import Pagination from '@components/blog/Pagination.astro'
import type { CollectionEntry } from 'astro:content'

type BlogPost = CollectionEntry<'blog'>

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const config = getConfig<SiteConfig>()

  // Sort blog posts by publication date (newest first)
  const sortedPosts = blogPages.sort((a: BlogPost, b: BlogPost) => {
    const dateA = new Date(a.data.pubDate || 0)
    const dateB = new Date(b.data.pubDate || 0)
    return dateB.getTime() - dateA.getTime()
  })

  return paginate(sortedPosts, {
    pageSize: config.blog.pageSize
  })
}

const { page } = Astro.props
---

<BlogLayout>
  <BlogPostList posts={page.data} />
  <Pagination page={page} baseUrl="/blog" />
</BlogLayout>
