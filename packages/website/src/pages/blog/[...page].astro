---
import type { GetStaticPathsOptions } from 'astro'
import BlogLayout from '@layouts/BlogLayout.astro'
import BlogPostCard from '@components/blog/BlogPostCard.astro'
import { blogPages } from '@libs/content'
import { getConfig } from '@libs/config'
import Pagination from '@components/blog/Pagination.astro'
import type { CollectionEntry } from 'astro:content'

type BlogPost = CollectionEntry<'blog'>

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const config = getConfig()

  // Sort blog posts by publication date (newest first)
  const sortedPosts = blogPages.sort((a: BlogPost, b: BlogPost) => {
    const dateA = new Date(a.data.pubDate || 0)
    const dateB = new Date(b.data.pubDate || 0)
    return dateB.getTime() - dateA.getTime()
  })

  return paginate(sortedPosts, {
    pageSize: config.blog.pageSize
  })
}

const { page } = Astro.props
---

<BlogLayout>
  {
    page.data.length > 0 ? (
      <div class="mb-xlarge">
        {page.data.map((post: BlogPost) => (
          <BlogPostCard post={post} />
        ))}
      </div>
    ) : (
      <div class="text-center py-xlarge">
        <h2 class="h4 mb-medium fg-subtle">No blog posts yet</h2>
        <p class="fg-subtle">Check back soon for insights and tutorials about design systems!</p>
      </div>
    )
  }

  <Pagination page={page} baseUrl="/blog" />
</BlogLayout>
