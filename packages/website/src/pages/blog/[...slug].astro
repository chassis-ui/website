---
import { render } from 'astro:content'
import BaseLayout from '@chassis-ui/docs/layouts/BaseLayout.astro'
import { blogPages } from '@libs/content'
import { getBlogPostUrl, getReadingTime, tagsToArray } from '@libs/blog'
import Code from '@chassis-ui/docs/shortcodes/Code.astro'
import Icon from '@chassis-ui/docs/shortcodes/Icon.astro'
import MediaImage from '@chassis-ui/docs/components/MediaImage.astro'
import { getVersionedStaticPath } from '@chassis-ui/docs/site'
import type { CollectionEntry } from 'astro:content'
import '@scss/pages.scss'
import '@scss/blog.scss'

export async function getStaticPaths() {
  // Newest first, so the previous post is the older one and the next post the newer one.
  const posts = [...blogPages].sort(
    (a, b) => (b.data.pubDate?.getTime() ?? 0) - (a.data.pubDate?.getTime() ?? 0)
  )

  return posts.map((blogPage: CollectionEntry<'blog'>, index) => {
    const pubDate = new Date(blogPage.data.pubDate || Date.now())
    const year = pubDate.getFullYear()
    const month = String(pubDate.getMonth() + 1).padStart(2, '0')
    const day = String(pubDate.getDate()).padStart(2, '0')

    // Extract slug from the file path (remove year folder and extension)
    const slug = blogPage.id.replace(/^\d{4}\//, '')

    return {
      params: { slug: `${year}/${month}/${day}/${slug}` },
      props: { blogPage, previous: posts[index + 1], next: posts[index - 1] }
    }
  })
}

type Props = {
  blogPage: CollectionEntry<'blog'>
  previous?: CollectionEntry<'blog'>
  next?: CollectionEntry<'blog'>
}

const { blogPage, previous, next } = Astro.props as Props
const { data } = blogPage
const tags = tagsToArray(data.tags)

// Use the render function from astro:content for custom loaders
const { Content } = await render(blogPage)
const date = data.pubDate
  ? new Date(data.pubDate).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    })
  : ''
const byline = [data.author, date, getReadingTime(blogPage.body || '')]
  .filter(Boolean)
  .join('  ·  ')
---

<BaseLayout
  frontmatter={{
    description: data.description,
    title: data.title,
    thumbnail: data.image && `media:${data.image.src}`,
    extraJs: data.extraJs
  }}
  layout="blog"
>
  <div class="container 2xl">
    <nav class="d-flex py-xl mb-xl border-bottom border-subtle" aria-label="Breadcrumb">
      <a href="/blog/" class="icon-link font-sm font-strong text-decoration-none text-uppercase">
        <Icon name="arrow-left-outline" class="icon-reset icon-sm" />
        Back to Blog
      </a>
    </nav>
    <div class="grid">
      <article class="col-span-full lg:col-span-8 lg:col-start-3 vstack gap-3xl pt-md pb-6xl">
        {tags.length > 0 && (
          <ul class="bulletless m-0 d-flex flex-wrap gap-md" aria-label="Tags">
            {tags.map((tag) => (
              <li>
                <a href={`/blog/tags/${encodeURIComponent(tag)}/`} class="chip primary smooth">
                  {tag}
                </a>
              </li>
            ))}
          </ul>
        )}
        <header class="vstack gap-3xl">
          <h1 class="font-hero m-0">{data.title}</h1>
          <p class="font-lg m-0">{byline}</p>
          {data.description && <p class="font-lead m-0">{data.description}</p>}
        </header>

        {data.image ? (
          <MediaImage
            src={data.image.src}
            alt={data.image.alt}
            width={1200}
            height={630}
            sizes="(width >= 96rem) 58rem, (width >= 64rem) 66vw, 100vw"
            loading="eager"
            fetchpriority="high"
            class="image fluid w-100 rounded-md"
          />
        ) : (
          <img
            src={getVersionedStaticPath('images/social-image.png')}
            alt=""
            width="1200"
            height="630"
            class="image fluid w-100 rounded-md"
          />
        )}

        <div class="blog-article">
          <Content components={{ pre: Code }} />
        </div>

        {(previous || next) && (
          <nav class="grid row-gap-md" aria-label="Other posts">
            {previous && (
              <a
                href={getBlogPostUrl(previous)}
                class="col-span-full md:col-span-6 vstack gap-2xs px-lg py-md rounded-md text-decoration-none blog-pager-link"
              >
                <span class="font-label-sm fg-subtle">Previous</span>
                <span class="font-title-sm">{previous.data.title}</span>
              </a>
            )}
            {next && (
              <a
                href={getBlogPostUrl(next)}
                class="col-span-full md:col-span-6 md:col-start-7 vstack gap-2xs px-lg py-md rounded-md text-decoration-none text-end blog-pager-link"
              >
                <span class="font-label-sm fg-subtle">Next</span>
                <span class="font-title-sm">{next.data.title}</span>
              </a>
            )}
          </nav>
        )}
      </article>
    </div>
  </div>
</BaseLayout>
