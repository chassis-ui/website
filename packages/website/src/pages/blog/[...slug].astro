---
import { render } from 'astro:content'
import BaseLayout from '@chassis-ui/docs/layouts/BaseLayout.astro'
import { blogPages } from '@libs/content'
import { tagsToArray } from '@libs/blog'
import Code from '@chassis-ui/docs/shortcodes/Code.astro'
import type { CollectionEntry } from 'astro:content'

export async function getStaticPaths() {
  return blogPages.map((blogPage: CollectionEntry<'blog'>) => {
    // Ensure blogPage is an object, not an array
    const pubDate = new Date(blogPage.data.pubDate || Date.now())
    const year = pubDate.getFullYear()
    const month = String(pubDate.getMonth() + 1).padStart(2, '0')
    const day = String(pubDate.getDate()).padStart(2, '0')

    // Extract slug from the file path (remove year folder and extension)
    const slug = blogPage.id.replace(/^\d{4}\//, '')

    return {
      params: { slug: `${year}/${month}/${day}/${slug}` },
      props: { blogPage }
    }
  })
}

type Props = {
  blogPage: CollectionEntry<'blog'>
}

const { blogPage } = Astro.props as Props
const { data } = blogPage
const tags = tagsToArray(data.tags)

// Use the render function from astro:content for custom loaders
const { Content } = await render(blogPage)
---

<BaseLayout frontmatter={{ description: data.description, title: data.title }}>
  <div class="container 2xlarge">
    <div class="col-12 large:col-10 2xlarge:col-8 mx-auto">
      <nav class="py-medium border-bottom border-subtle mb-xlarge" aria-label="Breadcrumb">
        <a href="/blog" class="icon-link text-decoration-none">
          <svg class="icon icon-adaptive" aria-hidden="true"
            ><use xlink:href="#arrow-left-outline"></use></svg
          >
          Back to Blog
        </a>
      </nav>

      <article class="mb-3xlarge">
        <header class="mb-xlarge text-center">
          <h1 class="font-5xlarge mb-medium">{data.title}</h1>

          <div class="d-flex align-items-center justify-content-center fg-subtle mb-medium">
            <time datetime={data.pubDate?.toISOString()}>
              {
                data.pubDate
                  ? new Date(data.pubDate).toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric'
                    })
                  : ''
              }
            </time>
            {
              data.author && (
                <>
                  <span class="mx-small">•</span>
                  <span>by {data.author}</span>
                </>
              )
            }
          </div>
        </header>

        <img
          src={data.image?.url || '/static/images/logo/chassis-logo-brand-banner.svg'}
          alt={data.image?.alt || data.title}
          class="image rounded fluid w-100 mb-medium"
        />

        <Content components={{ pre: Code }} />
      </article>
      {
        data.tags && (
          <aside class="py-medium border-top border-subtle">
            <h2 class="h6 fg-subtle mb-medium">Tags</h2>
            <div class="d-flex flex-wrap gap-xsmall">
              {tags.map((tag) => (
                <a href={`/blog/tags/${tag}/`} class="button smooth default small">
                  {tag}
                </a>
              ))}
            </div>
          </aside>
        )
      }
      <nav class="py-medium border-top border-subtle mb-xlarge" aria-label="Post navigation">
        <a href="/blog" class="icon-link text-decoration-none">
          <svg class="icon icon-adaptive" aria-hidden="true"
            ><use xlink:href="#arrow-left-outline"></use></svg
          >
          Back to Blog
        </a>
      </nav>
    </div>
  </div>
</BaseLayout>
