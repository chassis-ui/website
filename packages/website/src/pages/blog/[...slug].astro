---
import { render } from 'astro:content'
import BaseLayout from '@chassis-ui/docs/layouts/BaseLayout.astro'
import { blogPages } from '@libs/content'
import { tagsToArray } from '@libs/blog'
import Code from '@chassis-ui/docs/shortcodes/Code.astro'
import Icon from '@chassis-ui/docs/shortcodes/Icon.astro'
import type { CollectionEntry } from 'astro:content'
import '@scss/blog.scss'

export async function getStaticPaths() {
  return blogPages.map((blogPage: CollectionEntry<'blog'>) => {
    // Ensure blogPage is an object, not an array
    const pubDate = new Date(blogPage.data.pubDate || Date.now())
    const year = pubDate.getFullYear()
    const month = String(pubDate.getMonth() + 1).padStart(2, '0')
    const day = String(pubDate.getDate()).padStart(2, '0')

    // Extract slug from the file path (remove year folder and extension)
    const slug = blogPage.id.replace(/^\d{4}\//, '')

    return {
      params: { slug: `${year}/${month}/${day}/${slug}` },
      props: { blogPage }
    }
  })
}

type Props = {
  blogPage: CollectionEntry<'blog'>
}

const { blogPage } = Astro.props as Props
const { data } = blogPage
const tags = tagsToArray(data.tags)

// Use the render function from astro:content for custom loaders
const { Content } = await render(blogPage)
---

<BaseLayout
  frontmatter={{
    description: data.description,
    title: data.title,
    thumbnail: data.image?.url,
    extra_js: data.extra_js
  }}
  layout="blog"
>
  <div class="container 2xl">
    <nav class="col py-md border-bottom border-subtle mb-xl" aria-label="Breadcrumb">
      <a href="/blog" class="icon-link text-decoration-none">
        <Icon name="arrow-left-outline" class="icon-adaptive" /> Back to Blog
      </a>
    </nav>
    <div class="col-12 lg:col-10 2xl:col-8 mx-auto">
      {
        data.tags && (
          <div class="d-flex flex-wrap gap-xs justify-content-center my-xl lg:my-3xl">
            {tags.map((tag) => (
              <a href={`/blog/tags/${encodeURIComponent(tag)}/`} class="chip primary smooth">
                {tag}
              </a>
            ))}
          </div>
        )
      }
      <article class="blog-article mb-3xl">
        <header class="mb-xl text-center">
          <h1 class="font-5xl mb-md">{data.title}</h1>

          <div class="d-flex align-items-center justify-content-center fg-subtle mb-md">
            <time datetime={data.pubDate?.toISOString()}>
              {
                data.pubDate
                  ? new Date(data.pubDate).toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric'
                    })
                  : ''
              }
            </time>
            {
              data.author && (
                <>
                  <span class="mx-sm">•</span>
                  <span>by {data.author}</span>
                </>
              )
            }
          </div>
        </header>

        <img
          src={data.image?.url || '/static/images/social-image.png'}
          alt={data.image?.alt || data.title}
          class="image rounded fluid w-100 mb-xl lg:mb-3xl"
        />

        <Content components={{ pre: Code }} />
      </article>
    </div>
    <nav class="col py-md border-top border-subtle mb-xl" aria-label="Post navigation">
      <a href="/blog" class="icon-link text-decoration-none">
        <Icon name="arrow-left-outline" class="icon-adaptive" /> Back to Blog
      </a>
    </nav>
  </div>
</BaseLayout>
