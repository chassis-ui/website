---
import BaseLayout from '@chassis-ui/docs/layouts/BaseLayout.astro'
import { getVersionedStaticPath } from '@chassis-ui/docs/site'
import type { LayoutOverridesHTMLAttributes } from '@chassis-ui/docs'
import { previewBrandFiles } from '@libs/brand-preview'
import Hero from '@components/home/HeroSection.astro'
import Problem from '@components/home/ProblemSection.astro'
import Idea from '@components/home/IdeaSection.astro'
import Switch from '@components/home/SwitchSection.astro'
import Team from '@components/home/TeamSection.astro'
import Packages from '@components/home/PackagesSection.astro'
import Start from '@components/home/StartSection.astro'
import Facts from '@components/home/FactsSection.astro'
import Questions from '@components/home/QuestionsSection.astro'
import HomeIcons from '/static/icons/cx-sprite.svg?raw'
import '@scss/home.scss'

const bodyProps: LayoutOverridesHTMLAttributes<'body'> = {}
bodyProps['class'] = 'home-body'
---

<BaseLayout {...Astro.props} overrides={{ body: bodyProps }}>
  <Fragment slot="styles">
    {/* The second brand of the Switch cards: its fonts, and its CSS scoped to the cards. */}
    <link rel="stylesheet" href={getVersionedStaticPath(previewBrandFiles.fonts)} />
    <link rel="stylesheet" href={getVersionedStaticPath(previewBrandFiles.css)} />
  </Fragment>

  <Hero />
  <Problem />
  <Idea />
  <Switch />
  <Packages />
  <Team />
  <Start />
  <Facts />
  <Questions />
  <div hidden>
    <Fragment set:html={HomeIcons} />
  </div>
</BaseLayout>
