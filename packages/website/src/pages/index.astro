---
import BaseLayout from '@chassis-ui/docs/layouts/BaseLayout.astro'
import Hero from '@layouts/landing/HeroSection.astro'
import Tokens from '@layouts/landing/TokensSection.astro'
import Assets from '@layouts/landing/AssetsSection.astro'
import Figma from '@layouts/landing/FigmaSection.astro'
import CSS from '@layouts/landing/CSSSection.astro'
import Icons from '@layouts/landing/IconsSection.astro'
import HomeIcons from '@layouts/home/HomeIcons.svg?raw'
import LandingIcons from '@layouts/landing/LandingIcons.svg?raw'
import type { LayoutOverridesHTMLAttributes } from '@chassis-ui/docs'
import '@scss/home.scss'
import '@scss/landing.scss'

const bodyProps: LayoutOverridesHTMLAttributes<'body'> = {}
bodyProps['class'] = 'home-body'
---

<BaseLayout {...Astro.props} overrides={{ body: bodyProps }}>
  <Hero />
  <Tokens />
  <Assets />
  <Figma />
  <CSS />
  <Icons />
  <div class="d-none">
    <Fragment set:html={HomeIcons} />
    <Fragment set:html={LandingIcons} />
  </div>
</BaseLayout>
