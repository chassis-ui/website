---
const { icon, title, body } = Astro.props
---

<div class="feature-item">
  <div class="feature-thumb">
    <svg class="icon feature-icon"><use href={`#${icon}`}></use></svg>
  </div>
  <div>
    <h2 class="feature-title"><Fragment set:html={title} /></h2>
    <p class="feature-body">{body}</p>
  </div>
</div>
