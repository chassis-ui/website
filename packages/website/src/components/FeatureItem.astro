---
const { icon, title, body, className } = Astro.props
---

<div class={`feature-item${className ? ` ${className}` : ''}`}>
  <div class="feature-header">
    <div>
      <svg class="icon feature-icon"><use href={`#${icon}`}></use></svg>
    </div>
    <div>
      <h2 class="feature-title mb-xsmall"><slot name="title" /></h2>
      <p class="feature-body mb-xsmall"><slot name="body" /></p>
    </div>
  </div>
  <div class="feature-body">
    <slot />
  </div>
</div>
