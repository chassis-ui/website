---
const { icon, title, body, className } = Astro.props
---

<div class={`feature-item d-flex ${className ? ` ${className}` : ''}`}>
  <div class="feature-header">
    <div>
      <svg class="icon feature-icon" aria-hidden="true"><use href={`#${icon}`}></use></svg>
    </div>
    <div>
      <h3 class="feature-title mb-xsmall"><slot name="title" /></h3>
      <p class="feature-body mb-xsmall"><slot name="body" /></p>
    </div>
  </div>
  <div class="feature-body">
    <slot />
  </div>
</div>
