---
import type { CollectionEntry } from 'astro:content'
import { formatDate, getReadingTime, getBlogPostUrl } from '@libs/blog'
import Icon from '@chassis-ui/docs/shortcodes/Icon.astro'
import MediaImage from '@chassis-ui/docs/components/MediaImage.astro'
import { getVersionedStaticPath } from '@chassis-ui/docs/site'

interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const url = getBlogPostUrl(post)
---

<article class="grid row-gap-0 mb-xl pb-xl border-bottom border-subtle">
  <div class="col-span-full lg:col-span-4 mb-md lg:mb-0">
    <a href={url} class="d-block">
      {post.data.image ? (
        <MediaImage
          src={post.data.image.src}
          alt={post.data.image.alt}
          width={1200}
          height={630}
          sizes="(width >= 96rem) 28rem, (width >= 64rem) 31vw, 100vw"
          class="image rounded fluid w-100"
        />
      ) : (
        <img
          src={getVersionedStaticPath('images/social-image.png')}
          alt={post.data.title}
          width="1200"
          height="630"
          loading="lazy"
          class="image rounded fluid w-100"
        />
      )}
    </a>
  </div>
  <div class="col-span-full lg:col-span-8">
    <header class="mb-md">
      <h2 class="font-strong font-3xl mb-sm">
        <a href={url} class="fg-main text-decoration-none">
          {post.data.title}
        </a>
      </h2>
      <div class="fg-subtle sm">
        <time datetime={post.data.pubDate?.toISOString()} class="text-nowrap">
          {formatDate(post.data.pubDate || new Date())}
        </time>
        <span class="mx-xs">•</span>
        <span class="text-nowrap">{getReadingTime(post.body || '')}</span>
        {post.data.author && (
          <>
            <span class="mx-xs">•</span>
            <span class="text-nowrap">by {post.data.author}</span>
          </>
        )}
      </div>
    </header>

    {post.data.description && <p class="font-lg">{post.data.description}</p>}
    <footer>
      <a href={url} class="icon-link text-decoration-none">
        Read more <Icon name="arrow-right-outline" class="icon-adaptive" />
      </a>
    </footer>
  </div>
</article>
