---
/**
 * Pagination
 *
 * The pages of a paginated blog list, centred on a hairline. Nothing is rendered for one page.
 */

import type { Page } from 'astro'
import Icon from '@chassis-ui/docs/shortcodes/Icon.astro'

export interface Props {
  /** The page that `paginate()` gives the route. */
  page: Page
  /** The URL of the first page: the others are `{baseUrl}/{n}`. */
  baseUrl: string
  /** Accessible label for the navigation element */
  ariaLabel?: string
}

const { page, baseUrl, ariaLabel = 'Blog pagination' } = Astro.props
const pageUrl = (pageNum: number) => (pageNum === 1 ? baseUrl : `${baseUrl}/${pageNum}`)
const pages = Array.from({ length: page.lastPage }, (_, i) => i + 1)
---

{page.lastPage > 1 && (
  <nav aria-label={ariaLabel} class="blog-pagination d-flex justify-content-center p-md">
    <ul class="pagination">
      <li class:list={[{ disabled: !page.url.prev }]}>
        {page.url.prev ? (
          <a class="pagination-link" href={page.url.prev} aria-label="Previous page">
            <Icon name="chevron-left-solid" class="directional-icon" />
          </a>
        ) : (
          <span class="pagination-link" aria-disabled="true">
            <Icon name="chevron-left-solid" class="directional-icon" />
          </span>
        )}
      </li>
      {pages.map((pageNum) =>
        pageNum === page.currentPage ? (
          <li class="active" aria-current="page">
            <span class="pagination-link">{pageNum}</span>
          </li>
        ) : (
          <li>
            <a class="pagination-link" href={pageUrl(pageNum)} aria-label={`Page ${pageNum}`}>
              {pageNum}
            </a>
          </li>
        )
      )}
      <li class:list={[{ disabled: !page.url.next }]}>
        {page.url.next ? (
          <a class="pagination-link" href={page.url.next} aria-label="Next page">
            <Icon name="chevron-right-solid" class="directional-icon" />
          </a>
        ) : (
          <span class="pagination-link" aria-disabled="true">
            <Icon name="chevron-right-solid" class="directional-icon" />
          </span>
        )}
      </li>
    </ul>
  </nav>
)}
