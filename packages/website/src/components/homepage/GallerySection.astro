---
/**
 * Gallery Section
 *
 * Display component gallery images with light/dark mode variants.
 */

import GalleryImage from './GalleryImage.astro'

// The image is as wide as the container's content, 87rem from 2xl and the viewport less the
// padding below, and the scroll animation of `gsap.js` scales the gallery by 1.25. So the
// browser picks a file for 1.25 times the width of the content.
const sizes =
  '(width >= 96rem) 109rem, (width >= 48rem) calc(125vw - 3.75rem), calc(125vw - 2.5rem)'
---

<div id="gallery-section" class="home-section py-6xl">
  <div class="container 2xl section-content">
    <div class="overflow-hidden rounded">
      <div class="gallery-image bg-evident">
        <GalleryImage
          imgPath="/static/images/home/comp-gallery-light.webp"
          alt="A sheet of Chassis UI components: buttons, alerts, form fields, a date picker, tables, a chart, chips and tabs"
          sizes={sizes}
          classes="mb-5xl fluid w-100 visible-light t-0"
        />
        <GalleryImage
          imgPath="/static/images/home/comp-gallery-dark.webp"
          alt="A sheet of Chassis UI components: buttons, alerts, form fields, a date picker, tables, a chart, chips and tabs"
          sizes={sizes}
          classes="mb-5xl fluid w-100 visible-dark"
        />
      </div>
    </div>
  </div>
</div>
