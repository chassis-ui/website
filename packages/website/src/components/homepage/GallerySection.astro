---
/**
 * Gallery Section
 *
 * Display component gallery images with light/dark mode variants.
 */

import GalleryImage from '@components/shortcodes/GalleryImage.astro'
---

<div id="gallery-section" class="home-section py-6xlarge">
  <div class="container 2xlarge section-content">
    <div class="overflow-hidden rounded">
      <div class="gallery-image bg-evident">
        <GalleryImage
          imgPath="/static/images/home/comp-gallery-light.webp"
          alt="Chassis UI"
          classes="mb-5xlarge fluid w-100 visible-light t-0"
          width={1240}
          height={1080}
        />
        <GalleryImage
          imgPath="/static/images/home/comp-gallery-dark.webp"
          alt="Chassis UI"
          classes="mb-5xlarge fluid w-100 visible-dark"
          width={1240}
          height={1080}
        />
      </div>
    </div>
  </div>
</div>
