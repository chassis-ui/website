---
/**
 * Tokens Section
 *
 * Homepage section showcasing Chassis token management features.
 */

import FeatureCard from '@chassis-ui/docs/components/FeatureCard.astro'
import FeatureSlider from '@components/FeatureSlider.astro'
import Code from '@chassis-ui/docs/shortcodes/Code.astro'
---

<section
  id="tokens-section"
  class="home-section py-3xlarge medium:py-6xlarge"
  aria-labelledby="tokens-heading"
>
  <div class="container 2xlarge section-content">
    <div class="row mb-3xlarge medium:mb-6xlarge">
      <header class="section-header col large:col-10 2xlarge:col-8">
        <p class="fg-primary font-mass text-uppercase mb-xsmall">Chassis Tokens</p>
        <h2 id="tokens-heading" class="font-5xlarge mb-xsmall medium:mb-small large:mb-medium">
          <span class="font-normal d-block">Enterprise-Grade</span> Token Management
        </h2>
        <p class="font-lead m-0">
          Chassis provides a scalable design token architecture to manage design decisions across
          your entire product ecosystem. Define, transform, and sync tokens for multiple brands —
          across web, mobile, or any platform.
        </p>
      </header>
    </div>
    <div
      class="section-features gap-xlarge flex-column medium:flex-row mb-medium medium:mb-6xlarge"
    >
      <FeatureSlider ariaLabel="Tokens features carousel">
        <!-- Item -->
        <FeatureCard icon="cx-folder-tree" classes="swiper-slide" horizontal>
          <Fragment slot="title">Centralized token definitions</Fragment>
          <Fragment slot="body">
            Create and manage design tokens directly in Figma using Variables. Sync changes
            automatically with your codebase.
          </Fragment>
          <img
            src="/static/images/home/tokens-visual.svg"
            alt="Visual representation of centralized token definitions in Figma"
            class="image fluid w-100"
            width="512"
            height="288"
          />
        </FeatureCard>
        <!-- Item -->
        <FeatureCard icon="cx-link" classes="swiper-slide" horizontal>
          <Fragment slot="title">Intelligent references</Fragment>
          <Fragment slot="body">
            Build tokens that reference other tokens, enabling cascading updates across your entire
            system
          </Fragment>
          <img
            src="/static/images/home/tokens-scheme.svg"
            alt="Diagram showing token reference relationships and cascading updates"
            class="image fluid w-100"
            width="512"
            height="288"
          />
        </FeatureCard>
        <!-- Item -->
        <FeatureCard icon="cx-shapes" classes="swiper-slide" horizontal>
          <Fragment slot="title">Cross-platform transformation</Fragment>
          <Fragment slot="body">
            Convert tokens automatically for different platforms while preserving relationships and
            hierarchy
          </Fragment>
          <div class="pt-medium border-top border-subtle">
            <Code
              noToolbar
              lang="scss"
              code={`// dist/web/app-a/brand-a/main.scss
$cx-color-button: #00A4CC !default;`}
            />
            <Code
              noToolbar
              lang="swift"
              code={`// dist/ios/app-a/brand-a/main.swift
@objc public static let CxColorButton = UIColor(red: 0.000, green: 0.643, blue: 0.800, alpha: 1)`}
            />
            <Code
              noToolbar
              lang="xml"
              code={`<!-- dist/android/app-a/brand-a/main.xml -->
<color name="cx_color_button">#ff00a4cc</color>`}
            />
          </div>
        </FeatureCard>
      </FeatureSlider>
    </div>
    <p class="text-center fg-subtle -mt-xsmall mb-medium large:-mt-2xlarge large:mb-4xlarge">
      <span class="icon icon-adaptive icon-reset icon-info-circle-outline"></span>
      Token names are simplified in these examples to focus on the core concepts.
    </p>
    <div class="d-grid medium:d-flex gap-medium medium:justify-content-center">
      <a href="/tokens/" class="button primary large">Go to Chassis Tokens</a>
      <a href="/tokens/docs/" class="button default large">View Documentation</a>
    </div>
  </div>
</section>
