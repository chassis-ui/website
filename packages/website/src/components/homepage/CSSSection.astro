---
/**
 * CSS Section
 *
 * Homepage section showcasing Chassis CSS framework features.
 */

import FeatureCard from '@chassis-ui/docs/components/FeatureCard.astro'
import FeatureSlider from '@components/FeatureSlider.astro'
import Code from '@shortcodes/Code.astro'
---

<section id="css-section" class="home-section py-3xlarge py-medium-6xlarge">
  <div class="container-2xlarge section-content">
    <div class="row mb-3xlarge mb-medium-6xlarge">
      <header class="section-header col col-large-10 col-2xlarge-8">
        <p class="fg-primary font-mass text-uppercase mb-xsmall">Chassis Styles</p>
        <h2 class="font-5xlarge mb-xsmall mb-medium-small mb-large-medium">
          <span class="font-normal d-block">Code with tokens,</span> not translation layers.
        </h2>
        <p class="font-lead m-0">
          Design systems often require engineers to manually interpret design specs and translate
          them into CSS. That translation introduces errors and creates maintenance overhead.
          Chassis CSS generates its variables and utility classes directly from the token system, so
          design decisions arrive in code already implemented.
        </p>
      </header>
    </div>
    <div
      class="section-features gap-xlarge flex-column flex-medium-row mb-medium mb-medium-6xlarge"
    >
      <FeatureSlider>
        <!-- Item 1: Token-generated CSS variables -->
        <FeatureCard icon="cx-brackets-curly" classes="swiper-slide" horizontal>
          <Fragment slot="title">Token-generated CSS variables</Fragment>
          <Fragment slot="body">
            Design tokens become CSS custom properties automatically. Change a token, and every
            component that uses it updates.
          </Fragment>
          <div class="pt-medium border-top border-subtle">
            <Code
              lang="css"
              code={`/* Token-generated CSS variables */
:root {
  --cx-font-family-text: Inter, system-ui, -apple-system, Helvetica, Arial, sans-serif;
  --cx-font-size-text-medium: 1rem;
  --cx-font-size: var(--cx-font-size-text-medium);
  --cx-default-fg-main: #1c2021;
  --cx-default-fg-main-rgb: 28, 32, 33;
  --cx-fg-main: var(--cx-default-fg-main);
  --cx-space-medium: 1rem;
  --cx-border-radius-medium: 0.375rem;
  --cx-opacity-fg-subtle: 0.5;
  --cx-separator-size: 0.0625rem;
}`}
            />
          </div>
        </FeatureCard>

        <!-- Item 2: Perfectly align with Figma -->
        <FeatureCard icon="cx-figma" classes="swiper-slide" horizontal>
          <Fragment slot="title">Perfectly align with Figma</Fragment>
          <Fragment slot="body">
            Chassis CSS utility classes mirror Figma styles and variables for streamlined design to
            code implementation.
          </Fragment>
          <div class="pt-medium border-top border-subtle">
            <Code
              lang="html"
              code={`<!-- Utility classes in action -->
<div class="primary-bg-main border primary-border-main p-medium">
  <h5 class="primary-fg-main mb-0">
    Hello World!
  </h5>
  <p class="primary-fg-subtle mb-0">
    I'm a demonstration of Chassis Styles
  </p>
</div>`}
            />
            <div class="primary-bg-main border primary-border-main p-medium">
              <h5 class="primary-fg-main mb-0">Hello World!</h5>
              <p class="primary-fg-subtle mb-0">I'm a demonstration of Chassis Styles</p>
            </div>
          </div>
        </FeatureCard>

        <!-- Item 3: Faster frontend development -->
        <FeatureCard icon="cx-code" classes="swiper-slide" horizontal>
          <Fragment slot="title">Faster frontend development</Fragment>
          <Fragment slot="body">
            Stop re-implementing design decisions. Use a framework that already speaks your design
            system's language.
          </Fragment>
          <div class="pt-medium border-top border-subtle">
            <Code
              lang="html"
              code={`<!-- Context class in action -->
<div class="context info border border-main p-medium">
  <h5 class="mb-0">
    Hello World!
  </h5>
  <p class="fg-subtle mb-0">
    I'm a demonstration of Chassis Styles
  </p>
</div`}
            />
            <div class="context info border border-main p-medium">
              <h5 class="mb-0">Hello World!</h5>
              <p class="fg-subtle mb-0">I'm a demonstration of Chassis Styles</p>
            </div>
          </div>
        </FeatureCard>

        <!-- Item 4: Responsive by design -->
        <FeatureCard icon="cx-mobile-alt" classes="swiper-slide" horizontal>
          <Fragment slot="title">Responsive by design</Fragment>
          <Fragment slot="body">
            Built-in responsive utilities that adapt to your breakpoints. Write once, work
            everywhere.
          </Fragment>
          <div class="pt-medium border-top border-subtle">
            <Code
              lang="html"
              code={`<!-- Responsive utilities -->
<div class="d-flex flex-column flex-medium-row gap-small gap-large-medium">
  <div class="col col-medium-6 p-medium p-large-large">
    <h5 class="font-medium font-large-large mb-small">
      Responsive Layout
    </h5>
    <p class="font-small font-large-medium mb-0">
      Automatically adjusts spacing and typography
    </p>
  </div>
</div>`}
            />
          </div>
        </FeatureCard>
      </FeatureSlider>
    </div>
    <div class="d-grid d-medium-flex gap-medium justify-content-medium-center">
      <a href="/css/" class="button primary large">Go to Chassis Styles</a>
      <a href="/css/docs/" class="button default large">View Documentation</a>
    </div>
  </div>
</section>
