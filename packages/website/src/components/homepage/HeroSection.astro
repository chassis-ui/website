---
import ModuleItem from '@components/ModuleItem.astro'
---

<section id="hero-section" class="home-section hero-section">
  <div class="container-2xlarge section-content">
    <div class="row py-6xlarge">
      <div class="section-header text-center col col-large-10 offset-large-1">
        <h1 class="hero-title">
          <span class="font-normal">The foundation for</span>
          <span class="text-nowrap">scalable design systems</span>
        </h1>
        <p class="hero-body">
          Chassis provides modular infrastructure for design systems — from tokens and assets to
          Figma libraries and CSS frameworks — so your team can build, ship, and maintain consistent
          products at scale.
        </p>
      </div>
    </div>
    <div class="section-features align-content-stretch">
      <ModuleItem icon="cx-figma" title="Figma Components" url="#" />
      <ModuleItem icon="cx-swatchbook" title="Token Library" url="#" />
      <ModuleItem icon="cx-css3" title="CSS Framework" url="#" />
      <ModuleItem icon="cx-icons" title="Icon Generator" url="#" />
      <ModuleItem icon="cx-folder-tree" title="Asset Distributor" url="#" />
    </div>
  </div>
</section>
