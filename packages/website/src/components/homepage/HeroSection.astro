---
/**
 * Hero Section
 *
 * Homepage hero section with main heading and module navigation links.
 */

import ModuleLink from '@components/ModuleLink.astro'
---

<section
  id="hero-section"
  class="home-section py-3xl md:py-6xl"
  aria-labelledby="hero-heading"
>
  <div class="container 2xl section-content">
    <div class="row mb-3xl md:mb-6xl md:py-6xl">
      <header class="section-header text-center col lg:col-10 lg:offset-1">
        <h1 id="hero-heading" class="font-hero">
          <span class="font-normal">Design Systems That Scale &amp; Sync.</span>
          {' '}
          Across Brands. Across Platforms.
        </h1>
        <p class="font-lead">
          Chassis is the backbone of scalable design systems built for complex, evolving product
          ecosystems. It unifies Figma components, advanced design tokens, multi-platform
          transformers, asset libraries, and a fully token-synced CSS framework — all working in
          harmony across brands, platforms, and products.
        </p>
      </header>
    </div>
    <nav aria-label="Modules">
      <ul class="section-features d-flex flex-column md:flex-row align-content-stretch m-0 p-0">
        <ModuleLink icon="cx-swatchbook" title="Design Tokens" url="/tokens" />
        <ModuleLink icon="cx-figma" title="Figma Components" url="/figma" />
        <ModuleLink icon="cx-css3" title="CSS Framework" url="/css" />
        <ModuleLink icon="cx-folder-tree" title="Asset Distributor" url="/assets" />
        <ModuleLink icon="cx-icons" title="Icon Packager" url="/icons" />
      </ul>
    </nav>
  </div>
</section>
