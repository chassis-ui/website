---
import ModuleItem from '@components/ModuleItem.astro'
---

<section id="hero-section" class="home-section hero-section">
  <div class="container-2xlarge section-content">
    <div class="row py-6xlarge">
      <div class="section-header text-center col col-large-10 offset-large-1">
        <h1 class="hero-title">
          <span class="font-normal">Build Better Design Systems.</span>
          <span class="text-nowrap">In Sync, At Scale.</span>
        </h1>
        <p class="hero-body">
          Chassis is the backbone of scalable design systems built for complex, evolving product
          ecosystems. It unifies Figma components, advanced design tokens, multi-platform
          transformers, asset libraries, and a fully token-synced CSS framework — all working in
          harmony across brands, platforms, and products.
        </p>
      </div>
    </div>
    <div class="section-features align-content-stretch">
      <ModuleItem icon="cx-figma" title="Figma Components" url="/figma" />
      <ModuleItem icon="cx-swatchbook" title="Token Library" url="/tokens" />
      <ModuleItem icon="cx-css3" title="CSS Framework" url="/css" />
      <ModuleItem icon="cx-icons" title="Icon Generator" url="/icons" />
      <ModuleItem icon="cx-folder-tree" title="Asset Distributor" url="/assets" />
    </div>
  </div>
</section>
