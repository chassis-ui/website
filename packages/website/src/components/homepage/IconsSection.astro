---
/**
 * Icons Section
 *
 * Homepage section showcasing Chassis icon system features.
 */

import FeatureCard from '@chassis-ui/docs/components/FeatureCard.astro'
import FeatureSlider from '@components/FeatureSlider.astro'
import Code from '@chassis-ui/docs/shortcodes/Code.astro'
import Icon from '@chassis-ui/docs/shortcodes/Icon.astro'
---

<section
  id="icons-section"
  class="home-section py-3xlarge medium:py-6xlarge"
  aria-labelledby="icons-heading"
>
  <div class="container 2xlarge section-content">
    <div class="row mb-3xlarge medium:mb-6xlarge">
      <header class="section-header col large:col-10 2xlarge:col-8">
        <p class="fg-primary font-mass text-uppercase mb-xsmall">Chassis Icons</p>
        <h2 id="icons-heading" class="font-5xlarge mb-xsmall medium:mb-small large:mb-medium">
          <span class="font-normal d-block">Icons that ship</span> with your system.
        </h2>
        <p class="font-lead m-0">
          Icon libraries tend to grow organically — different naming conventions, inconsistent
          sizing, no clear ownership. Chassis Icons gives you a structured way to create, name, and
          distribute icons that stay consistent across design tools and codebases.
        </p>
      </header>
    </div>
    <div
      class="section-features gap-xlarge flex-column medium:flex-row mb-medium medium:mb-6xlarge"
    >
      <FeatureSlider ariaLabel="Icons features carousel">
        <!-- Item 1: Structured icon library -->
        <FeatureCard icon="cx-book" classes="swiper-slide" horizontal>
          <Fragment slot="title">Structured icon library</Fragment>
          <Fragment slot="body">
            A clear system for organizing icons by category, size, and variant — so every icon has a
            predictable location and name.
          </Fragment>

          <img
            src="/static/images/home/icon-library-light.svg"
            alt="Structured icon library"
            class="image fluid w-100 visible-light"
            width="512"
            height="288"
          />
          <img
            src="/static/images/home/icon-library-dark.svg"
            alt="Structured icon library"
            class="image fluid w-100 visible-dark"
            width="512"
            height="288"
          />
        </FeatureCard>

        <!-- Item 2: Easy team distribution -->
        <FeatureCard icon="cx-folders" classes="swiper-slide" horizontal>
          <Fragment slot="title">Easy team distribution</Fragment>
          <Fragment slot="body">
            Package and distribute icons as a versioned release. Every team gets the same set, with
            the same names, at the same version.
          </Fragment>
          <div class="pt-xsmall border-top border-subtle">
            <Code
              noToolbar
              lang="text"
              code={`dist/
├── icons/
│   ├── chassis-icons.css
│   ├── chassis-icons.scss
│   ├── chassis-icons.svg
│   ├── chassis-icons.woff
│   └── chassis-icons.woff2
└── svgs/
    ├── icon-file.svg
    ├── icon-file.svg
    └── ...`}
            />
          </div>
        </FeatureCard>

        <!-- Item 3: Design-to-code compatibility -->
        <FeatureCard icon="cx-laptop-code" classes="swiper-slide" horizontal>
          <Fragment slot="title">Multiple usage formats</Fragment>
          <Fragment slot="body">
            Icons flow from design tools into code as optimized SVGs with consistent markup. No
            manual cleanup needed.
          </Fragment>
          <div class="pt-xsmall border-top border-subtle">
            <Code
              noToolbar
              lang="jsx"
              code={`import '/icons/chassis-icons.css'

export default function IconExample() {
  return (
    <div>
      <span className="cx-info-circle-solid" />
      <svg><use href="/icons/chassis-icons.svg#info-circle-solid" /></svg>
      <img src="/icons/svgs/info-circle-solid.svg" alt="Info" width={24} height={24} />
    </div>
  )
}`}
            />
            <div
              class="icon-default pt-medium mt-xsmall border-top border-subtle d-flex gap-medium align-items-center justify-content-center"
            >
              <Icon name="info-circle-solid" font />
              <Icon name="info-circle-solid" font />
              <Icon name="info-circle-solid" font />
            </div>
          </div>
        </FeatureCard>
      </FeatureSlider>
    </div>
    <div class="d-grid medium:d-flex gap-medium medium:justify-content-center">
      <a href="/icons/" class="button primary large">Go to Chassis Icons</a>
      <a href="/icons/docs/" class="button default large">View Documentation</a>
    </div>
  </div>
</section>
