---
/**
 * Figma Section
 *
 * Homepage section showcasing Figma integration features.
 */

import FeatureCard from '@chassis-ui/docs/components/FeatureCard.astro'
import FeatureSlider from '@components/FeatureSlider.astro'
import ResponsiveImage from '@chassis-ui/docs/components/ResponsiveImage.astro'
---

<section id="figma-section" class="home-section py-3xl md:py-6xl" aria-labelledby="figma-heading">
  <div class="container 2xl section-content">
    <div class="grid mb-3xl md:mb-6xl">
      <header class="section-header col-span-full lg:col-span-10 2xl:col-span-8">
        <p class="fg-primary font-mass text-uppercase mb-xs">Chassis Figma</p>
        <h2 id="figma-heading" class="font-5xl mb-xs md:mb-sm lg:mb-md">
          <span class="font-normal d-block">One Library for</span> Every Brand, Every App
        </h2>
        <p class="font-lead m-0">
          A component library built entirely with design tokens. Swap brand, application, or color
          mode by switching Figma variable collections. All components adapt automatically.
        </p>
      </header>
    </div>
    <div class="section-features contains-inline mb-md md:mb-6xl">
      <FeatureSlider id="figma-features" ariaLabel="Figma features carousel">
        <!-- Item -->
        <FeatureCard icon="cx-swatchbook" classes="carousel-item" horizontal>
          <Fragment slot="title">Contextual color system</Fragment>
          <Fragment slot="body">
            Colors are organised by role — text, backgrounds, icons, indicators, and more — each
            with defined emphasis levels.
          </Fragment>
          <ResponsiveImage
            imgPath="/static/images/home/figma-tokens-light.webp"
            alt="A Figma file of color tokens: the roles of every context as swatches"
            classes="fluid w-100 visible-light shadow-lg"
            width={512}
            height={288}
          />
          <ResponsiveImage
            imgPath="/static/images/home/figma-tokens-dark.webp"
            alt="A Figma file of color tokens: the roles of every context as swatches"
            classes="fluid w-100 visible-dark shadow-lg"
            width={512}
            height={288}
          />
        </FeatureCard>
        <!-- Item -->
        <FeatureCard icon="cx-book-open-alt" classes="carousel-item" horizontal>
          <Fragment slot="title">Self-documented components</Fragment>
          <Fragment slot="body">
            Each component file includes a documentation page covering variants, props, specs, and
            the design tokens it uses.
          </Fragment>
          <ResponsiveImage
            imgPath="/static/images/home/figma-docs-light.webp"
            alt="The documentation page of the solid button in Figma, with its variants, props, tokens and specs"
            classes="fluid w-100 visible-light shadow-lg"
            width={512}
            height={288}
          />
          <ResponsiveImage
            imgPath="/static/images/home/figma-docs-dark.webp"
            alt="The documentation page of the solid button in Figma, with its variants, props, tokens and specs"
            classes="fluid w-100 visible-dark shadow-lg"
            width={512}
            height={288}
          />
        </FeatureCard>
        <!-- Item -->
        <FeatureCard icon="cx-compass-drafting" classes="carousel-item" horizontal>
          <Fragment slot="title">Consistent design language</Fragment>
          <Fragment slot="body">
            Spacing, typography, and color scales are shared between Figma and production code —
            what you design is what gets built.
          </Fragment>
          <ResponsiveImage
            imgPath="/static/images/home/figma-library-light.webp"
            alt="The Chassis component library in Figma, a cover for each component from App Icon to Form"
            classes="fluid w-100 visible-light shadow-lg"
            width={512}
            height={288}
          />
          <ResponsiveImage
            imgPath="/static/images/home/figma-library-dark.webp"
            alt="The Chassis component library in Figma, a cover for each component from App Icon to Form"
            classes="fluid w-100 visible-dark shadow-lg"
            width={512}
            height={288}
          />
        </FeatureCard>
      </FeatureSlider>
    </div>
    <div class="d-grid md:d-flex gap-md md:justify-content-center">
      <a href="/figma/" class="button primary lg">
        Go to Chassis Figma
      </a>
      <a href="/figma/docs/" class="button default lg">
        View Documentation
      </a>
    </div>
  </div>
</section>
