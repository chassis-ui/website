---
/**
 * Assets Section
 *
 * Homepage section showcasing Chassis asset distribution features.
 */

import FeatureCard from '@chassis-ui/docs/components/FeatureCard.astro'
import FeatureSlider from '@components/FeatureSlider.astro'
import Code from '@shortcodes/Code.astro'
---

<section id="assets-section" class="home-section py-3xlarge py-medium-6xlarge">
  <div class="container-2xlarge section-content">
    <div class="row mb-3xlarge mb-medium-6xlarge">
      <header class="section-header col col-large-10 col-2xlarge-8">
        <p class="fg-primary font-mass text-uppercase mb-xsmall">Chassis Assets</p>
        <h2 class="font-5xlarge mb-xsmall mb-medium-small mb-large-medium">
          <span class="font-normal d-block">Asset Management</span> for Multi-Brand Design
        </h2>
        <p class="font-lead m-0">
          Eliminate scattered assets and duplicated files. Chassis provides a single, structured
          source to store, manage, and distribute images, icons, and fonts across all your brands
          and platforms.
        </p>
      </header>
    </div>
    <div
      class="section-features gap-xlarge flex-column flex-medium-row mb-medium mb-medium-6xlarge"
    >
      <FeatureSlider>
        <!-- Item -->
        <FeatureCard icon="cx-number-one" classes="swiper-slide" horizontal>
          <Fragment slot="title">Store files</Fragment>
          <Fragment slot="body"
            >Organize brand- and app-specific assets in structured, predictable folders.
          </Fragment>
          <div class="pt-medium border-top border-subtle">
            <Code
              lang="text"
              code={`source/
├── default/
│   └── demo/
│       ├── Hero Img.png
│       └── Hero Img@2x.png
├── chassis/
│   └── demo/
│       └── Brand Logo.svg
└── example/
    └── demo/
        └── Brand Logo.svg`}
            />
          </div>
        </FeatureCard>
        <!-- Item -->
        <FeatureCard icon="cx-number-two" classes="swiper-slide" horizontal>
          <Fragment slot="title">Distribute assets</Fragment>
          <Fragment slot="body"
            >Automatically generate platform-optimized assets with a single script.
          </Fragment>
          <div class="pt-medium border-top border-subtle">
            <Code
              lang="sh"
              code={`# Build all platforms
pnpm assets

# Build specific brand
pnpm assets --brand chassis

# Build specific app
pnpm assets --app demo

# Build with filters
pnpm assets --brand chassis --app demo`}
            />
          </div>
        </FeatureCard>
        <!-- Item -->
        <FeatureCard icon="cx-number-three" classes="swiper-slide" horizontal>
          <Fragment slot="title">Ship confidently</Fragment>
          <Fragment slot="body"
            >Output is organised per platform and brand — correctly named and ready to use.
          </Fragment>
          <div class="pt-medium border-top border-subtle">
            <Code
              lang="text"
              code={`dist/
├── ios/demo/chassis/
│   ├── brand_logo.svg
│   ├── hero_img.png
│   └── hero_img@2x.png
└── android/demo/chassis/
    ├── drawable/
    │   ├── brand_logo.svg
    │   └── hero_img.png
    └── drawable_xhdpi/
        └── hero_img.png`}
            />
          </div>
        </FeatureCard>
      </FeatureSlider>
    </div>
    <div class="d-grid d-medium-flex gap-medium justify-content-medium-center">
      <a href="/assets/" class="button primary large">Go to Chassis Assets</a>
      <a href="/assets/docs/" class="button default large">View Documentation</a>
    </div>
  </div>
</section>
