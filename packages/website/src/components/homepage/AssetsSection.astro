---
/**
 * Assets Section
 *
 * Homepage section showcasing Chassis asset distribution features.
 */

import FeatureCard from '@chassis-ui/docs/components/FeatureCard.astro'
import FeatureSlider from '@components/FeatureSlider.astro'
import Code from '@chassis-ui/docs/shortcodes/Code.astro'
---

<section
  id="assets-section"
  class="home-section py-3xl md:py-6xl"
  aria-labelledby="assets-heading"
>
  <div class="container 2xl section-content">
    <div class="row mb-3xl md:mb-6xl">
      <header class="section-header col lg:col-10 2xl:col-8">
        <p class="fg-primary font-mass text-uppercase mb-xs">Chassis Assets</p>
        <h2 id="assets-heading" class="font-5xl mb-xs md:mb-sm lg:mb-md">
          <span class="font-normal d-block">Asset Management</span> for Multi-Brand Design
        </h2>
        <p class="font-lead m-0">
          Eliminate scattered assets and duplicated files. Chassis provides a single, structured
          source to store, manage, and distribute images, icons, and fonts across all your brands
          and platforms.
        </p>
      </header>
    </div>
    <div
      class="section-features gap-xl flex-column md:flex-row mb-md md:mb-6xl"
    >
      <FeatureSlider ariaLabel="Assets features carousel">
        <!-- Item -->
        <FeatureCard icon="cx-number-one" classes="swiper-slide" horizontal>
          <Fragment slot="title">Store files</Fragment>
          <Fragment slot="body"
            >Organize brand- and app-specific assets in structured, predictable folders.
          </Fragment>
          <div class="pt-md border-top border-subtle">
            <Code
              noToolbar
              lang="text"
              code={`source/
├── default/
│   └── demo/
│       ├── Hero Img.png
│       └── Hero Img@2x.png
├── chassis/
│   └── demo/
│       └── Brand Logo.svg
└── example/
    └── demo/
        └── Brand Logo.svg`}
            />
          </div>
        </FeatureCard>
        <!-- Item -->
        <FeatureCard icon="cx-number-two" classes="swiper-slide" horizontal>
          <Fragment slot="title">Distribute assets</Fragment>
          <Fragment slot="body"
            >Automatically generate platform-optimized assets with a single script.
          </Fragment>
          <div class="pt-md border-top border-subtle">
            <Code
              noToolbar
              lang="sh"
              code={`# Build all platforms
pnpm assets

# Build specific brand
pnpm assets --brand chassis

# Build specific app
pnpm assets --app demo

# Build with filters
pnpm assets --brand chassis --app demo`}
            />
          </div>
        </FeatureCard>
        <!-- Item -->
        <FeatureCard icon="cx-number-three" classes="swiper-slide" horizontal>
          <Fragment slot="title">Ship confidently</Fragment>
          <Fragment slot="body"
            >Output is organised per platform and brand — correctly named and ready to use.
          </Fragment>
          <div class="pt-md border-top border-subtle">
            <Code
              noToolbar
              lang="text"
              code={`dist/
├── ios/demo/chassis/
│   ├── brand_logo.svg
│   ├── hero_img.png
│   └── hero_img@2x.png
└── android/demo/chassis/
    ├── drawable/
    │   ├── brand_logo.svg
    │   └── hero_img.png
    └── drawable_xhdpi/
        └── hero_img.png`}
            />
          </div>
        </FeatureCard>
      </FeatureSlider>
    </div>
    <div class="d-grid md:d-flex gap-md md:justify-content-center">
      <a href="/assets/" class="button primary lg">Go to Chassis Assets</a>
      <a href="/assets/docs/" class="button default lg">View Documentation</a>
    </div>
  </div>
</section>
