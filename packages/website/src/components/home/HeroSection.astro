---
/**
 * Hero Section
 *
 * The claim of the home page, with its lead, the two actions, the licence line and the
 * illustration of one brand on web, iOS and Android, then the rail of the six packages. Each
 * station is one link to the home page of its package, so its name and its line enter as one;
 * its name takes the highlight colour on hover (`.home-rail-link`).
 *
 * The illustration is `images/illustrations/hero-home.svg` of the assets
 * (chassis-ui/website-assets). The hero inlines it, so that its three devices
 * (`.cxd-hero-part` in the file) can enter one by one.
 */

import Hero from '@chassis-ui/docs/sections/Hero.astro'
import RailItem from '@chassis-ui/docs/sections/RailItem.astro'
import Icon from '@chassis-ui/docs/shortcodes/Icon.astro'

const packages = [
  { name: 'Tokens', href: '/tokens/', body: 'Design decisions, themed per brand.' },
  { name: 'Figma', href: '/figma/', body: 'One library for all brands and platforms.' },
  { name: 'CSS', href: '/css/', body: 'Variables and classes with Figma’s names.' },
  { name: 'React', href: '/react/', body: 'Accessible components.' },
  { name: 'Assets', href: '/assets/', body: 'Logos, images and fonts per brand.' },
  { name: 'Icons', href: '/icons/', body: 'One set for design and code.' }
]
---

<Hero
  lead="Chassis is an open-source toolkit for teams that run several brands on web, iOS and Android. You make a design decision in one place and it reaches all of them."
  illustration="images/illustrations/hero-home.svg"
  illustrationLabel="One app in the same brand on the web, on iOS and on Android"
>
  <Fragment slot="title">
    <span class="d-block">Your design system, defined once.</span>{' '}
    <mark class="d-block">
      <span class="lg:d-block">Every brand and platform</span>{' '}
      <span class="lg:d-block">generated from it.</span>
    </mark>
  </Fragment>
  <Fragment slot="actions">
    <a class="button primary lg" href="#start">
      <Icon name="book-open-outline" />
      Getting Started
    </a>
    <a class="button alternate lg" href="https://github.com/chassis-ui">
      <Icon name="github-brand" />
      View on GitHub
    </a>
  </Fragment>
  <Fragment slot="meta">
    <span class="d-block sm:d-inline">Open source · MIT licensed</span>
    <span class="d-none sm:d-inline" aria-hidden="true">
      {' '}
      &nbsp;/&nbsp;{' '}
    </span>
    <span class="d-block sm:d-inline">Web · iOS · Android</span>
  </Fragment>
  <ul class="cxd-rail grid cxd-hero-rail" aria-label="The six packages">
    {packages.map((item) => (
      <RailItem class="col-span-6 md:col-span-4 lg:col-span-2 py-lg">
        <a class="vstack gap-xs home-rail-link" href={item.href}>
          <span class="font-title-sm">{item.name}</span>
          <span class="font-body-sm fg-subtle">{item.body}</span>
        </a>
      </RailItem>
    ))}
  </ul>
</Hero>
