---
/**
 * Switch Section
 *
 * One screen of the driver app, with a brand and a mode switch above it and the tokens of its
 * parts on redlines beside it. The brand switch puts the card under `previewBrandClass`, whose
 * CSS holds the tokens of the second brand (libs/brand-preview); the mode switch sets its
 * `data-cx-theme`. The token names stay as they are.
 *
 * From `lg` the tokens sit on lines either side of the card; below it the parts get numbers on
 * the edge of the card and the tokens are listed under it. A script places the lines and the
 * numbers on their parts (their `top`), as the parts move with the brand; without it the list is
 * shown.
 *
 * A switch runs in a view transition, where the browser has them and the visitor has not asked
 * for less motion: `is-switching` names the card and each line and number for it
 * (scss/_home-motion.scss).
 */

import { previewBrandClass } from '@libs/brand-preview'
import Section from '@chassis-ui/docs/sections/Section.astro'

interface Spec {
  /** The part of the card the number points at. */
  target: string
  /** The token on the left, and the part its line points at when it is not `target`. */
  start?: { token: string; target?: string }
  /** The token on the right. */
  end?: { token: string }
}

const specs: Spec[] = [
  { target: 'brand', end: { token: 'color/context/default/bg-even' } },
  {
    target: 'goal',
    start: { token: 'font/ui/small/strong', target: 'goal-head' },
    end: { token: 'color/context/default/bg-evident' }
  },
  {
    target: 'title',
    start: { token: 'font/context/title/medium' },
    end: { token: 'color/context/default/fg-main' }
  },
  {
    target: 'body',
    start: { token: 'font/context/body/medium' },
    end: { token: 'color/context/default/fg-subtle' }
  },
  { target: 'segments', start: { token: 'font/segment/medium' } },
  {
    target: 'input',
    start: { token: 'font/form-input/medium-text' },
    end: { token: 'borderRadius/form-input/medium' }
  },
  {
    target: 'button',
    start: { token: 'font/button/large' },
    end: { token: 'borderRadius/button/large' }
  }
]

const switches = [
  {
    name: 'brand',
    label: 'Brand',
    options: [
      { value: 'chassis', label: 'Chassis' },
      { value: 'preview', label: 'Your brand' }
    ]
  },
  {
    name: 'mode',
    label: 'Mode',
    options: [
      { value: 'light', label: 'Light' },
      { value: 'dark', label: 'Dark' }
    ]
  }
]
---

<Section
  id="switch"
  eyebrow="The switch"
  title={['A new brand is a setting,', 'not a project.']}
  lead="Pick a brand and a mode. The card changes, and the token names on the lines stay as they are."
>
  <div
    class="d-flex flex-column gap-5xl align-items-center"
    data-home-switch
    data-preview-class={previewBrandClass}
  >
    <div class="d-flex flex-wrap gap-3xl justify-content-center">
      {switches.map((group) => (
        <div class="d-flex flex-column md:flex-row gap-xs md:gap-sm md:align-items-center">
          <span class="font-code font-sm fg-subtle text-uppercase" id={`home-switch-${group.name}`}>
            {group.label}
          </span>
          <div class="nav nav-segments" role="group" aria-labelledby={`home-switch-${group.name}`}>
            {group.options.map((option, index) => (
              <button
                type="button"
                class:list={['nav-link', { active: index === 0 }]}
                aria-pressed={index === 0 ? 'true' : 'false'}
                data-home-switch-set={group.name}
                value={option.value}
              >
                {option.label}
              </button>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="home-switch-figure" data-home-switch-figure>
      <div
        class="home-switch-card font-ui fg-main bg-even border border-subtle rounded-md p-xl vstack gap-xl"
        data-cx-theme="light"
        data-home-switch-card
        inert
      >
        <p class="d-flex align-items-center gap-sm font-h6 m-0" data-spec="brand">
          <span class="home-switch-mark d-inline-block flex-shrink-0 bg-primary rounded-sm"></span>
          <span data-home-switch-name>Chassis</span>
        </p>
        <div class="vstack gap-xl">
          <div class="bg-evident rounded-md p-md vstack gap-sm" data-spec="goal">
            <div class="d-flex align-items-center justify-content-between" data-spec="goal-head">
              <span class="font-sm font-strong">Shift goal</span>
              <span class="font-label-sm fg-subtle">6 of 10</span>
            </div>
            <div
              class="progress"
              role="progressbar"
              aria-label="Shift goal"
              aria-valuenow="6"
              aria-valuemin="0"
              aria-valuemax="10"
            >
              <div class="progress-bar" style="width: 60%"></div>
            </div>
          </div>
          <div class="vstack gap-xs">
            <p class="font-title m-0" data-spec="title">
              Trip request
            </p>
            <p class="font-body fg-subtle m-0" data-spec="body">
              Pickup at Central Station, 4 min away. Drop-off at the airport, 28 min.
            </p>
          </div>
          <div class="nav nav-segments nav-justified" data-spec="segments">
            <span class="nav-link active">Now</span>
            <span class="nav-link">Scheduled</span>
          </div>
          <div class="form-field">
            <label class="form-label" for="home-switch-note">
              Note to rider
            </label>
            <input
              class="form-input"
              id="home-switch-note"
              type="text"
              placeholder="I’m in the grey van"
              data-spec="input"
            />
          </div>
          <button class="button primary lg w-100" type="button" data-spec="button">
            Accept trip
          </button>
        </div>
      </div>

      <div aria-hidden="true">
        {specs.map((spec) => (
          <>
            {spec.start && (
              <span class="home-spec start" data-spec-for={spec.start.target ?? spec.target}>
                <span class="home-spec-token">{spec.start.token}</span>
                <span class="home-spec-line"></span>
              </span>
            )}
            {spec.end && (
              <span class="home-spec end" data-spec-for={spec.target}>
                <span class="home-spec-line"></span>
                <span class="home-spec-token">{spec.end.token}</span>
              </span>
            )}
          </>
        ))}
        {specs.map((spec, index) => (
          <span class="home-spec-marker" data-spec-for={spec.target}>
            {index + 1}
          </span>
        ))}
      </div>
    </div>

    <ol
      class="home-spec-list bulletless d-flex flex-column gap-sm align-self-stretch m-0 font-code fg-subtle"
      aria-label="The tokens of the card"
    >
      {specs.map((spec, index) => (
        <li class="d-flex gap-xs align-items-start">
          <span class="home-spec-number" aria-hidden="true">
            {index + 1}
          </span>
          <span class="vstack">
            {spec.start && <span>{spec.start.token}</span>}
            {spec.end && <span>{spec.end.token}</span>}
          </span>
        </li>
      ))}
    </ol>
  </div>
</Section>

<script>
  // The brand and mode switches, and the place of each line and number on its part.
  for (const root of document.querySelectorAll<HTMLElement>('[data-home-switch]')) {
    const figure = root.querySelector<HTMLElement>('[data-home-switch-figure]')!
    const card = root.querySelector<HTMLElement>('[data-home-switch-card]')!
    const name = card.querySelector<HTMLElement>('[data-home-switch-name]')!
    const previewClass = root.dataset.previewClass!

    const place = () => {
      const top = figure.getBoundingClientRect().top

      for (const spec of figure.querySelectorAll<HTMLElement>('[data-spec-for]')) {
        const part = card.querySelector(`[data-spec="${spec.dataset.specFor}"]`)
        if (!part) continue
        const box = part.getBoundingClientRect()
        spec.style.top = `${box.top - top + box.height / 2}px`
      }
      figure.classList.add('is-placed')
    }

    const motion = window.matchMedia('(prefers-reduced-motion: no-preference)')
    let switches = 0

    const apply = (group: string, value: string) => {
      if (group === 'brand') {
        card.classList.toggle(previewClass, value === 'preview')
        name.textContent = value === 'preview' ? 'Your Brand' : 'Chassis'
      } else {
        card.dataset.cxTheme = value
      }
    }

    const set = (group: string, value: string) => {
      if (motion.matches && 'startViewTransition' in document) {
        const current = ++switches

        root.classList.add('is-switching')
        const transition = document.startViewTransition(async () => {
          apply(group, value)
          // The new state is the card in its fonts with the lines on its parts. The fonts of the
          // other brand load when the card first uses them: the layout asks for them, and the
          // transition waits for them, but not for long.
          void card.offsetHeight
          await Promise.race([
            document.fonts.ready,
            new Promise((resolve) => setTimeout(resolve, 300))
          ])
          place()
        })
        // A switch during a transition replaces it, and keeps the names.
        const done = () => {
          if (current === switches) root.classList.remove('is-switching')
        }
        transition.finished.then(done, done)
      } else {
        apply(group, value)
      }
      document.fonts.ready.then(place)
    }

    for (const button of root.querySelectorAll<HTMLButtonElement>('[data-home-switch-set]')) {
      button.addEventListener('click', () => {
        const group = button.dataset.homeSwitchSet!

        for (const other of root.querySelectorAll<HTMLButtonElement>(
          `[data-home-switch-set="${group}"]`
        )) {
          other.classList.toggle('active', other === button)
          other.setAttribute('aria-pressed', String(other === button))
        }
        set(group, button.value)
      })
    }

    new ResizeObserver(place).observe(card)
    document.fonts.ready.then(place)
  }
</script>
