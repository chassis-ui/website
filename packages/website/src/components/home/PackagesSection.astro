---
/**
 * Packages Section
 *
 * The six packages as cards, each a link to the home page of the package.
 */

import Cards from '@chassis-ui/docs/sections/Cards.astro'
import Section from '@chassis-ui/docs/sections/Section.astro'

const packages = [
  {
    name: 'Tokens',
    icon: 'cx-swatchbook',
    href: '/tokens/',
    body: 'Colors, type, spacing and motion as data, synced with Figma. Built into code for web, iOS and Android.'
  },
  {
    name: 'Figma',
    icon: 'cx-figma',
    href: '/figma/',
    body: 'The component library, bound to the tokens. Switch the brand or the color mode and the whole file follows.'
  },
  {
    name: 'CSS',
    icon: 'cx-brackets-curly',
    href: '/css/',
    body: 'Components and utility classes built on the tokens, named as in Figma. Works with any JavaScript framework, or none.'
  },
  {
    name: 'React',
    icon: 'cx-react',
    href: '/react/',
    body: 'Accessible, typed components built on React Aria and styled with Chassis CSS. A new brand needs no change to component code.'
  },
  {
    name: 'Assets',
    icon: 'cx-folder-tree',
    href: '/assets/',
    body: 'Builds each brand’s logos, images and fonts from the source into the names and formats of web, iOS and Android.'
  },
  {
    name: 'Icons',
    icon: 'cx-icons',
    href: '/icons/',
    body: 'Builds your SVG files into an icon font, a sprite and optimized SVGs. Adds an asset catalog for iOS and drawables for Android.'
  }
]
---

<Section
  id="packages"
  eyebrow="The packages"
  title={['Six versioned packages.', 'Adopt one, or the whole pipeline.']}
  lead="Take what you need. Together they carry a decision from the token file to the shipped app."
>
  <Cards cards={packages} />
</Section>
