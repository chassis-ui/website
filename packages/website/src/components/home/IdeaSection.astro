---
/**
 * Idea Section
 *
 * One dark panel with three rails, one stage word above each: Decide (base, brand,
 * app), Collect (images, icons, fonts) and Generate (web, iOS, Android). The rails draw in that
 * order when the panel scrolls into view.
 */

import Section from '@chassis-ui/docs/sections/Section.astro'
import Steps from '@chassis-ui/docs/sections/Steps.astro'

const stages = [
  {
    name: 'Decide',
    stations: [
      {
        label: 'Base',
        body: 'Color, type, spacing and motion each have a default, and each color its dark pair.'
      },
      {
        label: 'Brand',
        body: 'A brand overrides what differs: its colors, typefaces and corner radii.'
      },
      {
        label: 'App',
        body: 'An app starts from its brand and adds only what is its own.'
      }
    ]
  },
  {
    name: 'Collect',
    stations: [
      {
        label: 'Images',
        body: 'Logos, images and illustrations, exported from your design tool into the source.'
      },
      {
        label: 'Icons',
        body: 'Icons, exported from your design tool into the same source.'
      },
      {
        label: 'Fonts',
        body: 'Font files and licenses from a foundry or a service like Google Fonts, in the same source.'
      }
    ]
  },
  {
    name: 'Generate',
    stations: [
      {
        label: 'Web',
        body: 'CSS variables and classes, with images, fonts and icons named and formatted for the web.'
      },
      {
        label: 'iOS',
        body: 'Swift constants, with images, fonts and icons named and formatted for iOS.'
      },
      {
        label: 'Android',
        body: 'Android resources, with images, fonts and icons named and formatted for Android.'
      }
    ]
  }
]
---

<Section
  id="idea"
  eyebrow="The idea"
  title={['Change it once.', 'It changes everywhere.']}
  lead="A brand changes only the defaults it needs to, and an app adds only what is its own. Every platform is built from the same source."
>
  <Steps stages={stages} />
</Section>
