---
/**
 * Idea Section
 *
 * One dark panel with three rails, one stage word above each: Decide (base, brand,
 * application), Collect (the source) and Generate (web, iOS, Android). The rails draw in that
 * order when the panel scrolls into view.
 */

import Section from '@chassis-ui/docs/sections/Section.astro'
import Steps from '@chassis-ui/docs/sections/Steps.astro'

const stages = [
  {
    name: 'Decide',
    stations: [
      {
        label: 'Base',
        title: 'Everything has a default.',
        body: 'Colour, type, spacing and motion are defined once, each colour with its dark pair.'
      },
      {
        label: 'Brand',
        title: 'A brand overrides what differs.',
        body: 'Its colours, typefaces and corner style replace the defaults.'
      },
      {
        label: 'Application',
        title: 'Every app ships with its brand.',
        body: 'It adds only what is its own. Everything else comes from its brand and the base.'
      }
    ]
  },
  {
    name: 'Collect',
    stations: [
      {
        label: 'Source',
        body: 'Tokens, assets and icons each keep a single source for every brand and app. There is one place to look and one place to change.',
        wide: true
      }
    ]
  },
  {
    name: 'Generate',
    stations: [
      {
        label: 'Web',
        body: 'Variables and classes, optimized images in web formats, icons as a font or a sprite.'
      },
      {
        label: 'iOS',
        body: 'Swift constants, with images and fonts named and formatted for iOS.'
      },
      {
        label: 'Android',
        body: 'Android resources, with images and fonts named and formatted for Android.'
      }
    ]
  }
]
---

<Section
  id="idea"
  eyebrow="The idea"
  title={['Change it once.', 'It changes everywhere.']}
  lead="Decide in layers, from a shared base to each brand and app. Collect every decision in one source, and generate each platform from it."
>
  <Steps stages={stages} />
</Section>
