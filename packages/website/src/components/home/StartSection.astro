---
/**
 * Start Section
 *
 * Three cards of doors, each door a link to the documentation of a package. The hero's
 * "Get started" button scrolls here (`#start`).
 */

import Doors from '@chassis-ui/docs/sections/Doors.astro'
import Section from '@chassis-ui/docs/sections/Section.astro'

const groups = [
  {
    label: 'You own the decisions',
    doors: [
      {
        name: 'Tokens',
        href: '/tokens/docs/',
        body: 'Define color, type, spacing and motion for each brand.'
      },
      {
        name: 'Figma',
        href: '/figma/docs/',
        body: 'Design screens with components bound to the Chassis tokens.'
      }
    ]
  },
  {
    label: 'You own the files',
    doors: [
      {
        name: 'Assets',
        href: '/assets/docs/',
        body: 'Keep every brand’s logos, images and fonts in one source, built for each platform.'
      },
      {
        name: 'Icons',
        href: '/icons/docs/',
        body: 'Turn your SVG icons into a font, a sprite and files for iOS and Android.'
      }
    ]
  },
  {
    label: 'You own the code',
    doors: [
      {
        name: 'CSS',
        href: '/css/docs/',
        body: 'Build with components and utility classes, in Chassis styling until your tokens arrive.'
      },
      {
        name: 'React',
        href: '/react/docs/',
        body: 'Use accessible components built on React Aria, styled by Chassis CSS.'
      }
    ]
  }
]
---

<Section
  id="start"
  eyebrow="Get started"
  title={['Start from', 'where you are today.']}
  lead="Start with the package closest to your work. The others can follow when you need them."
>
  <Doors groups={groups} />
</Section>
