---
/**
 * Section Head
 *
 * The head of a home page section: the eyebrow over the title, then the lead, on the first
 * seven columns. The title has the section title style of the design (`.home-section-title`). The lines of the title break where the design breaks them from `lg`, and flow below.
 */

interface Props {
  /** The id of the title, for the `aria-labelledby` of the section. */
  id: string
  /** The short line above the title. */
  eyebrow: string
  /** The lines of the title. */
  title: string[]
  /** The paragraph under the title. */
  lead: string
}

const { id, eyebrow, title, lead } = Astro.props
---

<div class="grid">
  <div class="col-span-full lg:col-span-7 vstack gap-lg">
    <div class="vstack gap-xs">
      <p class="font-label-lg fg-highlight m-0">{eyebrow}</p>
      <h2 class="home-section-title" id={id}>
        {title.map((line, index) => (
          <>
            {index > 0 && ' '}
            <span class="lg:d-block">{line}</span>
          </>
        ))}
      </h2>
    </div>
    <p class="font-body-lg m-0">{lead}</p>
  </div>
</div>
