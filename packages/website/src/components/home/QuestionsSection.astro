---
/**
 * Questions Section
 *
 * The questions teams ask before adopting, as a flush accordion on seven columns, and the
 * contact form on the last five, for a question that is not there. The form posts to
 * `/api/contact/` (see `api/contact.ts`), which drops a message whose honeypot field,
 * `website`, is filled.
 */

import Section from '@chassis-ui/docs/sections/Section.astro'

const questions = [
  [
    'Can we adopt only part of it?',
    'Yes. Each package works alone. Start with one and add the others when you need them.'
  ],
  [
    'Which platforms does it cover?',
    'Web, iOS and Android. Tokens, assets and icons are built for all three. The CSS and the React components are for the web.'
  ],
  [
    'Which frameworks does it work with?',
    'Any. The CSS is plain classes and variables, so it works in every framework, and with Tailwind CSS v4. React also has a component library.'
  ],
  [
    'Can we use the tokens without Chassis CSS?',
    'Yes. The tokens are also built as plain Sass variables, which any CSS setup can use. On iOS and Android they are Swift constants and Android resources.'
  ],
  [
    'Is it only for large companies?',
    'No. It pays off from the second brand or the second platform, at any team size.'
  ],
  [
    'How do we add a brand?',
    'Add the brand’s token values and its logos, images and fonts, then run the build. Nothing in the components changes.'
  ],
  [
    'How do we get updates?',
    'Each package has version numbers. You update it like any other dependency, when you choose to.'
  ],
  [
    'Does it work with AI agents?',
    'Yes. Chassis publishes skills for AI agents. With them an agent can build a Figma design from the library, turn it into code and add a brand.'
  ],
  [
    'Is it free to use?',
    'Yes. Every package is open source under the MIT license, which allows commercial use.'
  ]
]
---

<Section
  id="questions"
  eyebrow="Questions"
  title={['Short answers', 'before you adopt.']}
  lead="Adopting a system is a commitment, so ask first. If your question is not here, send it to us and we will write back."
>
  <div class="grid row-gap-6xl align-items-start">
    <div class="col-span-full lg:col-span-7 accordion flush lg" data-cx-accordion>
      {questions.map(([question, answer], index) => (
        <details name="home-questions" open={index === 0}>
          <summary>
            <h3 class="accordion-title">{question}</h3>
          </summary>
          <div class="accordion-body">
            <p class="m-0">{answer}</p>
          </div>
        </details>
      ))}
    </div>
    <div class="col-span-full lg:col-span-5 lg:col-start-8">
      <form
        id="support-form"
        class="bg-even rounded-xl p-3xl vstack gap-lg"
        novalidate
        aria-label="Contact form"
      >
        <!-- Honeypot: hidden from real users, bots fill it -->
        <input
          type="text"
          name="website"
          class="visually-hidden"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
        />
        <div class="form-field">
          <label for="nameInput" class="form-label">
            Name <span aria-hidden="true">*</span>
          </label>
          <input
            type="text"
            class="form-input"
            id="nameInput"
            name="name"
            maxlength="100"
            required
            autocomplete="name"
          />
        </div>
        <div class="form-field">
          <label for="emailInput" class="form-label">
            Email <span aria-hidden="true">*</span>
          </label>
          <input
            type="email"
            class="form-input"
            id="emailInput"
            name="email"
            maxlength="254"
            placeholder="you@company.com"
            required
            autocomplete="email"
          />
        </div>
        <div class="form-field">
          <label for="companyInput" class="form-label">
            Company
          </label>
          <input
            type="text"
            class="form-input"
            id="companyInput"
            name="company"
            maxlength="100"
            autocomplete="organization"
          />
        </div>
        <div class="form-field">
          <label for="topicSelect" class="form-label">
            Topic <span aria-hidden="true">*</span>
          </label>
          <select class="form-input" id="topicSelect" name="topic" required>
            <option value="">Choose a topic</option>
            <option value="setting-up-chassis">Setting up Chassis</option>
            <option value="design-system-architecture">Design system architecture</option>
            <option value="figma-components">Figma components</option>
            <option value="token-integration">Token integration</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div class="form-field">
          <label for="messageInput" class="form-label">
            Message
          </label>
          <textarea class="form-input" id="messageInput" name="message" rows="4" maxlength="2000" />
        </div>
        <div
          id="support-form-message"
          role="alert"
          aria-live="polite"
          class="notification"
          hidden
        ></div>
        <div class="d-flex flex-column md:flex-row md:align-items-center justify-content-between gap-md">
          <p class="font-body-sm fg-subtle m-0">
            <a class="home-form-note" href="/privacy/">
              We use your details only to answer you.
            </a>
          </p>
          <button type="submit" class="button primary">
            Send
          </button>
        </div>
      </form>
    </div>
  </div>
</Section>

<script>
  const form = document.querySelector<HTMLFormElement>('#support-form')

  form?.addEventListener('submit', async (e) => {
    e.preventDefault()

    const button = form.querySelector<HTMLButtonElement>('[type="submit"]')!
    const messageEl = document.querySelector<HTMLElement>('#support-form-message')!

    // Reset state
    messageEl.hidden = true
    messageEl.textContent = ''
    messageEl.className = 'notification'

    // Client-side validation
    if (!form.checkValidity()) {
      form.reportValidity()
      return
    }

    button.disabled = true
    const originalText = button.textContent
    button.textContent = 'Sending…'

    let response: Response | undefined
    try {
      response = await fetch('/api/contact/', {
        method: 'POST',
        body: new FormData(form)
      })
    } catch {
      messageEl.textContent = 'Network error. Please check your connection and try again.'
      messageEl.classList.add('danger')
      button.disabled = false
      button.textContent = originalText
      messageEl.hidden = false
      return
    }

    let json: { ok?: boolean; error?: string } | undefined
    try {
      json = (await response.json()) as { ok?: boolean; error?: string }
    } catch {
      // API returned non-JSON (e.g. HTML error page)
    }

    if (response.ok && json?.ok) {
      form.reset()
      messageEl.textContent = 'Thank you. We will write back soon.'
      messageEl.classList.add('success')
    } else {
      messageEl.textContent =
        response.status === 429
          ? 'Too many messages from your network. Please wait a few minutes and try again.'
          : (json?.error ?? `Something went wrong (${response.status}). Please try again.`)
      messageEl.classList.add('danger')
      button.disabled = false
      button.textContent = originalText
    }

    messageEl.hidden = false
  })
</script>
