---
/**
 * Questions Section
 *
 * The questions teams ask before adopting, as a flush accordion on seven columns, and the
 * contact form on the last five, for a question that is not there. The form posts to
 * `/api/contact/` (see `api/contact.ts`), which drops a message whose honeypot field,
 * `website`, is filled.
 */

import SectionHead from './SectionHead.astro'

const questions = [
  [
    'Can we adopt only part of it?',
    'Yes. Each package works on its own. Start with the tokens or the Figma library and add the rest when you need it.'
  ],
  [
    'Which platforms does it cover?',
    'Web, iOS and Android. Figma gets the decisions as variables.'
  ],
  [
    'Which frameworks does it work with?',
    'The CSS works with any framework. The React components are built on React Aria. Other stacks use the CSS directly.'
  ],
  [
    'Is it only for large companies?',
    'No. It pays off from the second brand or the second platform, at any team size.'
  ],
  [
    'Does it work with AI agents?',
    'Yes. Public agent skills let an agent build Figma designs from the library, turn them into Chassis markup and add a brand.'
  ]
]
---

<section class="home-section" aria-labelledby="home-questions-title">
  <div class="container 2xl home-section-body">
    <SectionHead
      id="home-questions-title"
      eyebrow="BEFORE YOU ADOPT"
      title={['Questions teams ask before', 'adopting.']}
      lead="Short answers on platforms, frameworks, team size and licensing. If yours is not here, tell us what you work with."
    />
    <div class="grid row-gap-6xl align-items-start">
      <div class="col-span-full lg:col-span-7 accordion flush lg" data-cx-accordion>
        {questions.map(([question, answer], index) => (
          <details name="home-questions" open={index === 0}>
            <summary>
              <h3 class="accordion-title">{question}</h3>
            </summary>
            <div class="accordion-body">
              <p class="m-0">{answer}</p>
            </div>
          </details>
        ))}
      </div>
      <div class="col-span-full lg:col-span-5 lg:col-start-8">
        <form
          id="support-form"
          class="bg-even rounded-xl p-3xl vstack gap-lg"
          novalidate
          aria-label="Contact form"
        >
          <!-- Honeypot: hidden from real users, bots fill it -->
          <input
            type="text"
            name="website"
            class="visually-hidden"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
          />
          <div class="form-field">
            <label for="nameInput" class="form-label">
              Name <span aria-hidden="true">*</span>
            </label>
            <input
              type="text"
              class="form-input"
              id="nameInput"
              name="name"
              maxlength="100"
              placeholder="Your name"
              required
              autocomplete="name"
            />
          </div>
          <div class="form-field">
            <label for="emailInput" class="form-label">
              Email <span aria-hidden="true">*</span>
            </label>
            <input
              type="email"
              class="form-input"
              id="emailInput"
              name="email"
              maxlength="254"
              placeholder="you@company.com"
              required
              autocomplete="email"
            />
          </div>
          <div class="form-field">
            <label for="companyInput" class="form-label">
              Company
            </label>
            <input
              type="text"
              class="form-input"
              id="companyInput"
              name="company"
              maxlength="100"
              placeholder="Company name"
              autocomplete="organization"
            />
          </div>
          <div class="form-field">
            <label for="topicSelect" class="form-label">
              Topic <span aria-hidden="true">*</span>
            </label>
            <select class="form-input" id="topicSelect" name="topic" required>
              <option value="">Choose an option</option>
              <option value="setting-up-chassis">Setting up Chassis</option>
              <option value="design-system-architecture">Design System Architecture</option>
              <option value="figma-components">Figma Components</option>
              <option value="token-integration">Token Integration</option>
              <option value="other">Other</option>
            </select>
          </div>
          <div
            id="support-form-message"
            role="alert"
            aria-live="polite"
            class="notification"
            hidden
          ></div>
          <div class="d-flex flex-column md:flex-row md:align-items-center justify-content-between gap-md">
            <p class="font-body-sm fg-subtle m-0">
              <a class="home-form-note" href="/privacy/">
                We use your details only to answer you.
              </a>
            </p>
            <button type="submit" class="button primary">
              Submit
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('#support-form')

  form?.addEventListener('submit', async (e) => {
    e.preventDefault()

    const button = form.querySelector<HTMLButtonElement>('[type="submit"]')!
    const messageEl = document.querySelector<HTMLElement>('#support-form-message')!

    // Reset state
    messageEl.hidden = true
    messageEl.textContent = ''
    messageEl.className = 'notification'

    // Client-side validation
    if (!form.checkValidity()) {
      form.reportValidity()
      return
    }

    button.disabled = true
    const originalText = button.textContent
    button.textContent = 'Sending…'

    let response: Response | undefined
    try {
      response = await fetch('/api/contact/', {
        method: 'POST',
        body: new FormData(form)
      })
    } catch {
      messageEl.textContent = 'Network error. Please check your connection and try again.'
      messageEl.classList.add('danger')
      button.disabled = false
      button.textContent = originalText
      messageEl.hidden = false
      return
    }

    let json: { ok?: boolean; error?: string } | undefined
    try {
      json = (await response.json()) as { ok?: boolean; error?: string }
    } catch {
      // API returned non-JSON (e.g. HTML error page)
    }

    if (response.ok && json?.ok) {
      form.reset()
      messageEl.textContent = "Thank you! We'll be in touch soon."
      messageEl.classList.add('success')
    } else {
      messageEl.textContent =
        response.status === 429
          ? 'Too many messages from your network. Please wait a few minutes and try again.'
          : (json?.error ?? `Something went wrong (${response.status}). Please try again.`)
      messageEl.classList.add('danger')
      button.disabled = false
      button.textContent = originalText
    }

    messageEl.hidden = false
  })
</script>
