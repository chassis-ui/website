---
/**
 * Problem Section
 *
 * Five numbered pains on hairline rows: a statement and its consequence. Each row plays when it
 * scrolls into view: it slides in from the right as one (scss/_home-motion.scss).
 */

import Section from '@chassis-ui/docs/sections/Section.astro'

const pains = [
  ['A token changed in Figma.', 'Three codebases did not.'],
  ['The web has tokens.', 'iOS and Android have raw values.'],
  ['Brand B is a fork of brand A.', 'Nobody dares to pull updates.'],
  ['Custom icon required.', 'Four names for the same icon.'],
  ['Dark mode came later.', 'By hand, once per platform.']
]
---

<Section
  id="problem"
  eyebrow="The problem"
  title={['Design systems assume', 'one brand, one platform.']}
  lead="Real products are a passenger app, a driver app and an ops console, each on a different stack and platform, expected to feel like one. Chassis is for what happens then."
>
  <ol class="bulletless m-0 border-bottom border-subtle">
    {pains.map(([statement, consequence], index) => (
      <li
        class="grid row-gap-xs md:row-gap-md py-xl md:py-3xl border-top border-subtle"
        data-reveal="row"
      >
        <span
          class="col-span-full md:col-span-1 font-code font-xl fg-primary md:mt-2xs lg:mt-0 lg:align-self-center"
          aria-hidden="true"
        >
          {String(index + 1).padStart(2, '0')}
        </span>
        <p class="col-span-full md:col-span-11 home-problem-statement m-0">
          {statement}{' '}
          <span class="d-block lg:d-inline mt-2xs md:mt-0 fg-subtle">{consequence}</span>
        </p>
      </li>
    ))}
  </ol>
</Section>
