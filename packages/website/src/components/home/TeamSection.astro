---
/**
 * Team Section
 *
 * What changes for design, engineering and product: one hairline row per role, the claim on
 * the left and three points on the right.
 */

import Rows from '@chassis-ui/docs/sections/Rows.astro'
import Section from '@chassis-ui/docs/sections/Section.astro'

const roles = [
  {
    label: 'Design',
    title: 'Use the same component for every brand.',
    points: [
      'Switch the variable mode to see another brand or dark mode. No second file to keep up.',
      'Each component has a documentation page beside it in the library.',
      'The names you see in Figma are the names developers use.'
    ]
  },
  {
    label: 'Engineering',
    title: 'Install the tokens like any dependency.',
    points: [
      'A design change is a version bump, reviewed in a pull request.',
      'Web, iOS and Android build from the published tokens. No colour files kept by hand.',
      'Classes and variables match the Figma names, so a design is readable without a redline.'
    ]
  },
  {
    label: 'Product',
    title: 'Launch a brand without a rebuild.',
    points: [
      'A fix to a component lands in all brands and on all platforms at once.',
      'A brand ships with light and dark mode from its first release, with no extra work.',
      'The web, iOS and Android apps release from one set of decisions, so they stay in step.'
    ]
  }
]
---

<Section
  id="team"
  eyebrow="For the team"
  title={['What changes for each part of', 'the team.']}
  lead="One change in the tokens means something different at each desk. Here is what a designer, an engineer and a product owner get from it."
>
  <Rows rows={roles} />
</Section>
