---
/**
 * Team Section
 *
 * What changes for design, engineering and product: one hairline row per role, the claim on
 * the left and three points on the right.
 */

import Rows from '@chassis-ui/docs/sections/Rows.astro'
import Section from '@chassis-ui/docs/sections/Section.astro'

const roles = [
  {
    label: 'Design',
    title: 'Use the same component for every brand.',
    points: [
      'Switch the variable mode to see another brand or dark mode. No second file to maintain.',
      'Each component has a documentation page beside it in the library.',
      'The names you see in Figma are the names developers use.'
    ]
  },
  {
    label: 'Engineering',
    title: 'Install the tokens like any dependency.',
    points: [
      'A design change is a version bump, reviewed in a pull request.',
      'Web, iOS and Android build from the published tokens. No values copied by hand.',
      'Classes and variables match the Figma names, so a design is readable without a spec.'
    ]
  },
  {
    label: 'Product',
    title: 'Ship a feature to every brand at once.',
    points: [
      'A fix to a token reaches every brand and platform with the next release.',
      'A new product or feature has dark mode from its first release.',
      'The web, iOS and Android apps release from the same decisions, so they stay in step.'
    ]
  }
]
---

<Section
  id="team"
  eyebrow="For the team"
  title={['One change.', 'Less work at every desk.']}
  lead="The whole team works in a shared language, from Figma to code. A change ships as a new version, and nobody has to pass it along."
>
  <Rows rows={roles} />
</Section>
