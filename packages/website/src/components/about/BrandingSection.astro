---
/**
 * Branding Section
 *
 * About page section highlighting the Chassis logo and icon, with download links for use in articles, talks, and other references.
 */
---

<section class="py-3xl md:py-6xl">
  <div class="container 2xl">
    <div class="row g-md lg:g-3xl">
      <header class="col-12 lg:col-6">
        <h2>Branding</h2>
        <p class="font-lg">
          Use the Chassis logo and icon when you reference the project — in articles, talks, or
          slides. Please don't modify the marks or place them in a way that implies official
          endorsement of your work. Click any mark below to download the SVG.
        </p>
      </header>
      <div class="col-12 lg:col-6 lg:pt-6xl">
        <div class="row g-md">
          <div class="col-auto">
            <a href="/static/images/logo/chassis-logo-white-banner.svg" download class="d-flex">
              <img
                src="/static/images/logo/chassis-logo-white-banner.svg"
                alt="Chassis logo"
                class="object-fit-cover border border-subtle rounded"
                height="160"
              />
            </a>
          </div>
          <div class="col-auto">
            <a href="/static/images/logo/chassis-icon-white-banner.svg" download class="d-flex">
              <img
                src="/static/images/logo/chassis-icon-white-banner.svg"
                alt="Chassis icon"
                class="object-fit-cover border border-subtle rounded"
                height="160"
              />
            </a>
          </div>
          <div class="col-auto">
            <a href="/static/images/logo/chassis-logo-brand-banner.svg" download class="d-flex">
              <img
                src="/static/images/logo/chassis-logo-brand-banner.svg"
                alt="Chassis logo"
                class="object-fit-cover border border-subtle rounded"
                height="160"
              />
            </a>
          </div>
          <div class="col-auto">
            <a href="/static/images/logo/chassis-icon-brand-banner.svg" download class="d-flex">
              <img
                src="/static/images/logo/chassis-icon-brand-banner.svg"
                alt="Chassis icon"
                class="object-fit-cover border border-subtle rounded"
                height="160"
              />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
