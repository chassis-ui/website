---
/**
 * Contribute Section
 *
 * About page section highlighting how to contribute to Chassis, with links to GitHub repositories and contribution guidelines.
 */

const repos = [
  { name: 'chassis-tokens', description: 'Design tokens & transformers' },
  { name: 'chassis-css', description: 'CSS framework' },
  { name: 'chassis-figma', description: 'Figma component library' },
  { name: 'chassis-icons', description: 'Icon library & sprites' },
  { name: 'chassis-assets', description: 'Asset distribution' },
  { name: 'chassis-website', description: 'This site & shared docs' },
]
---

<section id="contribute" class="py-3xlarge py-medium-6xlarge">
  <div class="container-2xlarge">
    <div class="row g-medium g-large-3xlarge">
      <div class="col-12 col-large-6">
        <h2>Contribute</h2>
        <p class="font-large mb-xlarge">
          Chassis is shaped by the people using it. File an issue when something is broken,
          missing, or unclear. Pull requests are welcome for typos, docs, and small fixes —
          for anything larger, start with an issue so we can agree on the approach before you
          write the code.
        </p>
        <a
          href="https://github.com/chassis-ui"
          class="button default"
          target="_blank"
          rel="noopener noreferrer"
        >
          Browse repositories
        </a>
      </div>
      <div class="col-12 col-large-6 pt-large-6xlarge">
        <ul class="list-group">
          {repos.map((repo) => (
            <li class="list-item">
              <a
                href={`https://github.com/chassis-ui/${repo.name}`}
                class="text-decoration-none d-flex align-items-center gap-medium"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg class="icon icon-xlarge icon-default" aria-hidden="true">
                  <use href="#github-brand"></use>
                </svg>
                <div>
                  <p class="font-code font-strong m-0">{repo.name}</p>
                  <p class="fg-subtle font-small m-0">{repo.description}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
