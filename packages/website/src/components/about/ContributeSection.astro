---
/**
 * Contribute Section
 *
 * About page section highlighting how to contribute to Chassis, with links to GitHub repositories and contribution guidelines.
 */

const repos = [
  { name: 'chassis-tokens', repo: 'tokens', description: 'Design tokens & transformers' },
  { name: 'chassis-css', repo: 'css', description: 'CSS framework' },
  { name: 'chassis-react', repo: 'react', description: 'React components' },
  { name: 'chassis-figma', repo: 'figma', description: 'Figma component library' },
  { name: 'chassis-icons', repo: 'icons', description: 'Icon library & sprites' },
  { name: 'chassis-assets', repo: 'assets', description: 'Asset distribution' },
  { name: 'chassis-website', repo: 'website', description: 'This site & shared docs' }
]
---

<section id="contribute" class="py-3xl md:py-6xl">
  <div class="container 2xl">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-md lg:gap-3xl">
      <div>
        <h2>Contribute</h2>
        <p class="font-lg mb-xl">
          Chassis is shaped by the people using it. File an issue when something is broken, missing,
          or unclear. Pull requests are welcome for typos, docs, and small fixes — for anything
          larger, start with an issue so we can agree on the approach before you write the code.
        </p>
        <a
          href="https://github.com/chassis-ui"
          class="button default"
          target="_blank"
          rel="noopener noreferrer"
        >
          Browse repositories
        </a>
      </div>
      <div class="lg:pt-6xl">
        <ul class="list-group">
          {repos.map((repo) => (
            <li class="list-item">
              <a
                href={`https://github.com/chassis-ui/${repo.repo}`}
                class="text-decoration-none d-flex align-items-center gap-md"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg class="icon icon-xl icon-default" aria-hidden="true">
                  <use href="#github-brand" />
                </svg>
                <div>
                  <p class="font-code font-strong m-0">{repo.name}</p>
                  <p class="fg-subtle font-sm m-0">{repo.description}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
