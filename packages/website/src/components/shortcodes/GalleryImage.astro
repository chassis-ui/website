---
/**
 * Responsive Image
 *
 * Render a sm/lg viewport pair, each with 1x and 2x density variants.
 * The sm tier swaps in below the `sm` breakpoint (576px) from
 * @chassis-ui/css so narrow viewports don't download the lg-tier image.
 */

interface Props {
  /** Path to the lg-tier image file (sm tier is derived: `-sm` suffix) */
  imgPath: string
  /** Alternative text for the image */
  alt: string
  /** Additional CSS classes */
  classes?: string
  /** Enable lazy loading */
  lazyload?: boolean
  /** Image width in pixels */
  width?: number
  /** Image height in pixels */
  height?: number
  /** Any other attribute is passed through to the rendered element. */
  [key: string]: unknown
}

const { imgPath, alt, classes = '', lazyload = true, width, height, ...rest } = Astro.props

const classNames = ['image', classes].filter(Boolean).join(' ')

const basePath = imgPath.split('/').slice(0, -1).join('/')
const basename = imgPath.split('/').pop()?.split('.')[0] || ''
const ext = imgPath.includes('.') ? `.${imgPath.split('.').pop()}` : ''

const imgPathLarge1x = `${basePath}/${basename}${ext}`
const imgPathLarge2x = `${basePath}/${basename}@2x${ext}`
const imgPathSmall1x = `${basePath}/${basename}-sm${ext}`
const imgPathSmall2x = `${basePath}/${basename}-sm@2x${ext}`

// Matches the `sm` breakpoint in @chassis-ui/css (576px).
const smBreakpoint = '(max-width: 575px)'
---

<picture>
  <source media={smBreakpoint} srcset={`${imgPathSmall1x}, ${imgPathSmall2x} 2x`} />
  <img
    class={classNames}
    srcset={`${imgPathLarge1x}, ${imgPathLarge2x} 2x`}
    src={imgPathLarge1x}
    alt={alt}
    loading={lazyload ? 'lazy' : undefined}
    width={width}
    height={height}
    {...rest}
  />
</picture>
