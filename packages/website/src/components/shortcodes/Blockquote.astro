---
/**
 * Blockquote
 *
 * Render a blockquote with optional attribution.
 */

interface Props {
  /** Attribution text or HTML for the quote */
  attr?: String
}

const { attr } = Astro.props
---

{
  attr ? (
    <figure>
      <blockquote class="blockquote">
        <p>
          <slot />
        </p>
      </blockquote>
      <figcaption class="attribution">
        <Fragment set:html={attr} />
      </figcaption>
    </figure>
  ) : (
    <blockquote class="blockquote">
      <p>
        <slot />
      </p>
    </blockquote>
  )
}
