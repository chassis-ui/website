---
type Props = {
  posts: any
  currentPostId?: string
}

const { posts, currentPostId } = Astro.props

function getBlogPostUrl(post: any): string {
  const pubDate = new Date(post.data.pubDate || Date.now())
  const year = pubDate.getFullYear()
  const month = String(pubDate.getMonth() + 1).padStart(2, '0')
  const day = String(pubDate.getDate()).padStart(2, '0')

  // Extract slug from the file path (remove year folder and extension)
  const slug = post.id.replace(/^\d{4}\//, '').replace(/\.(md|mdx)$/, '')

  return `/blog/${year}/${month}/${day}/${slug}`
}
---

<div class="bg-even p-medium rounded-large mb-medium">
  <h4>Latest Posts</h4>
  <ul class="list-group list-plain">
    {
      posts
        .filter((post: any) => post.id !== currentPostId) // Exclude current post
        .filter((post: any) => post.data.pubDate) // Only posts with dates
        .sort(
          (a: any, b: any) =>
            new Date(b.data.pubDate!).getTime() - new Date(a.data.pubDate!).getTime()
        )
        .slice(0, 5) // Show latest 5 posts
        .map((post: any) => (
          <li class="list-item bg-even py-small">
            <a href={getBlogPostUrl(post)} class="fg-main text-decoration-none">
              <article>
                <h5 class="font-medium mb-0">{post.data.title}</h5>
                <time datetime={post.data.pubDate!.toISOString()}>
                  {post.data.pubDate!.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                  })}
                </time>
              </article>
            </a>
          </li>
        ))
    }
  </ul>
</div>
