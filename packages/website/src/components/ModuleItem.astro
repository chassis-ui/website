---
const { icon, title, url } = Astro.props
---

<div class="module-item col">
  <a
    href={url}
    class="d-flex button p-medium p-large-xlarge gap-xlarge gap-large-small flex-medium-column justify-content-start justify-content-large-center h-100"
  >
    <svg class="icon icon-3xlarge icon-medium-4xlarge"><use href={`#${icon}`}></use></svg>
    <p class="font-strong font-medium font-large-large m-0">{title}</p>
  </a>
</div>
