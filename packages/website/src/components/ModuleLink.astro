---
/**
 * Module Item
 *
 * Display a module link with icon and title for the hero section.
 */

interface Props {
  /** Icon identifier from the icon sprite */
  icon: string
  /** Module title text */
  title: string
  /** URL destination for the module */
  url: string
}

const { icon, title, url } = Astro.props
---

<li class="module-item col">
  <a
    href={url}
    class="d-flex button p-md lg:p-xl gap-md lg:gap-sm md:flex-column justify-content-start lg:justify-content-center my-2xs md:m-0 h-100"
  >
    <svg class="icon icon-2xl md:icon-4xl"><use href={`#${icon}`}></use></svg>
    <p class="font-strong font-lg m-0">{title}</p>
  </a>
</li>
