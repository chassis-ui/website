---
/**
 * Module Item
 *
 * Display a module link with icon and title for the hero section.
 */

interface Props {
  /** Icon identifier from the icon sprite */
  icon: string
  /** Module title text */
  title: string
  /** URL destination for the module */
  url: string
}

const { icon, title, url } = Astro.props
---

<div class="module-item col">
  <a
    href={url}
    class="d-flex button p-medium large:p-xlarge gap-medium large:gap-small medium:flex-column justify-content-start large:justify-content-center m-xsmall medium:my-0 h-100"
  >
    <svg class="icon icon-2xlarge medium:icon-4xlarge"><use href={`#${icon}`}></use></svg>
    <p class="font-strong font-large m-0">{title}</p>
  </a>
</div>
