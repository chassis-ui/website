---
import type { MarkdownHeading } from 'astro'
import type { CollectionEntry } from 'astro:content'
import BaseLayout from '@chassis-ui/docs/layouts/BaseLayout.astro'
import PageHero from '@components/PageHero.astro'
import { blogPages } from '@libs/content'
import { tagsToArray } from '@libs/blog'
import '@scss/blog.scss'

interface Props {
  frontmatter?: {
    title?: string
    description?: string
  }
  headings?: MarkdownHeading[]
  id?: CollectionEntry<'blog'>['id']
}

const { frontmatter } = Astro.props

const title = frontmatter?.title ?? 'Blog'
const description =
  frontmatter?.description ??
  'Insights, tutorials and stories from the designers and developers of Chassis, building design systems in the open.'

const tagCounts = new Map<string, number>()
blogPages.forEach((post: CollectionEntry<'blog'>) => {
  tagsToArray(post.data.tags).forEach((tag) => {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1)
  })
})
const popularTags = Array.from(tagCounts.entries())
  .sort((a, b) => b[1] - a[1])
  .slice(0, 5)
  .map(([tag]) => tag)
const plural = (count: number, word: string) => `${count} ${word}${count === 1 ? '' : 's'}`
const meta = `${plural(blogPages.length, 'post')}  ·  ${plural(tagCounts.size, 'tag')}`
---

<BaseLayout
  {...Astro.props}
  title={title}
  description={description}
  layout="blog"
  navbarContext="alternate"
>
  <Fragment slot="main">
    <main id="content">
      <PageHero title={title} lead={description} meta={meta}>
        {Astro.slots.has('breadcrumb') && (
          <nav aria-label="Breadcrumb" slot="breadcrumb">
            <slot name="breadcrumb" />
          </nav>
        )}
        <div class="bg-main border border-subtle rounded-md p-xl vstack gap-xl" slot="aside">
          <p class="d-flex align-items-baseline justify-content-between gap-xs m-0">
            <span class="font-title-sm fg-main">Popular Tags</span>
            <a href="/blog/tags/" class="text-decoration-none">
              View all tags
            </a>
          </p>
          <ul class="bulletless m-0 d-flex flex-wrap gap-md">
            {popularTags.map((tag) => (
              <li>
                <a href={`/blog/tags/${encodeURIComponent(tag)}/`} class="chip primary smooth">
                  {tag}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </PageHero>
      <div class="container 2xl page-section">
        <slot />
      </div>
    </main>
  </Fragment>
</BaseLayout>
