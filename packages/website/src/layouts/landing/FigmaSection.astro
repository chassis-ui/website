---
import ResponsiveImage from '@chassis-ui/docs/components/ResponsiveImage.astro'
import FeatureItem from '@components/FeatureItem.astro'
---

<section id="figma-section" class="home-section">
  <div class="section-content">
    <div class="section-main">
      <article class="section-intro">
        <p class="section-label fg-primary">Chassis Figma Library</p>
        <h2 class="section-title">
          <span class="font-normal d-block">Design with tokens,</span> not guesswork.
        </h2>
        <p class="section-body">
          Most Figma libraries start well and drift quickly. Colors get hard-coded. Spacing
          becomes inconsistent. Components fall out of sync with what engineering actually ships.
          The Chassis Figma library is built directly on the token system, so what designers see
          is what developers get — and stays that way.
        </p>
      </article>
      <div class="features">
        <FeatureItem
          icon="home-swatchbook"
          title={`<span class="font-normal d-block">Token-driven</span> components`}
          body="Every color, spacing value, and type style in the library comes from the token system — not manual overrides."
        />
        <FeatureItem
          icon="home-font-case"
          title={`<span class="font-normal d-block">Consistent</span> design language`}
          body="Spacing, typography, and color scales match exactly across Figma and production code."
        />
        <FeatureItem
          icon="home-ruler"
          title={`<span class="font-normal d-block">Scalable</span> component architecture`}
          body="Components are structured to support multiple brands and themes without duplicating design work."
        />
      </div>
    </div>
    <div class="section-aside">
      <div class="aside-contents">
        <div class="section-image">
          <ResponsiveImage
            imgPath="/static/images/home/figma-library-light.png"
            alt="Chassis Figma component library showing token-connected components"
            classes="image-fluid w-100"
          />
        </div>
      </div>
    </div>
  </div>
</section>
