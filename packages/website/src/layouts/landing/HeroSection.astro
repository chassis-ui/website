<section id="hero-section" class="home-section hero-section">
  <div class="section-content">
    <article class="section-intro text-center">
      <h1 class="hero-title">
        <span class="font-normal">The foundation for</span>
        <span class="text-nowrap">scalable design systems</span>
      </h1>
      <p class="hero-body">
        Chassis provides modular infrastructure for design systems — from tokens and assets to
        Figma libraries and CSS frameworks — so your team can build, ship, and maintain consistent
        products at scale.
      </p>
      <div class="d-flex gap-medium justify-content-center flex-wrap">
        <a href="/docs/getting-started/" class="button primary large">Get Started</a>
        <a href="/docs/" class="button default large outline">View Documentation</a>
      </div>
    </article>
  </div>

  <div class="section-features landing-pipeline">
    <div class="pipeline-item">
      <div class="pipeline-icon">
        <svg class="icon feature-icon" aria-hidden="true"><use href="#landing-token"></use></svg>
      </div>
      <span class="pipeline-label">Design Tokens</span>
    </div>
    <div class="pipeline-arrow" aria-hidden="true">
      <svg class="icon" aria-hidden="true"><use href="#chevron-right-solid"></use></svg>
    </div>
    <div class="pipeline-item">
      <div class="pipeline-icon">
        <svg class="icon feature-icon" aria-hidden="true"><use href="#landing-asset"></use></svg>
      </div>
      <span class="pipeline-label">Assets</span>
    </div>
    <div class="pipeline-arrow" aria-hidden="true">
      <svg class="icon" aria-hidden="true"><use href="#chevron-right-solid"></use></svg>
    </div>
    <div class="pipeline-item">
      <div class="pipeline-icon">
        <svg class="icon feature-icon" aria-hidden="true"><use href="#landing-figma"></use></svg>
      </div>
      <span class="pipeline-label">Figma Library</span>
    </div>
    <div class="pipeline-arrow" aria-hidden="true">
      <svg class="icon" aria-hidden="true"><use href="#chevron-right-solid"></use></svg>
    </div>
    <div class="pipeline-item">
      <div class="pipeline-icon">
        <svg class="icon feature-icon" aria-hidden="true"><use href="#landing-css"></use></svg>
