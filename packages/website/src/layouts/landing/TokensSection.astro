---
import FeatureItem from '@components/FeatureItem.astro'
import Code from '@shortcodes/Code.astro'
---

<section id="tokens-section" class="home-section">
  <div class="section-content">
    <div class="section-main">
      <article class="section-intro">
        <p class="section-label fg-primary">Chassis Tokens</p>
        <h2 class="section-title">
          <span class="font-normal d-block">One token system.</span> Every platform covered.
        </h2>
        <p class="section-body">
          Design systems break when values get duplicated across tools and codebases. Chassis
          Tokens gives your team a single, structured source for colors, spacing, typography, and
          sizing — and transforms them automatically for every platform you ship to.
        </p>
      </article>
      <div class="features">
        <FeatureItem
          icon="home-folder-tree"
          title={`<span class="font-normal d-block">Centralized</span> token definitions`}
          body="Define tokens once at the system level. Override them at brand, app, or component layers when you need to."
        />
        <FeatureItem
          icon="home-link"
          title={`<span class="font-normal d-block">Cross-platform</span> transformations`}
          body="Automatically convert tokens to CSS custom properties, SCSS variables, Swift constants, Android XML — whatever your stack needs."
        />
        <FeatureItem
          icon="home-shapes"
          title={`<span class="font-normal d-block">Design–code</span> consistency`}
          body="Token values flow from Figma into your codebase, eliminating the drift that happens when design and engineering maintain separate sources."
        />
      </div>
    </div>
    <div class="section-aside">
      <div class="aside-contents">
        <div class="section-image">
          <img
            src="/static/images/home/tokens-scheme.svg"
            alt="Token hierarchy diagram showing how tokens flow from Figma to platform outputs"
            class="image-fluid w-100"
          />
        </div>
        <section>
          <div class="working-command"><svg class="icon" aria-hidden="true"><use href="#gear-solid"></use></svg></div>
          <Code
            lang="scss"
            code={`// dist/web/brandA-appA/tokens.scss
$cx-color-primary: #0066FF;
$cx-space-medium: 1rem;`}
          />
          <Code
            lang="swift"
            code={`// dist/ios/brandA-appA/Tokens.swift
static let cxColorPrimary = UIColor(hex: "#0066FF")
static let cxSpaceMedium: CGFloat = 16`}
          />
          <Code
            lang="xml"
            code={`<!-- dist/android/brandA-appA/tokens.xml -->
<color name="cx_color_primary">#0066FF</color>
<dimen name="cx_space_medium">16dp</dimen>`}
          />
        </section>
      </div>
    </div>
  </div>
</section>
