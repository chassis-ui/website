---
import { ResponsiveImage } from '@chassis-ui/docs/components'
import FeatureItem from '@components/FeatureItem.astro'
import { Code } from '@chassis-ui/docs/components'
---

<section id="modularity-section" class="home-section gap-0">
  <div class="section-content">
    <div class="section-main">
      <article class="section-intro">
        <h1 class="section-title">
          <span class="text-nowrap font-normal d-block">Design for the Future</span> in Modularity
        </h1>
        <p class="section-body">
          Chassis brings a modular, token-first approach to designing in Figma — built to scale and
          adapt over time. Every component is powered by tokens for color, spacing, typography, and
          sizing, ensuring future-proof flexibility across brands and platforms.
        </p>
      </article>
    </div>
    <div class="section-aside">
      <div class="aside-contents mt-large-n4xlarge">
        <div class="section-image mt-large-n4xlarge z-2">
          <ResponsiveImage
            imgPath="/static/images/home/lego-chassis.png"
            alt="Chassis UI"
            classes="section-media"
          />
        </div>
      </div>
    </div>
  </div>
  <div class="section-features">
    <div class="feature-col">
      <div class="features">
        <FeatureItem
          icon="home-swatchbook"
          title={`<span class="font-normal d-block">Genuine Approach</span> to Color Systems`}
          body="Semantic color roles allow every brand or app persona to express identity without breaking component structure."
        />
      </div>
    </div>
    <div class="feature-col">
      <div class="features">
        <FeatureItem
          icon="home-font-case"
          title={`<span class="font-normal d-block">Advanced Typography</span> w/ Responsive Sizing`}
          body="Typography definitions for key UI elements using consistent tokens. Each font size comes with a specified line height."
        />
      </div>
    </div>
    <div class="feature-col">
      <div class="features">
        <FeatureItem
          icon="home-ruler"
          title={`<span class="font-normal d-block">Component Dimensions</span> by Design Tokens`}
          body="Granular tokens for sizing, spacing, and borders ensure components scale responsively and remain visually consistent."
        />
      </div>
    </div>
  </div>
</section>
