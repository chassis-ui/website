---
import ModuleItem from '@components/ModuleItem.astro'
---

<section id="hero-section" class="home-section hero-section">
  <div class="section-content">
    <article class="section-intro text-center">
      <h1 class="hero-title">
        <span class="font-normal">Build Better Design Systems.</span>
        <span class="text-nowrap">In Sync. At Scale.</span>
      </h1>
      <p class="hero-body">
        Chassis is the backbone of scalable design systems built for complex, evolving product
        ecosystems. It unifies Figma components, advanced design tokens, multi-platform
        transformers, asset libraries, and a fully token-synced CSS framework — all working in
        harmony across brands, platforms, and products.
      </p>
      <button class="button primary">Get Started</button>
    </article>
  </div>
  <div class="section-features">
    <ModuleItem icon="icon-figma" title="Figma Components" url="#" />
    <ModuleItem icon="icon-tokens" title="Token Library" url="#" />
    <ModuleItem icon="icon-css" title="CSS Framework" url="#" />
    <ModuleItem icon="icon-icons" title="Icon Generator" url="#" />
    <ModuleItem icon="icon-assets" title="Asset Distributor" url="#" />
    <ModuleItem icon="icon-ai" title="AI Integration" url="#" />
  </div>
</section>
