---
import { Code, ResponsiveImage } from '@ozgurgunes/chassis-docs/components'
---

<section id="contact-section" class="home-section">
  <div class="section-content">
    <div class="section-main">
      <article class="section-intro">
        <h1 class="section-title">
          <span class="text-nowrap font-normal d-block">Built for Complex Reality,</span> Not Idealized
          Simplicity
        </h1>
        <p class="section-body">
          Chassis is designed for the real world of enterprise product development — multiple
          brands, diverse platforms, distributed teams, and constant evolution. Rather than assuming
          ideal conditions, it is built for the complexity that successful products inevitably face.
        </p>
      </article>
      <div class="primary-bg-main p-2xlarge">
        <form>
          <div class="form-field">
            <label for="inputFullName" class="form-label">Full Name</label>
            <input
              type="text"
              class="form-input"
              id="inputFullName"
              aria-describedby="inputFullNameHelp"
            />
            <div id="inputFullNameHelp" class="form-help">Enter your full name.</div>
          </div>
          <div class="form-field">
            <label for="inputWorkEmail" class="form-label">Work Email</label>
            <input
              type="text"
              class="form-input"
              id="inputWorkEmail"
              aria-describedby="inputWorkEmailHelp"
            />
            <div id="inputWorkEmailHelp" class="form-help">
              We'll never share your email with anyone else.
            </div>
          </div>
          <div class="form-field">
            <label for="inputCompany" class="form-label">Company</label>
            <input
              type="text"
              class="form-input"
              id="inputCompany"
              aria-describedby="inputCompanyHelp"
            />
            <div id="inputCompanyHelp" class="form-help">Enter your company or product name.</div>
          </div>
          <div class="form-field options">
            <p class="form-label">What do you need help with?</p>
            <div class="form-check">
              <input class="check-input" type="checkbox" value="" id="flexCheckDefault" />
              <label class="check-label" for="flexCheckDefault">Setting up Chassis</label>
            </div>
            <div class="form-check">
              <input class="check-input" type="checkbox" value="" id="flexCheckChecked" checked />
              <label class="check-label" for="flexCheckChecked">Design System Architecture</label>
            </div>
            <div class="form-check">
              <input class="check-input" type="checkbox" value="" id="flexCheckChecked" checked />
              <label class="check-label" for="flexCheckChecked">Other</label>
            </div>
          </div>
          <div class="form-field">
            <label for="inputMessage" class="form-label">Message</label>
            <textarea class="form-input" id="inputMessage" aria-describedby="inputMessageHelp"
            ></textarea>
            <div id="inputMessageHelp" class="form-help">Enter your message.</div>
          </div>
          <div class="text-end">
            <button type="submit" class="button primary">Request Consultation</button>
          </div>
        </form>
      </div>
    </div>
    <div class="section-aside">
      <div class="aside-contents">
        <Code
          lang="json"
          code={`// JSON
// tokens/figma/brandA-appA.json
{
  "color": {
    "button": {
      "primary": {
        "bg-hover": {
          "$type": "color",
          "$value": "{color.context.primary.bg-hover}"
        }
      }
    }
  }
}`}
        />
        <div class="text-center">
          <ResponsiveImage
            imgPath="/static/images/home/lego-chassis.png"
            alt="Chassis UI"
            classes="section-media"
          />
        </div>
      </div>
    </div>
  </div>
</section>
