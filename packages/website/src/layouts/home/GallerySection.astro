---
import { ResponsiveImage } from '@chassis-ui/docs/components'
---

<div
  id="gallery-section"
  class="media-section vh-75 overflow-hidden bg-evident border-top border-bottom border-subtle"
>
  <div class="gallery-content">
    <ResponsiveImage
      imgPath="/static/images/home/comp-gallery-light.png"
      alt="Chassis UI"
      classes="mb-5xlarge image-fluid w-100 display-light"
    />
    <ResponsiveImage
      imgPath="/static/images/home/comp-gallery-dark.png"
      alt="Chassis UI"
      classes="mb-5xlarge image-fluid w-100 display-dark"
    />
  </div>
</div>
