{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@css/*": ["@chassis-ui/css/dist/*"],
      "@icons/*": ["@chassis-ui/icons/dist/*"],
      "@assets/*": ["src/assets/*"],
      "@components/*": ["src/components/*"],
      "@layouts/*": ["src/layouts/*"],
      "@libs/*": ["src/libs/*"],
      "@shortcodes/*": ["@chassis-ui/docs/components/shortcodes/*"]
    }
  }
}
