{
  "buildCommand": "pnpm site:build",
  "outputDirectory": "_site",
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/static/(.*)",
      "has": [
        { "type": "header", "key": "referer", "value": ".*/figma/.*" }
      ],
      "destination": "https://chassis-figma.vercel.app/static/$1"
    },
    {
      "source": "/static/(.*)",
      "has": [
        { "type": "header", "key": "referer", "value": ".*/css/.*" }
      ],
      "destination": "https://chassis-css.vercel.app/static/$1"
    },
    {
      "source": "/static/(.*)",
      "has": [
        { "type": "header", "key": "referer", "value": ".*/icons/.*" }
      ],
      "destination": "https://chassis-icons.vercel.app/static/$1"
    },
    {
      "source": "/static/(.*)",
      "has": [
        { "type": "header", "key": "referer", "value": ".*/tokens/.*" }
      ],
      "destination": "https://chassis-tokens.vercel.app/static/$1"
    },
    {
      "source": "/static/(.*)",
      "has": [
        { "type": "header", "key": "referer", "value": ".*/assets/.*" }
      ],
      "destination": "https://chassis-assets.vercel.app/static/$1"
    },
    {
      "source": "/assets/:path*",
      "has": [
        {
          "type": "header",
          "key": "host",
          "value": "staging.chassis-ui.com"
        }
      ],
      "destination": "https://chassis-assets-staging.vercel.app/assets/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "https://chassis-assets.vercel.app/assets/:path*"
    },
    {
      "source": "/css/:path*",
      "has": [
        {
          "type": "header",
          "key": "host",
          "value": "staging.chassis-ui.com"
        }
      ],
      "destination": "https://chassis-css-staging.vercel.app/css/:path*"
    },
    {
      "source": "/css/:path*",
      "destination": "https://chassis-css.vercel.app/css/:path*"
    },
    {
      "source": "/tokens/:path*",
      "has": [
        {
          "type": "header",
          "key": "host",
          "value": "staging.chassis-ui.com"
        }
      ],
      "destination": "https://chassis-tokens-staging.vercel.app/tokens/:path*"
    },
    {
      "source": "/tokens/:path*",
      "destination": "https://chassis-tokens.vercel.app/tokens/:path*"
    },
    {
      "source": "/figma/(.*)",
      "has": [
        {
          "type": "header",
          "key": "host",
          "value": "staging.chassis-ui.com"
        }
      ],
      "destination": "https://chassis-figma-staging.vercel.app/figma/$1"
    },
    {
      "source": "/figma/(.*)",
      "destination": "https://chassis-figma.vercel.app/figma/$1"
    },
    {
      "source": "/icons/:path*",
      "has": [
        {
          "type": "header",
          "key": "host",
          "value": "staging.chassis-ui.com"
        }
      ],
      "destination": "https://chassis-icons-staging.vercel.app/icons/:path*"
    },
    {
      "source": "/icons/:path*",
      "destination": "https://chassis-icons.vercel.app/icons/:path*"
    },
    {
      "source": "/tokens-assets/:path*",
      "has": [
        {
          "type": "header",
          "key": "host",
          "value": "staging.chassis-ui.com"
        }
      ],
      "destination": "https://chassis-tokens-staging.vercel.app/tokens-assets/:path*"
    },
    {
      "source": "/tokens-assets/:path*",
      "destination": "https://chassis-tokens.vercel.app/tokens-assets/:path*"
    },
    {
      "source": "/icons-assets/:path*",
      "has": [
        {
          "type": "header",
          "key": "host",
          "value": "staging.chassis-ui.com"
        }
      ],
      "destination": "https://chassis-icons-staging.vercel.app/icons-assets/:path*"
    },
    {
      "source": "/icons-assets/:path*",
      "destination": "https://chassis-icons.vercel.app/icons-assets/:path*"
    }
  ]
}
