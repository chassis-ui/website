{
  "name": "chassis-website-monorepo",
  "description": "Central documentation and showcase website for Chassis UI",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/chassis-ui/website.git"
  },
  "bugs": {
    "url": "https://github.com/chassis-ui/website/issues"
  },
  "homepage": "https://chassis-ui.com",
  "author": "Ozgur Gunes <o.gunes@gmail.com>",
  "license": "MIT",
  "keywords": [
    "design-system",
    "chassis",
    "documentation",
    "css-framework",
    "design-tokens",
    "asset-distributor",
    "icon-generator",
    "figma",
    "figma-components",
    "multi-platform"
  ],
  "scripts": {
    "build": "node build/build-site.js all",
    "clean": "node build/build-site.js clean",
    "dev": "pnpm sync-submodules && pnpm astro:dev",
    "preview": "pnpm astro:preview",
    "validate": "node build/build-site.js validate",
    "site": "pnpm site:build && pnpm site:lint:vnu",
    "site:build": "node build/build-site.js",
    "site:lint": "pnpm site:lint:eslint && pnpm site:lint:stylelint && pnpm site:lint:prettier && pnpm site:lint:vnu",
    "site:lint:eslint": "eslint --cache --cache-location .cache/.eslintcache --report-unused-disable-directives packages/website",
    "site:lint:stylelint": "stylelint --cache --cache-location .cache/.stylelintcache packages/website/\"**/*.{css,scss}\"",
    "site:lint:prettier": "prettier -c --cache packages/website",
    "site:lint:vnu": "node build/vnu-jar.js",
    "site:format": "prettier --write --cache packages/website/",
    "docs:lint": "pnpm docs:lint:eslint && pnpm docs:lint:stylelint && pnpm docs:lint:prettier",
    "docs:lint:eslint": "eslint --cache --cache-location .cache/.eslintcache --report-unused-disable-directives packages/docs",
    "docs:lint:stylelint": "stylelint --cache --cache-location .cache/.stylelintcache packages/docs/\"**/*.{css,scss}\"",
    "docs:lint:prettier": "prettier -c --cache packages/docs",
    "docs:format": "prettier --write --cache packages/docs/",
    "astro:dev": "pnpm --filter chassis-website astro dev --port 4321",
    "astro:build": "pnpm --filter chassis-website astro build",
    "astro:preview": "pnpm --filter chassis-website astro preview",
    "check": "pnpm check:astro & pnpm check:lockfile & pnpm check:pnpm & wait",
    "check:astro": "pnpm --filter chassis-website astro check",
    "check:lockfile": "lockfile-lint --allowed-hosts npm --allowed-schemes https: --empty-hostname false --type npm --path package-lock.json",
    "check:pnpm": "pnpm audit --audit-level moderate",
    "change-version": "node build/change-version.js",
    "sync-submodules": "node build/sync-submodules.js"
  },
  "dependencies": {
    "resend": "^6.12.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-formatter-compact": "^8.40.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-unicorn": "^61.0.2",
    "globals": "^16.5.0",
    "picocolors": "^1.1.1",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "stylelint": "^16.26.1",
    "stylelint-config-twbs-bootstrap": "^16.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.0",
    "vnu-jar": "24.10.17",
    "zod": "^4.3.6"
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8"
}
