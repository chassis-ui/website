{
  "name": "chassis-website-monorepo",
  "description": "Central documentation and showcase website for Chassis UI",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/chassis-ui/website.git"
  },
  "bugs": {
    "url": "https://github.com/chassis-ui/website/issues"
  },
  "homepage": "https://chassis-ui.com",
  "author": "Ozgur Gunes <o.gunes@gmail.com>",
  "license": "MIT",
  "keywords": [
    "design-system",
    "chassis",
    "documentation",
    "css-framework",
    "design-tokens",
    "asset-distributor",
    "icon-generator",
    "figma",
    "figma-components",
    "multi-platform"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "dev": "pnpm astro:dev",
    "build": "pnpm site:build",
    "preview": "pnpm astro:preview",
    "lint": "pnpm site:lint:code && pnpm docs:lint && pnpm spellcheck",
    "format": "pnpm site:format && pnpm docs:format",
    "spellcheck": "cspell --no-progress --no-must-find-files",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fixtures": "node build/fixture-sites.js",
    "test:canary": "node build/canary.js",
    "check": "pnpm check:astro && pnpm check:pnpm",
    "check:astro": "pnpm run \"/^check:astro:(docs|site)$/\"",
    "check:astro:docs": "pnpm --filter @chassis-ui/docs astro check",
    "check:astro:site": "pnpm --filter chassis-website astro check",
    "check:pnpm": "pnpm audit --prod --audit-level moderate",
    "vendor": "chassis-docs vendor",
    "sync-submodules": "chassis-docs sync-submodules",
    "clean": "node -e \"for (const dir of ['_site', 'packages/website/.astro', 'packages/website/node_modules', 'packages/website/public']) require('node:fs').rmSync(dir, { recursive: true, force: true })\"",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "site": "pnpm site:build && pnpm site:lint:vnu && pnpm site:lint:links && pnpm site:lint:a11y",
    "site:build": "pnpm vendor && pnpm examples:build && pnpm astro:build && pnpm site:pagefind",
    "site:format": "prettier --write --cache packages/website",
    "site:lint": "pnpm site:lint:code && pnpm site:lint:vnu",
    "site:lint:code": "pnpm site:lint:eslint && pnpm site:lint:stylelint && pnpm site:lint:prettier",
    "site:lint:eslint": "eslint --cache --cache-location .cache/.eslintcache --report-unused-disable-directives packages/website",
    "site:lint:stylelint": "stylelint --cache --cache-location .cache/.stylelintcache packages/website/\"**/*.{css,scss}\"",
    "site:lint:prettier": "prettier -c --cache packages/website",
    "site:lint:html": "chassis-docs html-validate --config packages/website/html-validate.json",
    "site:lint:vnu": "chassis-docs vnu --filter 'CSS: .--cx-carousel-items-peek.: Parse Error.' --filter 'CSS: .width.: The types are incompatible.'",
    "site:lint:links": "node build/check-links.js",
    "site:lint:a11y": "node build/check-a11y.js",
    "site:lint:csp": "node build/check-csp.js",
    "site:pagefind": "pagefind --site _site",
    "docs:format": "prettier --write --cache packages/docs",
    "docs:lint": "pnpm docs:lint:eslint && pnpm docs:lint:stylelint && pnpm docs:lint:prettier",
    "docs:lint:eslint": "eslint --cache --cache-location .cache/.eslintcache --report-unused-disable-directives packages/docs",
    "docs:lint:stylelint": "stylelint --cache --cache-location .cache/.stylelintcache packages/docs/\"**/*.{css,scss}\"",
    "docs:lint:prettier": "prettier -c --cache packages/docs",
    "examples:build": "pnpm --filter \"./examples/*\" build",
    "astro:dev": "pnpm --filter chassis-website astro dev --port 4321 --host",
    "astro:build": "pnpm --filter chassis-website astro build",
    "astro:preview": "pnpm --filter chassis-website astro preview"
  },
  "dependencies": {
    "resend": "^6.32.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@changesets/cli": "^3.0.3",
    "@chassis-ui/docs": "workspace:*",
    "@eslint/js": "^10.0.1",
    "cspell": "^10.3.6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unicorn": "^76.0.0",
    "globals": "^17.13.0",
    "globby": "^16.2.4",
    "html-validate": "^11.16.1",
    "linkinator": "^8.1.0",
    "lint-staged": "^17.6.0",
    "pagefind": "^1.5.2",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "semver": "^7.8.5",
    "simple-git-hooks": "^2.14.0",
    "stylelint": "^16.26.1",
    "stylelint-config-twbs-bootstrap": "^16.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "vnu-jar": "^26.10.2"
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8",
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "packages/{website,docs}/**/*.{js,mjs,ts,astro}": [
      "eslint --cache --cache-location .cache/.eslintcache --fix",
      "prettier --write"
    ],
    "packages/{website,docs}/**/*.{json,md,mdx,yml,yaml}": "prettier --write"
  }
}
