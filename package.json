{
  "name": "chassis-docs",
  "version": "1.0.0",
  "description": "Central documentation and showcase website for Chassis Design System",
  "type": "module",
  "scripts": {
    "build": "node build/build-site.js all",
    "clean": "node build/build-site.js clean",
    "dev": "pnpm astro:dev",
    "postinstall": "npm run sync:submodules",
    "preview": "pnpm astro:preview",
    "test": "echo \"No tests specified\" && exit 0",
    "validate": "node build/build.js validate",
    "site": "pnpm site:build && pnpm site:lint",
    "site:build": "node build/build-site.js",
    "site:format": "prettier --write --cache site",
    "site:lint": "pnpm site:lint:prettier && pnpm site:lint:vnu",
    "site:lint:prettier": "prettier -c --cache site",
    "site:lint:vnu": "node build/vnu-jar.js",
    "astro:dev": "astro dev --root site --port 4321",
    "astro:build": "astro build --root site",
    "astro:preview": "astro preview --root site",
    "check": "pnpm check:code & pnpm check:lockfile & pnpm check:pnpm & wait",
    "check:code": "pnpm site:lint",
    "check:lockfile": "lockfile-lint --allowed-hosts npm --allowed-schemes https: --empty-hostname false --type npm --path package-lock.json",
    "check:pnpm": "pnpm audit --audit-level moderate",
    "release:version": "node build/change-version.js",
    "sync:submodules": "node build/sync-submodules.js"
  },
  "keywords": [
    "design-system",
    "chassis",
    "documentation",
    "css-framework",
    "design-tokens",
    "figma",
    "multi-platform"
  ],
  "author": "Chassis Design System",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ozgurgunes/chassis-docs.git"
  },
  "bugs": {
    "url": "https://github.com/ozgurgunes/chassis-docs/issues"
  },
  "homepage": "https://chassis.design",
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/markdown-remark": "^5.3.0",
    "@astrojs/mdx": "^4.3.5",
    "@astrojs/prism": "^3.3.0",
    "@astrojs/sitemap": "^3.6.0",
    "@docsearch/css": "^3.9.0",
    "@docsearch/js": "^3.9.0",
    "@eslint/js": "^9.36.0",
    "@ozgurgunes/chassis-css": "github:ozgurgunes/chassis-css#app/docs",
    "@ozgurgunes/chassis-icons": "github:ozgurgunes/chassis-icons#app/docs",
    "@ozgurgunes/chassis-tokens": "github:ozgurgunes/chassis-tokens#app/docs",
    "@stackblitz/sdk": "^1.11.0",
    "@types/google.analytics": "^0.0.46",
    "@types/hast": "^3.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/mime": "^3.0.4",
    "@types/node": "^22.18.6",
    "@types/prismjs": "^1.26.5",
    "@types/unist": "^3.0.3",
    "astro": "^5.13.9",
    "astro-auto-import": "^0.4.4",
    "autoprefixer": "^10.4.21",
    "clipboard": "^2.0.11",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-formatter-compact": "^8.40.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-unicorn": "^61.0.2",
    "github-slugger": "^2.0.0",
    "globals": "^16.4.0",
    "htmlparser2": "^10.0.0",
    "image-size": "^2.0.2",
    "js-yaml": "^4.1.0",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-mdx-jsx": "^3.2.0",
    "mdast-util-to-string": "^4.0.0",
    "mime": "^4.1.0",
    "picocolors": "^1.1.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "prismjs": "^1.30.0",
    "rehype-autolink-headings": "^7.1.0",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "sass": "1.78.0",
    "serve": "^14.2.5",
    "sharp": "^0.34.4",
    "stylelint": "^16.24.0",
    "stylelint-config-twbs-bootstrap": "^16.1.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vnu-jar": "24.10.17",
    "zod": "^4.1.11"
  },
  "packageManager": "pnpm@10.7.0+sha512.6b865ad4b62a1d9842b61d674a393903b871d9244954f652b8842c2b553c72176b278f64c463e52d40fff8aba385c235c8c9ecf5cc7de4fd78b8bb6d49633ab6"
}
