# Environment variables of the contact endpoint, api/contact.ts.
# They are set in the settings of the Vercel project, for Production and Preview: without
# them the endpoint fails on staging too. `vercel env pull` writes them to a
# local .env, which Git ignores. `pnpm dev` serves the pages only, not the endpoint.

# API key from https://resend.com/api-keys. Without it every request to the endpoint fails.
RESEND_API_KEY=

# Optional. Sender of the message. Its domain must be verified in Resend.
# RESEND_FROM_EMAIL=Chassis Support <noreply@chassis-ui.com>

# Optional. Where messages are delivered.
# RESEND_TO_EMAIL=support@chassis-ui.com
