# Environment variables of the contact endpoint, api/contact.ts.
# They are set in the settings of the Vercel project, for Production and Preview: without
# them the endpoint fails on staging too. `vercel env pull` writes them to a
# local .env, which Git ignores. `pnpm dev` serves the pages only, not the endpoint.

# API key from https://resend.com/api-keys. Without it every request to the endpoint fails.
RESEND_API_KEY=

# Optional. Sender of the message. Its domain must be verified in Resend.
# RESEND_FROM_EMAIL=Chassis Support <noreply@chassis-ui.com>

# Optional. Where messages are delivered.
# RESEND_TO_EMAIL=support@chassis-ui.com

# Optional, for previews. The brand and the app that `pnpm vendor`, `pnpm dev` and `pnpm build`
# are for, over `brand` and `app` of vendor/assets.json (`chassis` and `docs`). Set them for one
# command, as in `CHASSIS_BRAND=acme pnpm dev`, or here, in .env.local, so that every run
# takes them until you remove them. `acme` stands for a brand that vendor/assets.json pins.
# `CHASSIS_BRAND= pnpm dev` takes the default for one run. The site is deployed for `chassis`
# only: never set them in CI or in the settings of the Vercel project.
# CHASSIS_BRAND=acme
# CHASSIS_APP=docs

# Optional. `true` compiles css/chassis.css and css/chassis.min.css for `chassis` too, from the
# installed @chassis-ui/website-tokens, in place of the prebuilt files of @chassis-ui/css: for
# tokens newer than the release of the CSS. A start takes some seconds longer.
# CHASSIS_COMPILE_CSS=true

# Optional, for work on the assets and the site at once. The path of your checkout of
# chassis-ui/website-assets, in .env.local: `pnpm vendor`, and so `pnpm dev` and `pnpm build`,
# copies its built `dist/web/docs/<brand>` in place of the pinned release. Build it there
# first. Never set it in CI or in the settings of the Vercel project.
# CHASSIS_ASSETS_CHECKOUT=/path/to/your/checkout
